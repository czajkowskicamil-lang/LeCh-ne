---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { ViewTransitions } from 'astro:transitions';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.baseline,
  image = '/og-default.jpg',
  noIndex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.lechenepatrimonial.com').href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    {!noIndex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    {/* Search Console verification — remplis la valeur PUBLIC_GSC_VERIFICATION dans .env quand tu auras ton code */}
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_VERIFICATION} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? 'https://www.lechenepatrimonial.com').href} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon (inline SVG — navy + gold) -->
    <link rel="icon" type="image/svg+xml" href={`data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cpath fill='%230A1F4F' d='M24 42 L24 30 M24 30 C14 30 10 22 14 18 C8 14 14 6 22 10 C22 4 30 4 30 10 C36 8 40 16 34 18 C38 22 34 30 24 30 Z' stroke='%230A1F4F' stroke-width='2' stroke-linecap='round'/%3E%3Ccircle cx='24' cy='19' r='2' fill='%23D4A82D'/%3E%3C/svg%3E`} />
    <meta name="theme-color" content="#0A1F4F" />

    {/* Structured Data — FinancialService + Person (founder) for richer Google rich results */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'FinancialService',
          '@id': 'https://www.lechenepatrimonial.com/#organization',
          name: site.name,
          url: 'https://www.lechenepatrimonial.com',
          description: site.baseline,
          areaServed: ['Paris', 'Montpellier', 'Marseille', 'France'],
          email: site.email,
          telephone: site.phone.tel,
          priceRange: 'Sur devis',
          serviceType: [
            'Conseil en gestion de patrimoine',
            'Optimisation fiscale',
            'Assurance-vie',
            'Plan Épargne Retraite',
            'SCPI',
            'Transmission de patrimoine',
          ],
          founder: { '@id': 'https://www.lechenepatrimonial.com/#founder' },
          sameAs: [site.linkedin],
        },
        {
          '@type': 'Person',
          '@id': 'https://www.lechenepatrimonial.com/#founder',
          name: site.owner,
          jobTitle: 'Conseiller en gestion de patrimoine',
          worksFor: { '@id': 'https://www.lechenepatrimonial.com/#organization' },
          sameAs: [site.linkedin],
          identifier: 'ORIAS 25000016',
        },
        {
          '@type': 'WebSite',
          '@id': 'https://www.lechenepatrimonial.com/#website',
          url: 'https://www.lechenepatrimonial.com',
          name: site.name,
          inLanguage: 'fr-FR',
          publisher: { '@id': 'https://www.lechenepatrimonial.com/#organization' },
        },
      ],
    })} />

    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col">
    <ReadingProgress />
    <SmoothScroll />
    <Nav />
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal — watches all reveal variants
      function setupReveal() {
        const selector = '.reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-clip, .reveal-mask';
        const nodes = document.querySelectorAll(selector);
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        nodes.forEach((el) => {
          if (!el.classList.contains('is-visible')) obs.observe(el);
        });
      }

      // Lightweight parallax for elements with data-parallax="N" (N = intensity 0..1)
      function setupParallax() {
        const els = document.querySelectorAll('[data-parallax]');
        if (!els.length) return;
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          els.forEach((el) => {
            const r = (el as HTMLElement).getBoundingClientRect();
            const intensity = parseFloat((el as HTMLElement).dataset.parallax || '0.1');
            const progress = (r.top + r.height / 2 - vh / 2) / vh; // -1..1
            (el as HTMLElement).style.transform = `translateY(${progress * intensity * 120}px)`;
          });
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { requestAnimationFrame(update); ticking = true; }
        }, { passive: true });
        update();
      }

      setupReveal();
      setupParallax();
      document.addEventListener('astro:page-load', () => {
        setupReveal();
        setupParallax();
      });
    </script>
  </body>
</html>
