---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';
import Assistant from '../components/Assistant.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { ViewTransitions } from 'astro:transitions';
import { site } from '../data/site';
import { getLangFromUrl, localizePath, stripLangPrefix } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  heroDark?: boolean;
}

const {
  title = `${site.name}, ${site.tagline}`,
  description = site.baseline,
  image = '/og-image.png',
  noIndex = false,
  heroDark = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const origin = Astro.site ?? new URL('https://www.lechenepatrimonial.com');
const canonical = new URL(Astro.url.pathname, origin).href;

// Alternates hreflang : version FR et EN du même chemin, pour Google.
const basePath = stripLangPrefix(Astro.url.pathname);
const altFr = new URL(localizePath(basePath, 'fr'), origin).href;
const altEn = new URL(localizePath(basePath, 'en'), origin).href;
const ogLocale = lang === 'en' ? 'en_GB' : 'fr_FR';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={altFr} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altFr} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    {!noIndex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    {/* Search Console verification, remplis la valeur PUBLIC_GSC_VERIFICATION dans .env quand tu auras ton code */}
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_VERIFICATION} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? 'https://www.lechenepatrimonial.com').href} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicons (logo Le Chêne, arbre or sur navy) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A1F4F" />

    {/* Structured Data, FinancialService + Person (founder) for richer Google rich results */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'FinancialService',
          '@id': 'https://www.lechenepatrimonial.com/#organization',
          name: site.name,
          url: 'https://www.lechenepatrimonial.com',
          description: site.baseline,
          areaServed: [
            { '@type': 'City', name: 'Montpellier' },
            { '@type': 'Country', name: 'France' },
          ],
          address: { '@type': 'PostalAddress', addressLocality: 'Montpellier', addressRegion: 'Occitanie', addressCountry: 'FR' },
          email: site.email,
          telephone: site.phone.tel,
          priceRange: 'Sur devis',
          serviceType: [
            'Conseil en gestion de patrimoine',
            'Optimisation fiscale',
            'Assurance-vie',
            'Plan Épargne Retraite',
            'SCPI',
            'Transmission de patrimoine',
          ],
          founder: { '@id': 'https://www.lechenepatrimonial.com/#founder' },
          sameAs: [site.linkedin, site.instagram],
        },
        {
          '@type': 'Person',
          '@id': 'https://www.lechenepatrimonial.com/#founder',
          name: site.owner,
          jobTitle: 'Conseiller en gestion de patrimoine',
          worksFor: { '@id': 'https://www.lechenepatrimonial.com/#organization' },
          sameAs: [site.linkedin],
          identifier: 'ORIAS 25000016',
        },
        {
          '@type': 'WebSite',
          '@id': 'https://www.lechenepatrimonial.com/#website',
          url: 'https://www.lechenepatrimonial.com',
          name: site.name,
          inLanguage: 'fr-FR',
          publisher: { '@id': 'https://www.lechenepatrimonial.com/#organization' },
        },
      ],
    })} />

    <ViewTransitions />

    <!-- Vercel Web Analytics : compte les visiteurs (gratuit jusqu'à 2.5k events/mois) -->
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <ReadingProgress />
    <SmoothScroll />
    <Nav heroDark={heroDark} />
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <Footer />
    <MobileCTA />
    <Assistant />

    <script>
      // Scroll reveal, watches all reveal variants
      function setupReveal() {
        const selector = '.reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-clip, .reveal-mask';
        const nodes = document.querySelectorAll(selector);
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        nodes.forEach((el) => {
          if (!el.classList.contains('is-visible')) obs.observe(el);
        });
      }

      // Lightweight parallax for elements with data-parallax="N" (N = intensity 0..1)
      function setupParallax() {
        const els = document.querySelectorAll('[data-parallax]');
        if (!els.length) return;
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          els.forEach((el) => {
            const r = (el as HTMLElement).getBoundingClientRect();
            const intensity = parseFloat((el as HTMLElement).dataset.parallax || '0.1');
            const progress = (r.top + r.height / 2 - vh / 2) / vh; // -1..1
            (el as HTMLElement).style.transform = `translateY(${progress * intensity * 120}px)`;
          });
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { requestAnimationFrame(update); ticking = true; }
        }, { passive: true });
        update();
      }

      setupReveal();
      setupParallax();
      document.addEventListener('astro:page-load', () => {
        setupReveal();
        setupParallax();
      });
    </script>
  </body>
</html>
