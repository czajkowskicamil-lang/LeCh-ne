---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';
import Assistant from '../components/Assistant.astro';
import Musique from '../components/Musique.astro';
import Ouverture from '../components/Ouverture.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { ViewTransitions } from 'astro:transitions';
import { site } from '../data/site';
import { getLangFromUrl, localizePath, stripLangPrefix } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  heroDark?: boolean;
}

const {
  title = `${site.name}, ${site.tagline}`,
  description = site.baseline,
  image = '/og-image.png',
  noIndex = false,
  heroDark = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const origin = Astro.site ?? new URL('https://www.lechenepatrimonial.com');
const canonical = new URL(Astro.url.pathname, origin).href;

// Alternates hreflang : version FR et EN du même chemin, pour Google.
const basePath = stripLangPrefix(Astro.url.pathname);
const altFr = new URL(localizePath(basePath, 'fr'), origin).href;
const altEn = new URL(localizePath(basePath, 'en'), origin).href;
const ogLocale = lang === 'en' ? 'en_GB' : 'fr_FR';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={altFr} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altFr} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    {!noIndex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    {/* Search Console verification, remplis la valeur PUBLIC_GSC_VERIFICATION dans .env quand tu auras ton code */}
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_VERIFICATION} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? 'https://www.lechenepatrimonial.com').href} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicons (logo Le Chêne, arbre or sur navy) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#11151F" />

    {/* Structured Data, FinancialService + Person (founder) for richer Google rich results */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'FinancialService',
          '@id': 'https://www.lechenepatrimonial.com/#organization',
          name: site.name,
          url: 'https://www.lechenepatrimonial.com',
          description: site.baseline,
          areaServed: [
            { '@type': 'City', name: 'Montpellier' },
            { '@type': 'Country', name: 'France' },
          ],
          address: { '@type': 'PostalAddress', addressLocality: 'Montpellier', addressRegion: 'Occitanie', addressCountry: 'FR' },
          email: site.email,
          telephone: site.phone.tel,
          priceRange: 'Sur devis',
          serviceType: [
            'Conseil en gestion de patrimoine',
            'Optimisation fiscale',
            'Assurance-vie',
            'Plan Épargne Retraite',
            'SCPI',
            'Transmission de patrimoine',
          ],
          founder: { '@id': 'https://www.lechenepatrimonial.com/#founder' },
          sameAs: [site.linkedin, site.instagram],
        },
        {
          '@type': 'Person',
          '@id': 'https://www.lechenepatrimonial.com/#founder',
          name: site.owner,
          jobTitle: 'Conseiller en gestion de patrimoine',
          worksFor: { '@id': 'https://www.lechenepatrimonial.com/#organization' },
          sameAs: [site.linkedin],
          identifier: 'ORIAS 25000016',
        },
        {
          '@type': 'WebSite',
          '@id': 'https://www.lechenepatrimonial.com/#website',
          url: 'https://www.lechenepatrimonial.com',
          name: site.name,
          inLanguage: 'fr-FR',
          publisher: { '@id': 'https://www.lechenepatrimonial.com/#organization' },
        },
      ],
    })} />

    <ViewTransitions />

    <!-- Vercel Web Analytics : compte les visiteurs (gratuit jusqu'à 2.5k events/mois) -->
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Ouverture />
    <ReadingProgress />
    <SmoothScroll />
    <Nav heroDark={heroDark} />
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <Footer />
    <MobileCTA />
    <Assistant />
    <Musique />

    <script>
      // Scroll reveal, watches all reveal variants
      const REVEAL_SELECTOR = '.reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-clip, .reveal-mask';

      function setupReveal() {
        const pending = new Set<Element>();

        function show(el: Element) {
          el.classList.add('is-visible');
          pending.delete(el);
        }

        // Filet de sécurité : tout ce qui est déjà entré dans la fenêtre (ou qui
        // l'a dépassée) est révélé sans attendre l'observer. Sans ça, un scroll
        // rapide saute des blocs entre deux frames et ils restent invisibles.
        function sweep() {
          const vh = window.innerHeight;
          pending.forEach((el) => {
            if (el.getBoundingClientRect().top < vh - 40) show(el);
          });
          if (!pending.size) window.removeEventListener('scroll', onScroll);
        }

        let ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => { sweep(); ticking = false; });
        }

        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              show(e.target);
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0, rootMargin: '0px 0px -40px 0px' });

        document.querySelectorAll(REVEAL_SELECTOR).forEach((el) => {
          if (el.classList.contains('is-visible')) return;
          pending.add(el);
          obs.observe(el);
        });

        window.addEventListener('scroll', onScroll, { passive: true });
        sweep();
      }

      // Lightweight parallax for elements with data-parallax="N" (N = intensity 0..1)
      function setupParallax() {
        const els = document.querySelectorAll('[data-parallax]');
        if (!els.length) return;
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          els.forEach((el) => {
            const r = (el as HTMLElement).getBoundingClientRect();
            const intensity = parseFloat((el as HTMLElement).dataset.parallax || '0.1');
            const progress = (r.top + r.height / 2 - vh / 2) / vh; // -1..1
            (el as HTMLElement).style.transform = `translateY(${progress * intensity * 120}px)`;
          });
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { requestAnimationFrame(update); ticking = true; }
        }, { passive: true });
        update();
      }

      // Outils : précision à l'unité.
      // 1. Tous les curseurs du site avancent d'une unité (0,01 pour un taux),
      //    jamais par paliers de 100, 1 000 ou 5 000.
      // 2. La valeur affichée se change en champ de saisie au clic, pour taper un
      //    montant exact. L'élément d'origine reste dans le DOM, les scripts de
      //    chaque outil continuent de l'alimenter sans rien savoir de ce mécanisme.
      const VALUE_SELECTOR = '.tool-field label b, .calc-field .calc-head output, #diag-slider-out';

      function normalizeStep(range: HTMLInputElement) {
        if (range.dataset.unitStep) return;
        range.dataset.unitStep = '1';
        const decimal = (range.step || '').includes('.') || (range.min || '').includes('.');
        range.step = decimal ? '0.01' : '1';
      }

      // Le curseur doit appartenir au MÊME champ que la valeur affichée. Sans ce
      // garde-fou, la remontée d'ancêtres attrapait le curseur du champ voisin et
      // rendait « saisissables » des valeurs pilotées par des boutons.
      function rangeNear(display: HTMLElement): HTMLInputElement | null {
        const field = display.closest<HTMLElement>('.tool-field, .calc-field');
        if (field) return field.querySelector<HTMLInputElement>('input[type="range"]');
        let node: HTMLElement | null = display;
        for (let depth = 0; node && depth < 3; depth++) {
          const found = node.querySelector<HTMLInputElement>('input[type="range"]');
          if (found) return found;
          node = node.parentElement;
        }
        return null;
      }

      function openExactInput(display: HTMLElement, range: HTMLInputElement) {
        if (display.hidden || display.nextElementSibling?.classList.contains('tool-val-input')) return;
        normalizeStep(range);
        const decimal = range.step.includes('.');

        const input = document.createElement('input');
        input.type = 'number';
        input.className = 'tool-val-input';
        input.value = range.value;
        input.min = range.min;
        input.max = range.max;
        input.step = range.step;
        input.setAttribute('aria-label', 'Valeur exacte');
        const style = getComputedStyle(display);
        input.style.fontSize = style.fontSize;
        input.style.color = style.color;
        input.style.width = Math.max(5, range.max.length + 2) + 'ch';

        const commit = (apply: boolean) => {
          if (!input.isConnected) return;
          if (apply) {
            const raw = parseFloat(input.value.replace(',', '.'));
            if (!Number.isNaN(raw)) {
              const lo = parseFloat(range.min), hi = parseFloat(range.max);
              let v = raw;
              if (!Number.isNaN(lo)) v = Math.max(lo, v);
              if (!Number.isNaN(hi)) v = Math.min(hi, v);
              range.value = String(decimal ? Math.round(v * 100) / 100 : Math.round(v));
              range.dispatchEvent(new Event('input', { bubbles: true }));
              range.dispatchEvent(new Event('change', { bubbles: true }));
            }
          }
          input.remove();
          display.hidden = false;
        };

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') { e.preventDefault(); commit(true); }
          if (e.key === 'Escape') { e.preventDefault(); commit(false); }
        });
        input.addEventListener('blur', () => commit(true));

        display.hidden = true;
        display.after(input);
        input.focus();
        input.select();
      }

      function setupToolPrecision() {
        document.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach(normalizeStep);
        document.querySelectorAll<HTMLElement>(VALUE_SELECTOR).forEach((display) => {
          if (display.dataset.editable || !rangeNear(display)) return;
          display.dataset.editable = '1';
          display.title = 'Cliquez pour saisir une valeur exacte';
          display.tabIndex = 0;
        });
      }

      // Remplissage doré de la piste, jusqu'à la valeur courante.
      function paintRange(range: HTMLInputElement) {
        const lo = parseFloat(range.min || '0');
        const hi = parseFloat(range.max || '100');
        const v = parseFloat(range.value || '0');
        const p = hi > lo ? ((v - lo) / (hi - lo)) * 100 : 0;
        range.style.setProperty('--fill', Math.max(0, Math.min(100, p)) + '%');
      }

      function setupRangeFill() {
        document.querySelectorAll<HTMLInputElement>('.tool-range').forEach((range) => {
          paintRange(range);
          if (range.dataset.fillReady) return;
          range.dataset.fillReady = '1';
          range.addEventListener('input', () => paintRange(range));
        });
      }

      // Pastille dorée qui glisse d'une option à l'autre dans les sélecteurs.
      function placeSegIndicator(seg: HTMLElement) {
        const ind = seg.querySelector<HTMLElement>('.tool-seg-ind');
        const active = seg.querySelector<HTMLElement>('button.on');
        if (!ind || !active || !seg.offsetWidth) return;
        const segBox = seg.getBoundingClientRect();
        const btnBox = active.getBoundingClientRect();
        const border = parseFloat(getComputedStyle(seg).borderLeftWidth) || 0;
        ind.style.width = btnBox.width + 'px';
        ind.style.transform = 'translateX(' + (btnBox.left - segBox.left - border) + 'px)';
      }

      function setupSegments() {
        document.querySelectorAll<HTMLElement>('.tool-seg').forEach((seg) => {
          if (!seg.querySelector('.tool-seg-ind')) {
            const ind = document.createElement('span');
            ind.className = 'tool-seg-ind';
            ind.setAttribute('aria-hidden', 'true');
            seg.prepend(ind);
          }
          placeSegIndicator(seg);
          if (seg.dataset.segReady) return;
          seg.dataset.segReady = '1';
          // Les scripts de chaque outil basculent .on sur le bouton cliqué. Leur
          // écouteur est posé sur le bouton, le nôtre sur le conteneur : en phase
          // de remontée, la classe est donc déjà à jour. On replace sans passer
          // par requestAnimationFrame, gelé lorsque l'onglet n'est pas visible.
          seg.addEventListener('click', () => placeSegIndicator(seg));
          if ('ResizeObserver' in window) {
            new ResizeObserver(() => placeSegIndicator(seg)).observe(seg);
          }
        });
      }

      // Le chiffre principal se déplace vers sa nouvelle valeur au lieu de sauter.
      // On lit le texte écrit par l'outil, on l'anime, on réécrit dans le même
      // format : aucun calculateur n'a besoin de savoir que ce mécanisme existe.
      function decompose(text: string) {
        const m = text.match(/-?[\d   ]*\d(?:[.,]\d+)?/);
        if (!m || m.index === undefined) return null;
        const raw = m[0];
        const value = parseFloat(raw.replace(/[   ]/g, '').replace(',', '.'));
        if (Number.isNaN(value)) return null;
        const dec = (raw.split(/[.,]/)[1] || '').length;
        return { value, dec, pre: text.slice(0, m.index), post: text.slice(m.index + raw.length) };
      }

      function setupNumberMorph() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.querySelectorAll<HTMLElement>('.tool-result .big').forEach((el) => {
          if (el.dataset.morphReady) return;
          el.dataset.morphReady = '1';

          let shown: number | null = null;
          let writing = false;
          let frame = 0;

          const observer = new MutationObserver(() => {
            if (writing) return;
            const target = decompose(el.textContent || '');
            if (!target) { shown = null; return; }
            if (shown === null || Math.abs(target.value - shown) < 0.5) { shown = target.value; return; }

            const from = shown;
            const span = target.value - from;
            const start = performance.now();
            cancelAnimationFrame(frame);

            const step = (now: number) => {
              const t = Math.min(1, (now - start) / 260);
              const eased = 1 - Math.pow(1 - t, 3);
              shown = from + span * eased;
              writing = true;
              el.textContent = target.pre
                + shown.toLocaleString('fr-FR', { minimumFractionDigits: target.dec, maximumFractionDigits: target.dec })
                + target.post;
              writing = false;
              if (t < 1) frame = requestAnimationFrame(step);
              else shown = target.value;
            };
            frame = requestAnimationFrame(step);
          });

          const first = decompose(el.textContent || '');
          shown = first ? first.value : null;
          observer.observe(el, { childList: true, characterData: true, subtree: true });
        });
      }

      // Sur mobile, le panneau de résultat passe sous les curseurs : on déplace
      // le chiffre principal dans une barre basse, visible pendant le réglage.
      // Elle se construit toute seule à partir du premier .tool-result de la
      // page, donc aucun calculateur n'a de HTML à prévoir pour elle.
      function setupMobileBar() {
        const result = document.querySelector<HTMLElement>('.tool-result');
        if (!result || document.querySelector('.tool-bar')) return;
        const label = result.querySelector<HTMLElement>('.lbl');
        const value = result.querySelector<HTMLElement>('.big');
        if (!label || !value) return;

        const bar = document.createElement('div');
        bar.className = 'tool-bar';
        bar.setAttribute('aria-hidden', 'true');
        const k = document.createElement('span');
        k.className = 'k';
        const v = document.createElement('span');
        v.className = 'v';
        bar.append(k, v);
        document.body.appendChild(bar);

        const sync = () => {
          k.textContent = label.textContent;
          v.textContent = value.textContent;
        };
        sync();
        new MutationObserver(sync).observe(value, { childList: true, characterData: true, subtree: true });

        const card = result.closest('.tool-card');
        if (!card || !('IntersectionObserver' in window)) return;
        // Visible quand l'outil est à l'écran, sauf si le panneau l'est déjà.
        let toolVisible = false;
        let panelVisible = false;
        const update = () => bar.classList.toggle('on', toolVisible && !panelVisible);
        new IntersectionObserver((e) => { toolVisible = e[0].isIntersecting; update(); },
          { rootMargin: '-5% 0px -20% 0px' }).observe(card);
        new IntersectionObserver((e) => { panelVisible = e[0].isIntersecting; update(); },
          { threshold: 0.4 }).observe(result);
      }

      function setupToolChrome() {
        setupToolPrecision();
        setupRangeFill();
        setupSegments();
        setupNumberMorph();
        setupMobileBar();
      }

      // Les curseurs du diagnostic sont reconstruits à chaque étape : on rattrape
      // tout ce qui apparaît après coup plutôt que de repasser à la main.
      function watchToolPrecision() {
        // Le morphing du chiffre réécrit du texte à chaque image : sans ce
        // regroupement, l'observateur relancerait un balayage 60 fois par seconde.
        let queued = 0;
        const obs = new MutationObserver(() => {
          cancelAnimationFrame(queued);
          queued = requestAnimationFrame(() => setupToolChrome());
        });
        obs.observe(document.body, { childList: true, subtree: true });
        const open = (target: EventTarget | null) => {
          const display = (target as HTMLElement | null)?.closest<HTMLElement>(VALUE_SELECTOR);
          if (!display) return false;
          const range = rangeNear(display);
          if (!range) return false;
          openExactInput(display, range);
          return true;
        };
        document.addEventListener('click', (e) => open(e.target));
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          if ((e.target as HTMLElement | null)?.tagName === 'INPUT') return;
          if (open(e.target)) e.preventDefault();
        });
      }

      setupReveal();
      setupParallax();
      setupToolChrome();
      watchToolPrecision();
      const replaceAllSegs = () => {
        document.querySelectorAll<HTMLElement>('.tool-seg').forEach((seg) => placeSegIndicator(seg));
      };
      window.addEventListener('resize', replaceAllSegs);
      // Au retour sur l'onglet, les mesures faites en arrière-plan peuvent être
      // fausses (largeurs nulles) : on repositionne une fois la page revisible.
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) replaceAllSegs();
      });
      document.addEventListener('astro:page-load', () => {
        setupReveal();
        setupParallax();
        setupToolChrome();
      });
    </script>
  </body>
</html>
