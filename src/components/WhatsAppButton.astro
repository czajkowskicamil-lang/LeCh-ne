---
// Bouton « Écrire sur WhatsApp » : le contact le plus léger pour un sportif,
// qui écrit un message plutôt que de réserver un créneau. Message pré-rempli,
// que le visiteur peut modifier avant d'envoyer depuis son propre WhatsApp.
import { site } from '../data/site';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  /** 'dark' sur fond sombre (accueil), 'light' sur fond crème. */
  tone?: 'dark' | 'light';
  /** 'sport' : message pré-rempli pensé pour un athlète. */
  context?: 'sport' | 'general';
  class?: string;
}
const { tone = 'dark', context = 'general', class: extra = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const number = site.phone.tel.replace(/\D/g, '');

const text = lang === 'en'
  ? context === 'sport'
    ? "Hello Camil, I'm an athlete and I'd like to talk about my finances."
    : "Hello Camil, I'd like to talk about my financial situation."
  : context === 'sport'
    ? "Bonjour Camil, je suis sportif et j'aimerais échanger sur mon patrimoine."
    : "Bonjour Camil, j'aimerais échanger sur ma situation patrimoniale.";
const label = lang === 'en' ? 'Message me on WhatsApp' : 'Écrire sur WhatsApp';
const href = `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
---

<a href={href} target="_blank" rel="noopener" class:list={['wa-btn btn-round', tone === 'dark' ? 'wa-dark' : 'wa-light', extra]}>
  <svg class="wa-ico" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
  <span>{label}</span>
</a>

<style>
  .wa-btn.btn-round { gap: .7rem; padding: .55rem 1.6rem .55rem .6rem !important; min-height: 3.1rem; font-size: .95rem; font-weight: 500; }
  .wa-ico { box-sizing: content-box; padding: 7px; border-radius: 999px; background: #25D366; color: #fff; }
  .wa-dark { border: 1px solid rgba(242,237,228,.22); color: #F2EDE4; }
  .wa-dark:hover { border-color: #F2EDE4; }
  .wa-light { border: 1px solid rgba(3,16,46,.2); color: #03102E; }
  .wa-light:hover { border-color: #03102E; }
</style>
