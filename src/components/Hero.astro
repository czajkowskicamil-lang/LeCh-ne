---
import { site } from '../data/site';
import Magnetic from './Magnetic.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const diagnosticHref = localizePath('/outils/diagnostic-patrimonial', lang);
---

<!-- Hero cinématique plein écran — forêt à l'aube, étalonnée navy/or -->
<section class="hero-forest relative -mt-20 flex min-h-[100svh] flex-col overflow-hidden bg-navy-darker">
  <!-- Image (conteneur = parallaxe, image = Ken Burns) -->
  <div class="hero-media absolute inset-0" data-parallax="0.12" aria-hidden="true">
    <img
      src="/hero-forest.jpg"
      alt=""
      class="hero-img h-full w-full object-cover"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <!-- Réchauffement doré (heure dorée) -->
  <div aria-hidden="true" class="hero-warm absolute inset-0"></div>
  <!-- Halo de lumière (soleil qui perce) -->
  <div aria-hidden="true" class="hero-sun absolute inset-0"></div>
  <!-- Vignette + voiles navy pour la lisibilité et la transition -->
  <div aria-hidden="true" class="hero-vignette absolute inset-0"></div>
  <div aria-hidden="true" class="hero-scrim absolute inset-0"></div>
  <div aria-hidden="true" class="hero-shade absolute inset-0"></div>

  <!-- Contenu -->
  <div class="shell relative z-10 flex flex-1 flex-col justify-center pt-32 pb-28 md:pb-32">
    <div class="hero-copy max-w-3xl">
      <p class="hero-eyebrow mb-7 flex items-center gap-4 text-or-light">
        <span class="hero-index font-serif">01</span>
        <span class="inline-block h-px w-10 bg-or/70"></span>
        {t('hero.eyebrow')}
      </p>

      <h1 class="hero-title mb-7 font-serif text-cream">
        <span class="hero-line block"><span>{t('hero.title1')}</span></span>
        <span class="hero-line block" style="transition-delay:120ms"><span class="italic text-or-light">{t('hero.title2')}</span></span>
      </h1>

      <p class="hero-sub mb-10 max-w-xl text-lg leading-relaxed text-cream md:text-xl">
        {t('hero.subLead')} <span class="font-medium text-cream">{t('hero.subBold')}</span> {t('hero.subTail')}
      </p>
    </div>

    <div class="hero-cta flex flex-wrap gap-4">
      <Magnetic>
        <a href={diagnosticHref} class="btn-or">
          {t('hero.cta1')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </Magnetic>
      <a href={site.calendly} target="_blank" rel="noopener" class="btn-ghost-cream">{t('hero.cta2')}</a>
    </div>

    <!-- Références : grille libellée, sobre -->
    <div class="hero-trust mt-14 max-w-2xl">
      <div class="hero-meta-rule mb-6"></div>
      <dl class="grid grid-cols-2 gap-x-10 gap-y-6 sm:grid-cols-3">
        <div>
          <dt class="hero-meta-label">{t('hero.trust.cabinetLabel')}</dt>
          <dd class="hero-meta-value">{t('hero.trust.cabinetValue')}</dd>
        </div>
        <div>
          <dt class="hero-meta-label">{t('hero.trust.registrationLabel')}</dt>
          <dd class="hero-meta-value">ORIAS 25&nbsp;00&nbsp;00&nbsp;16</dd>
        </div>
        <div>
          <dt class="hero-meta-label">{t('hero.trust.presenceLabel')}</dt>
          <dd class="hero-meta-value">Paris · Lyon · Bordeaux · Strasbourg · Nice · Montpellier · Marseille · Genevois</dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Indicateur de scroll -->
  <div class="hero-scroll absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 text-xs uppercase tracking-micro text-cream/50 md:flex">
    <span>{t('hero.scroll')}</span>
    <span class="block h-12 w-px bg-cream/30 hero-scroll-line"></span>
  </div>
</section>

<style>
  /* ---------- Étalonnage de l'image ---------- */
  .hero-img {
    /* réchauffe (sepia léger), densifie, adoucit — retire le côté froid du brut */
    filter: saturate(1.05) contrast(1.04) brightness(0.92) sepia(0.16);
    transform: scale(1.08);
    animation: hero-kenburns 26s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes hero-kenburns {
    from { transform: scale(1.08) translate3d(0, 0, 0); }
    to   { transform: scale(1.16) translate3d(-1.5%, -1.2%, 0); }
  }

  /* Voile ambré chaud posé sur l'image (heure dorée) */
  .hero-warm {
    background:
      linear-gradient(180deg, rgba(212,168,45,0.10) 0%, rgba(167,128,31,0.06) 45%, transparent 75%);
    mix-blend-mode: soft-light;
    opacity: 0.9;
  }
  /* Soleil qui perce, en haut à droite */
  .hero-sun {
    background: radial-gradient(120% 90% at 78% 8%, rgba(255,224,150,0.30) 0%, rgba(212,168,45,0.10) 28%, transparent 55%);
    mix-blend-mode: screen;
    opacity: 0.9;
  }
  /* Vignette douce pour concentrer le regard */
  .hero-vignette {
    background: radial-gradient(130% 120% at 50% 40%, transparent 45%, rgba(3,9,28,0.55) 100%);
  }
  /* Voile latéral léger : juste ce qu'il faut pour la lisibilité, image lumineuse */
  .hero-scrim {
    background:
      linear-gradient(100deg, rgba(3,9,28,0.42) 0%, rgba(3,9,28,0.20) 30%, rgba(3,9,28,0.05) 52%, transparent 72%);
  }
  /* Voile navy léger : haut lisible + fondu vers la section suivante */
  .hero-shade {
    background:
      linear-gradient(180deg, rgba(3,9,28,0.40) 0%, rgba(3,9,28,0.06) 20%, transparent 40%, rgba(3,9,28,0.22) 70%, rgba(3,16,46,0.90) 100%);
  }

  /* ---------- Structure éditoriale (signature, pas un template) ---------- */
  .hero-copy {
    border-left: 1px solid rgba(212, 168, 45, 0.45);
    padding-left: clamp(1.25rem, 3vw, 2.75rem);
  }
  .hero-index {
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: rgba(230, 194, 89, 0.85);
    font-variant-numeric: tabular-nums;
  }
  .hero-meta-rule {
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, rgba(212,168,45,0.55), rgba(245,241,232,0.12) 60%, transparent);
  }
  .hero-meta-label {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(230, 194, 89, 0.9);
    margin-bottom: 0.35rem;
  }
  .hero-meta-value {
    font-size: 0.95rem;
    color: rgba(245, 241, 232, 0.92);
    text-shadow: 0 1px 3px rgba(3,9,28,0.7);
  }
  @media (max-width: 640px) {
    .hero-copy { border-left: none; padding-left: 0; }

    /* La barre CTA et le lanceur du chat occupent le bas de l'écran : sans ça
       le lanceur recouvre la ligne ORIAS (chevauchement mesuré 54 x 16 px). */
    .hero-forest .shell {
      padding-bottom: 11rem;
    }
    .hero-trust {
      margin-top: 2.25rem;
      padding-right: 4.5rem;
    }
  }

  /* ---------- Typographie ---------- */
  .hero-eyebrow {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-shadow: 0 1px 3px rgba(3, 9, 28, 0.7), 0 2px 22px rgba(3, 9, 28, 0.65);
  }
  .hero-title {
    font-size: clamp(2.75rem, 6.4vw, 5.6rem);
    line-height: 1.0;
    letter-spacing: -0.032em;
    font-weight: 400;
    text-shadow: 0 2px 6px rgba(3,9,28,0.55), 0 4px 40px rgba(3,9,28,0.7);
  }
  .hero-sub {
    text-shadow: 0 1px 3px rgba(3,9,28,0.85), 0 2px 24px rgba(3,9,28,0.8);
  }

  /* ---------- Entrée à l'arrivée ---------- */
  .hero-line { overflow: hidden; }
  .hero-line > span {
    display: block;
    transform: translateY(110%);
    animation: hero-rise 1.15s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero-line:nth-child(2) > span { animation-delay: 0.12s; }
  @keyframes hero-rise { to { transform: translateY(0); } }

  .hero-eyebrow, .hero-sub, .hero-cta, .hero-trust {
    opacity: 0;
    animation: hero-fade 1s ease-out forwards;
  }
  .hero-eyebrow { animation-delay: 0.05s; }
  .hero-sub    { animation-delay: 0.45s; }
  .hero-cta    { animation-delay: 0.6s; }
  .hero-trust  { animation-delay: 0.75s; }
  @keyframes hero-fade { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

  /* Ligne de scroll animée */
  .hero-scroll-line {
    transform-origin: top;
    animation: hero-scroll 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes hero-scroll {
    0%   { transform: scaleY(0); transform-origin: top; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-img { animation: none; transform: scale(1.05); }
    .hero-line > span,
    .hero-eyebrow, .hero-sub, .hero-cta, .hero-trust { animation: none; opacity: 1; transform: none; }
    .hero-scroll-line { animation: none; }
  }
</style>
