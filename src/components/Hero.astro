---
import { site } from '../data/site';
import Magnetic from './Magnetic.astro';
import PartnersMarquee from './PartnersMarquee.astro';
---

<section class="relative overflow-hidden pt-16 pb-24 md:pt-24 md:pb-32">
  <!-- Decorative: monogramme Le Chêne en watermark sobre, style Apple/Tesla -->
  <img
    src="/logo-mark.png"
    alt=""
    aria-hidden="true"
    data-parallax="0.15"
    class="pointer-events-none select-none absolute -right-24 -top-10 w-[560px] h-[560px] object-contain opacity-[0.22]"
  />

  <div class="shell relative grid lg:grid-cols-12 gap-12 items-end">
    <div class="lg:col-span-8">
      <p class="eyebrow mb-6 flex items-center gap-3 reveal">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Conseil en gestion de patrimoine · Indépendant
      </p>

      <h1 class="font-serif text-display-xl text-ink mb-8">
        <span class="reveal-mask"><span>Faire fructifier</span></span><br/>
        <span class="reveal-mask" style="transition-delay:120ms"><span class="italic text-chene">ce qui compte.</span></span>
      </h1>

      <p class="max-w-xl text-lg md:text-xl text-ink/75 leading-relaxed mb-10 reveal" style="transition-delay:260ms">
        Accompagnement patrimonial personnalisé pour entrepreneurs, particuliers, dirigeants
        et sportifs de haut niveau. Stratégie, méthode, transparence, sans jargon,
        sans banque derrière moi, sans compromis.
      </p>

      <div class="flex flex-wrap gap-4 reveal" style="transition-delay:340ms">
        <Magnetic>
          <a href={site.calendly} target="_blank" rel="noopener" class="btn-primary">
            Planifier un rendez-vous découverte
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </Magnetic>
        <a href="/parcours" class="btn-ghost">Découvrir mon parcours</a>
      </div>
    </div>

    <div class="lg:col-span-4 reveal" style="animation-delay:320ms">
      <div class="bg-ink text-cream p-8 md:p-10 relative">
        <div class="absolute -top-3 left-8 bg-or text-ink text-[0.65rem] uppercase tracking-micro px-3 py-1">
          En un coup d'œil
        </div>
        <dl class="space-y-6 mt-4">
          <div>
            <dt class="text-xs uppercase tracking-micro text-or-light mb-1">Indépendance</dt>
            <dd class="font-serif text-xl">Aucune banque derrière moi</dd>
          </div>
          <div class="h-px bg-cream/10"></div>
          <div>
            <dt class="text-xs uppercase tracking-micro text-or-light mb-1">Approche</dt>
            <dd class="font-serif text-xl">Stratégique & long terme</dd>
          </div>
          <div class="h-px bg-cream/10"></div>
          <div>
            <dt class="text-xs uppercase tracking-micro text-or-light mb-1">Premier rendez-vous</dt>
            <dd class="font-serif text-xl">Offert & sans engagement</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <div class="mt-20 md:mt-24">
    <PartnersMarquee />
  </div>
</section>
