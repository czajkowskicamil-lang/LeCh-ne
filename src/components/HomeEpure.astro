---
// Accueil épuré (FR + EN) : une seule teinte sombre, peu de mots, cartes
// arrondies, une ligne de temps. Codes du Chêne : logo, forêt, or, crème,
// marine poussé presque au noir. Titres Cormorant Garamond, texte Inter.
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import { temoignages } from '../data/temoignages';
import { getLangFromUrl, localizePath } from '../i18n/utils';
import { translatedRoutes } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
// Lien localisé seulement si la page existe en anglais (jamais de 404).
const L = (path: string) => (translatedRoutes.has(path) ? localizePath(path, lang) : path);

// Avis mis en avant, dans l'ordre voulu par Camil.
// Slobodan : extrait seulement. Son avis complet (sur /avis) cite des
// « produits obligataires », hors du statut COA + carte T : on ne le met pas
// en avant sur l'accueil. L'extrait reprend ses mots exacts, signalés par […].
const extraits: Record<string, string> = {
  'Slobodan Ocokoljic':
    "[…] Je regrette simplement de ne pas avoir connu Camil plus tôt, notamment pendant ma carrière d'athlète professionnel : j'aurais certainement pu mieux faire fructifier mon épargne ! Je recommande vivement Camil et Le Chêne Patrimonial pour la qualité de l'accompagnement et la confiance qu'ils inspirent.",
};
const avis = ['Slobodan Ocokoljic', 'Kévin Monier', 'Temenuzhka Nikolova']
  .map((a) => temoignages.find((x) => x.author === a))
  .filter((x): x is NonNullable<typeof x> => Boolean(x))
  .map((x) => ({ ...x, quote: extraits[x.author] ?? x.quote }));

const T = lang === 'en'
  ? {
      pill: 'Elite athletes',
      title1: 'Grow what',
      title2: 'truly matters.',
      h1: 'Independent wealth advisor in Montpellier, France',
      cta1: 'Book a call',
      cta2: 'Free wealth check-up',
      stat1: 'complimentary',
      stat2: 'independent',
      storyLabel: 'From athlete to advisor',
      storyTitle: 'Everything that lasts is prepared well in advance.',
      storyBody: 'I competed as an elite athlete before becoming an advisor. I bring the same discipline to every client’s wealth.',
      storyLink: 'My story →',
      whoLabel: 'Who I work with',
      whoTitle: 'Four profiles, one standard.',
      profils: [
        { t: 'Elite athletes', d: 'A short career, concentrated income, and a life after sport to prepare while it lasts.', href: '/sportifs-haut-niveau' },
        { t: 'Executives', d: 'Savings built up over the years, finally brought into one coherent plan.', href: '/expertise' },
        { t: 'Entrepreneurs', d: 'Business sale, holding structure, succession: prepared two years ahead.', href: '/expertise' },
        { t: 'Individuals', d: 'A clear method to know exactly where you stand.', href: '/outils/diagnostic-patrimonial' },
      ],
      methodLabel: 'The method',
      methodTitle: 'Four steps, at your own pace.',
      step: 'Step',
      etapes: [
        { t: 'Conversation', d: 'A complimentary 30-minute call, by video or in Montpellier.' },
        { t: 'Assessment', d: 'A clear, quantified review of your wealth and your taxes.' },
        { t: 'Strategy', d: 'An independent roadmap, with clear priorities.' },
        { t: 'Follow-up', d: 'Adjusted to every season of your life.' },
      ],
      reviewsLabel: 'Client reviews',
      reviewsTitle: 'They say it better than I do.',
      reviewsNote: 'Reviews quoted in their original French.',
      reviewsLink: 'Read all reviews →',
      finalTitle1: 'Book your',
      finalTitle2: 'first conversation.',
      finalBody: '30 minutes, complimentary, no commitment.',
      finalCta: 'Choose a time',
    }
  : {
      pill: 'Sportifs de haut niveau',
      title1: 'Faire fructifier',
      title2: 'ce qui compte.',
      h1: 'Conseiller en gestion de patrimoine indépendant à Montpellier',
      cta1: 'Prendre rendez-vous',
      cta2: 'Mon diagnostic gratuit',
      stat1: 'offertes',
      stat2: 'indépendant',
      storyLabel: "L'athlète devenu conseiller",
      storyTitle: "Tout ce qui dure se prépare longtemps à l'avance.",
      storyBody: "J'ai été sportif de haut niveau avant d'être conseiller. J'applique la même exigence à chaque patrimoine.",
      storyLink: 'Mon parcours →',
      whoLabel: 'Pour qui',
      whoTitle: 'Quatre profils, une même exigence.',
      profils: [
        { t: 'Sportifs de haut niveau', d: 'Une carrière courte, des revenus concentrés, un après à préparer pendant.', href: '/sportifs-haut-niveau' },
        { t: 'Dirigeants et cadres', d: 'Des enveloppes accumulées, enfin mises en cohérence.', href: '/expertise' },
        { t: 'Entrepreneurs', d: 'Cession, holding, transmission : préparés deux ans avant.', href: '/expertise' },
        { t: 'Particuliers', d: 'Une méthode claire pour savoir où vous en êtes.', href: '/outils/diagnostic-patrimonial' },
      ],
      methodLabel: 'La méthode',
      methodTitle: 'Quatre temps, à votre rythme.',
      step: 'Étape',
      etapes: [
        { t: 'Échange', d: '30 minutes offertes, en visio ou à Montpellier.' },
        { t: 'Diagnostic', d: 'Une lecture chiffrée de votre patrimoine et de votre fiscalité.' },
        { t: 'Stratégie', d: 'Une feuille de route hiérarchisée, indépendante.' },
        { t: 'Suivi', d: 'Ajusté à chaque saison de votre vie.' },
      ],
      reviewsLabel: 'Avis clients',
      reviewsTitle: 'Ils en parlent mieux que moi.',
      reviewsNote: '',
      reviewsLink: 'Lire tous les avis →',
      finalTitle1: 'Réservez votre',
      finalTitle2: 'premier échange.',
      finalBody: '30 minutes offertes, sans engagement.',
      finalCta: 'Choisir un créneau',
    };
---

<div class="ep">
  <!-- HERO -->
  <section class="ep-hero relative -mt-20 flex min-h-[100svh] flex-col items-center justify-center overflow-hidden px-6 pt-32 pb-20 text-center">
    <img src="/hero-forest.jpg" alt="" aria-hidden="true" fetchpriority="high" decoding="async" class="ep-forest absolute inset-0 h-full w-full object-cover" />
    <div aria-hidden="true" class="ep-veil absolute inset-0"></div>
    <div aria-hidden="true" class="ep-glow absolute inset-0"></div>
    <div class="relative z-10 flex flex-col items-center">
      <p class="ep-pill ep-in mb-12 inline-flex items-center gap-3 rounded-full px-6 py-3 text-[15px]">
        <span class="h-1.5 w-1.5 rounded-full bg-or" aria-hidden="true"></span>
        {T.pill}
      </p>
      <p class="ep-title ep-in" style="animation-delay:.08s">
        {T.title1}<br /><em>{T.title2}</em>
      </p>
      <h1 class="ep-sub ep-in mt-8" style="animation-delay:.16s">{T.h1}</h1>
      <div class="ep-in mt-12 flex flex-wrap justify-center gap-3" style="animation-delay:.24s">
        <a href={L('/rendez-vous')} class="ep-btn ep-btn-or">{T.cta1}</a>
        <a href={L('/outils/diagnostic-patrimonial')} class="ep-btn ep-btn-ghost">{T.cta2}</a>
      </div>
      <dl class="ep-in mt-20 flex flex-wrap items-baseline justify-center gap-x-8 gap-y-3" style="animation-delay:.32s">
        <div class="flex items-baseline gap-2"><dd class="ep-num"><span data-count="30">30</span> min</dd><dt class="ep-muted">{T.stat1}</dt></div>
        <span class="ep-dot" aria-hidden="true">·</span>
        <div class="flex items-baseline gap-2"><dd class="ep-num"><span data-count="100">100</span> %</dd><dt class="ep-muted">{T.stat2}</dt></div>
      </dl>
    </div>
    <p class="ep-label absolute bottom-8 left-0 right-0 z-10 text-center">Le Chêne Patrimonial</p>
  </section>

  <!-- HISTOIRE : photo de course en grand, fondue dans le fond -->
  <section class="ep-athlete relative overflow-hidden">
    <div class="ep-athlete-media relative w-full lg:absolute lg:inset-y-0 lg:right-0 lg:w-[58%]" aria-hidden="true">
      <picture>
        <source type="image/webp" srcset="/camil-buste.webp" />
        <img src="/camil-buste.jpg" alt="" width="900" height="620" loading="lazy" decoding="async" class="ep-athlete-img block aspect-[900/620] w-full object-cover lg:aspect-auto lg:h-full" />
      </picture>
    </div>
    <div class="ep-athlete-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="ep-wrap-lg relative z-10 -mt-6 flex px-5 pb-20 lg:mt-0 lg:min-h-[86vh] lg:items-center lg:py-28">
      <div class="max-w-md">
        <p class="ep-label mb-4 text-left">{T.storyLabel}</p>
        <h2 class="ep-h2 mb-5">{T.storyTitle}</h2>
        <p class="ep-muted mb-8">{T.storyBody}</p>
        <a href={L('/parcours')} class="ep-link">{T.storyLink}</a>
      </div>
    </div>
  </section>

  <!-- POUR QUI -->
  <section class="ep-sec">
    <div class="ep-wrap">
      <p class="ep-label mb-4">{T.whoLabel}</p>
      <h2 class="ep-h2 mb-12 text-center">{T.whoTitle}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {T.profils.map((p) => (
          <a href={L(p.href)} class="ep-card ep-hover block p-8">
            <h3 class="ep-h3 mb-3">{p.t}</h3>
            <p class="ep-muted">{p.d}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MÉTHODE -->
  <section class="ep-sec">
    <div class="ep-wrap">
      <p class="ep-label mb-4">{T.methodLabel}</p>
      <h2 class="ep-h2 mb-14 text-center">{T.methodTitle}</h2>
      <ol class="ep-line relative ml-3 space-y-12 pl-10" data-progress>
        {T.etapes.map((e, i) => (
          <li class="relative">
            <span class="ep-node" aria-hidden="true"></span>
            <p class="ep-step mb-2">{T.step} {String(i + 1).padStart(2, '0')}</p>
            <h3 class="ep-h3 mb-2">{e.t}</h3>
            <p class="ep-muted">{e.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- AVIS -->
  <section class="ep-sec">
    <div class="ep-wrap-lg">
      <p class="ep-label mb-4">{T.reviewsLabel}</p>
      <h2 class="ep-h2 mb-12 text-center">{T.reviewsTitle}</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {avis.map((a) => (
          <figure class="ep-card flex flex-col p-8" lang="fr">
            <blockquote class="ep-quote flex-1">« {a.quote} »</blockquote>
            <figcaption class="ep-muted mt-6 text-sm">{a.author}{a.role ? `, ${a.role}` : ''}</figcaption>
          </figure>
        ))}
      </div>
      {T.reviewsNote && <p class="ep-muted mt-6 text-center text-sm">{T.reviewsNote}</p>}
      <p class="mt-10 text-center"><a href={L('/avis')} class="ep-link">{T.reviewsLink}</a></p>
    </div>
  </section>

  <!-- RDV -->
  <section class="ep-sec pb-40 text-center">
    <div class="ep-wrap">
      <h2 class="ep-title-sm mb-6">{T.finalTitle1}<br /><em>{T.finalTitle2}</em></h2>
      <p class="ep-muted mb-10">{T.finalBody}</p>
      <a href={L('/rendez-vous')} class="ep-btn ep-btn-or">{T.finalCta}</a>
    </div>
  </section>
</div>

<script>
  // Chiffres qui défilent comme un chrono, et ligne de méthode qui se remplit
  // au défilement. Rien ne bouge si le visiteur a demandé moins d'animations.
  function initEp() {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      if (calm || el.dataset.done) return;
      el.dataset.done = '1';
      const end = Number(el.dataset.count);
      const t0 = performance.now() + 500;
      const tick = (now: number) => {
        const k = Math.min(1, Math.max(0, (now - t0) / 1600));
        el.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(tick);
      };
      el.textContent = '0';
      requestAnimationFrame(tick);
    });

    const line = document.querySelector<HTMLElement>('[data-progress]');
    if (!line) return;
    const nodes = [...line.querySelectorAll<HTMLElement>('.ep-node')];
    const update = () => {
      const r = line.getBoundingClientRect();
      const mid = innerHeight * 0.6;
      const p = calm ? 1 : Math.min(1, Math.max(0, (mid - r.top) / r.height));
      line.style.setProperty('--p', String(p));
      nodes.forEach((n) => {
        const nr = n.getBoundingClientRect();
        n.classList.toggle('is-on', calm || nr.top < mid);
      });
    };
    update();
    addEventListener('scroll', update, { passive: true });
  }
  initEp();
  document.addEventListener('astro:page-load', initEp);
</script>

<style is:global>
  /* Une seule teinte sur toute la page : en-tête, barre mobile, chatbot,
     menu et pied de page reprennent le fond et l'or de l'accueil épuré. */
  body:has(.ep) { background: #0A0D14; }
  body:has(.ep) header.nav-hero,
  body:has(.ep) header.nav-hero.is-solid {
    color: #F2EDE4;
  }
  body:has(.ep) header.nav-hero.is-solid {
    background: rgba(10, 13, 20, 0.86);
    border-bottom-color: rgba(242, 237, 228, 0.08);
  }
  body:has(.ep) header.nav-hero .nav-faitage { color: #F2EDE4; }
  body:has(.ep) header.nav-hero img { filter: none; }
  body:has(.ep) header.nav-hero .nav-cta {
    background-color: #C9A55C;
    color: #0A0D14;
    border-radius: 999px;
  }
  body:has(.ep) header.nav-hero .nav-cta:hover { background-color: #D8B872; }
  body:has(.ep) #menu-backdrop { background: #0A0D14; }
  body:has(.ep) footer { background: #0A0D14; margin-top: 0; border-top: 1px solid rgba(242, 237, 228, 0.08); }
  body:has(.ep) .mobile-cta { background: rgba(10, 13, 20, 0.88); border-top: 1px solid rgba(242, 237, 228, 0.08); }
  body:has(.ep) .mobile-cta-btn { background: #C9A55C; color: #0A0D14; border-radius: 999px; }
  body:has(.ep) .lc-launcher { background: #121722; border-color: rgba(201, 165, 92, 0.55); }
</style>

<style>
  .ep { --bg: #0A0D14; --card: #121722; --line: rgba(242,237,228,0.09); --cream: #F2EDE4; --gold: #C9A55C;
        background: var(--bg); color: var(--cream); }
  .ep-forest { filter: saturate(0.85) brightness(0.8) sepia(0.12); transform: scale(1.06); animation: ep-drift 30s ease-in-out infinite alternate; }
  @keyframes ep-drift { to { transform: scale(1.12) translate3d(-1%, -1%, 0); } }
  .ep-veil { background: linear-gradient(180deg, rgba(10,13,20,0.55) 0%, rgba(10,13,20,0.62) 55%, #0A0D14 100%); }
  .ep-glow { background: radial-gradient(55% 45% at 50% 48%, rgba(201,165,92,0.10), transparent 70%); }
  .ep-pill { border: 1px solid var(--line); background: rgba(242,237,228,0.02); color: rgba(242,237,228,0.9); }
  .ep-title, .ep-title-sm, .ep-h2, .ep-h3, .ep-quote {
    font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 300; letter-spacing: -0.01em; }
  .ep-title { font-size: clamp(3.2rem, 8.4vw, 7.5rem); line-height: 0.98; }
  .ep-title-sm { font-size: clamp(2.6rem, 5.5vw, 4.6rem); line-height: 1; }
  .ep-title em, .ep-title-sm em { font-style: italic; font-weight: 400; color: var(--gold); }
  .ep-sub { font-size: 0.74rem; font-weight: 500; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(242,237,228,0.55); max-width: 40rem; line-height: 1.9; }
  .ep-h2 { font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1.08; font-weight: 400; }
  .ep-h3 { font-size: 1.7rem; line-height: 1.15; font-weight: 400; }
  .ep-quote { font-size: 1.3rem; line-height: 1.4; font-weight: 400; color: rgba(242,237,228,0.92); }
  .ep-num { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2rem; font-weight: 400; color: var(--cream); }
  .ep-muted { color: rgba(242,237,228,0.58); line-height: 1.7; }
  .ep-dot { color: rgba(242,237,228,0.25); }
  .ep-label { font-size: 0.7rem; letter-spacing: 0.34em; text-transform: uppercase; color: var(--gold); text-align: center; }
  .ep-step { font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--gold); }
  .ep-sec { padding: 6rem 1.25rem; }
  .ep-wrap { max-width: 56rem; margin: 0 auto; }
  .ep-wrap-lg { max-width: 72rem; margin: 0 auto; }
  .ep-card { background: var(--card); border: 1px solid var(--line); border-radius: 22px; }
  .ep-hover { transition: border-color .4s, transform .4s; }
  .ep-hover:hover { border-color: rgba(201,165,92,0.45); transform: translateY(-2px); }
  .ep-line::before { content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 1px; background: linear-gradient(var(--gold), rgba(201,165,92,0.08)); }
  .ep-node { position: absolute; left: -2.5rem; top: 0.35rem; width: 11px; height: 11px; margin-left: -5px; border-radius: 999px; border: 1px solid var(--gold); background: var(--bg); box-shadow: 0 0 0 4px rgba(201,165,92,0.08); }
  .ep-btn { display: inline-flex; align-items: center; border-radius: 999px; padding: 0.95rem 1.8rem; font-size: 0.92rem; font-weight: 500; transition: all .3s; }
  .ep-btn-or { background: var(--gold); color: #0A0D14; }
  .ep-btn-or:hover { background: #D8B872; }
  .ep-btn-ghost { border: 1px solid rgba(242,237,228,0.2); color: var(--cream); }
  .ep-btn-ghost:hover { border-color: var(--cream); }
  .ep-link { color: var(--gold); border-bottom: 1px solid rgba(201,165,92,0.35); padding-bottom: 2px; }
  .ep-athlete-img { object-position: 50% 60%; filter: saturate(0.9) contrast(1.05); }
  /* Ordinateur : fondu à gauche vers le texte, léger en haut et en bas pour
     laisser voir le logo du maillot. Mobile : photo entière, fondu en bas. */
  .ep-athlete-fade {
    background:
      linear-gradient(90deg, #0A0D14 0%, #0A0D14 34%, rgba(10,13,20,0.5) 50%, rgba(10,13,20,0) 66%),
      linear-gradient(180deg, #0A0D14 0%, rgba(10,13,20,0) 12%, rgba(10,13,20,0) 93%, #0A0D14 100%);
  }
  @media (max-width: 1023px) {
    .ep-athlete-fade { background: linear-gradient(180deg, #0A0D14 0%, rgba(10,13,20,0) 10%); }
    .ep-athlete-media::after { content: ''; position: absolute; inset: auto 0 0 0; height: 9%; background: linear-gradient(180deg, rgba(10,13,20,0), #0A0D14); }
  }
  .ep-line::after { content: ''; position: absolute; left: 0; top: 6px; width: 1px; height: calc((100% - 12px) * var(--p, 0)); background: var(--gold); box-shadow: 0 0 10px rgba(201,165,92,0.7); }
  .ep-node { transition: background .5s, box-shadow .5s; }
  .ep-node.is-on { background: var(--gold); box-shadow: 0 0 0 5px rgba(201,165,92,0.18); }
  .ep-in { opacity: 0; transform: translateY(12px); animation: ep-up 1.1s cubic-bezier(.16,1,.3,1) forwards; }
  @keyframes ep-up { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .ep-in { animation: none; opacity: 1; transform: none; } }
</style>
