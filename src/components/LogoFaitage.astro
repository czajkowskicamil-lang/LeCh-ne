---
// Logo Le Faitage.
//
// Un seul geste : le chevron de la ligne de faîte, posé au-dessus du nom. Pas
// de charpente dessinée, pas de détail technique. Le mot en capitales serif,
// « immobilier » en petites capitales espacées pour dire le métier sans
// alourdir la marque.
//
// Trois montages :
//   'empile' : chevron au-dessus, nom, puis le métier. Pour les pages.
//   'timbre' : même montage, proportions serrées pour tenir dans le header.
//   'ligne'  : chevron et nom côte à côte.
//   'signe'  : le chevron seul. Pour les favicons et les usages réduits.
interface Props {
  size?: number;
  layout?: 'empile' | 'timbre' | 'ligne' | 'signe';
  metier?: boolean;
  color?: string;
  class?: string;
}
const {
  size = 48,
  layout = 'signe',
  metier = true,
  color = 'currentColor',
  class: klass = '',
} = Astro.props;

// Un style inline l'emporterait sur une classe utilitaire passée via `class` :
// on ne le pose que si une couleur explicite a été demandée.
const style = color === 'currentColor' ? undefined : `color:${color}`;

// `size` est la largeur du chevron ; le reste s'en déduit.
const chevronH = Math.round(size * 0.42);
const nomTaille = layout === 'ligne' ? size * 0.34 : size * 0.235;
const metierTaille = nomTaille * 0.52;
---

{layout === 'signe' && (
  <svg
    width={size}
    height={chevronH}
    viewBox="0 0 64 27"
    fill="none"
    aria-hidden="true"
    class={klass}
    style={style}
  >
    <path
      d="M3 24 32 3l29 21"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
)}

{layout === 'empile' && (
  <span class={`inline-flex flex-col items-center ${klass}`} style={style}>
    <svg
      width={size}
      height={chevronH}
      viewBox="0 0 64 27"
      fill="none"
      aria-hidden="true"
      style={`margin-bottom:${size * 0.13}px`}
    >
      <path
        d="M3 24 32 3l29 21"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span
      class="font-serif leading-none"
      style={`font-size:${nomTaille}px;letter-spacing:0.07em`}
    >
      LE FAITAGE
    </span>
    {metier && (
      <span
        class="font-sans leading-none opacity-75"
        style={`font-size:${metierTaille}px;letter-spacing:0.34em;margin-top:${size * 0.075}px;text-indent:0.34em`}
      >
        IMMOBILIER
      </span>
    )}
  </span>
)}

{layout === 'timbre' && (
  <span class={`inline-flex flex-col items-center leading-none ${klass}`} style={style}>
    <svg
      width={size}
      height={chevronH}
      viewBox="0 0 64 27"
      fill="none"
      aria-hidden="true"
      style={`margin-bottom:${size * 0.09}px`}
    >
      <path
        d="M3 24 32 3l29 21"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span
      class="font-serif leading-none whitespace-nowrap"
      style={`font-size:${size * 0.3}px;letter-spacing:0.06em`}
    >
      LE FAITAGE
    </span>
  </span>
)}

{layout === 'ligne' && (
  <span class={`inline-flex items-center ${klass}`} style={style}>
    <svg
      width={size * 0.62}
      height={Math.round(size * 0.62 * 0.42)}
      viewBox="0 0 64 27"
      fill="none"
      aria-hidden="true"
      class="shrink-0"
      style={`margin-right:${size * 0.15}px`}
    >
      <path
        d="M3 24 32 3l29 21"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span class="font-serif leading-none" style={`font-size:${nomTaille}px;letter-spacing:0.06em`}>
      LE FAITAGE
    </span>
  </span>
)}
