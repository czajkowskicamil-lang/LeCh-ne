---
// Logo Le Faitage : une ferme de charpente vue de face. Les deux pans montent
// vers la ligne de faîte, marquée par la poutre faîtière qui déborde de part
// et d'autre. En dessous, l'entrait et le poinçon, les pièces qui tiennent
// l'ensemble. Le trait suit la finesse du logo du Chêne sans le concurrencer.
interface Props {
  size?: number;
  color?: string;
  withWordmark?: boolean;
  class?: string;
}
const {
  size = 48,
  color = 'currentColor',
  withWordmark = false,
  class: klass = '',
} = Astro.props;

// Un style inline l'emporterait sur une classe utilitaire passée via `class` :
// on ne le pose que si une couleur explicite a été demandée.
const style = color === 'currentColor' ? undefined : `color:${color}`;
---

{
  withWordmark ? (
    <span class={`inline-flex items-center gap-3 ${klass}`} style={style}>
      <svg
        width={size}
        height={size}
        viewBox="0 0 48 48"
        fill="none"
        aria-hidden="true"
        class="shrink-0"
      >
        {/* Les deux pans de toiture */}
        <path
          d="M6 37 24 14l18 23"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        {/* La poutre faîtière, au sommet, débordante */}
        <path d="M16 14h16" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" />
        {/* Entrait et poinçon : la charpente qui tient le tout */}
        <path d="M11 37h26M24 14v23" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
      <span class="font-serif tracking-[0.02em]" style={`font-size:${size * 0.52}px`}>
        Le Faitage
      </span>
    </span>
  ) : (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      aria-hidden="true"
      class={klass}
      style={style}
    >
      <path
        d="M6 37 24 14l18 23"
        stroke="currentColor"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path d="M16 14h16" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" />
      <path d="M11 37h26M24 14v23" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
    </svg>
  )
}
