---
// Section home : met en avant le Diagnostic Patrimonial Intelligent (outil gratuit,
// aimant à leads). Fond navy pour trancher et attirer l'oeil vers l'action principale.
// Visuel : un anneau de score illustratif /100 + aperçu de piliers.
const pillars = [
  { label: 'Épargne de précaution', v: 82 },
  { label: 'Diversification', v: 54 },
  { label: 'Préparation retraite', v: 38 },
];
const R = 52;
const C = 2 * Math.PI * R;
const demoScore = 72;
---

<section class="py-24 md:py-32 bg-navy-deep text-cream relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-or/30"></div>

  <div class="shell relative">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Texte + CTA -->
      <div class="lg:col-span-7 reveal">
        <p class="eyebrow-cream mb-5 flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-or"></span>
          Nouveau · Gratuit · 3 minutes
        </p>
        <h2 class="font-serif text-display text-cream mb-6 leading-tight">
          Où en est vraiment<br/>
          votre patrimoine&nbsp;?
        </h2>
        <p class="text-cream/75 text-lg leading-relaxed max-w-2xl mb-8">
          Quelques questions suffisent pour obtenir votre Indice de Santé Patrimoniale sur 100 :
          vos forces, vos angles morts, et un plan d'action sur 12 mois, calibré selon votre statut.
          C'est confidentiel et sans engagement.
        </p>

        <dl class="flex flex-wrap gap-x-12 gap-y-4 mb-10 border-t border-cream/15 pt-7">
          <div>
            <dt class="dt-label">01</dt>
            <dd class="text-cream/85 text-sm mt-1">Votre score sur 100</dd>
          </div>
          <div>
            <dt class="dt-label">02</dt>
            <dd class="text-cream/85 text-sm mt-1">Analyse personnalisée</dd>
          </div>
          <div>
            <dt class="dt-label">03</dt>
            <dd class="text-cream/85 text-sm mt-1">Rapport PDF offert</dd>
          </div>
        </dl>

        <a href="/outils/diagnostic-patrimonial" class="btn-or text-base">
          Faire mon diagnostic gratuit
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Aperçu éditorial : grand chiffre + piliers en filets -->
      <div class="lg:col-span-5 reveal" style="animation-delay:120ms">
        <div class="border border-cream/15 p-8 md:p-11">
          <div class="flex items-start justify-between mb-8">
            <div>
              <p class="eyebrow-cream mb-4">Aperçu · Exemple</p>
              <div class="flex items-baseline gap-2">
                <span class="font-serif text-cream leading-none tabular-nums text-[clamp(4rem,8vw,6rem)]">{demoScore}</span>
                <span class="font-serif text-cream/40 text-2xl">/100</span>
              </div>
              <p class="text-[0.62rem] uppercase tracking-micro text-or-light mt-3">Indice solide</p>
            </div>
          </div>

          <div class="space-y-5 border-t border-cream/15 pt-7">
            {pillars.map((p) => (
              <div>
                <div class="flex justify-between items-baseline mb-2">
                  <span class="text-sm text-cream/70">{p.label}</span>
                  <span class="text-sm text-cream tabular-nums">{p.v}<span class="text-cream/40 text-xs">/100</span></span>
                </div>
                <div class="h-px bg-cream/12">
                  <div class="h-px" style={`width:${p.v}%;background:${p.v >= 66 ? '#3E6247' : p.v >= 40 ? '#D4A82D' : '#b4472e'}`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .dt-label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: rgba(230, 194, 89, 0.9);
    font-variant-numeric: tabular-nums;
    font-family: 'Fraunces Variable', Fraunces, Georgia, serif;
  }
</style>
