---
import { site, nav, navSecondary } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="relative bg-ink text-cream/85 mt-40 overflow-hidden">

  <div class="shell relative pt-24 md:pt-32 pb-12">
    <!-- Grand titre éditorial type Tesla -->
    <div class="max-w-4xl mb-20 md:mb-28 reveal">
      <p class="eyebrow-cream mb-6 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-or"></span>
        Cabinet privé indépendant
      </p>
      <h2 class="font-serif text-cream mb-8" style="font-size: clamp(2.5rem, 5.5vw, 5rem); line-height: 1; letter-spacing: -0.025em;">
        Faire fructifier<br/>
        <span class="italic text-or-light">ce qui compte.</span>
      </h2>
      <a href={site.calendly} target="_blank" rel="noopener" class="btn-or inline-flex">
        Échanger 30 minutes
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Inscription La Lettre du Chêne -->
    <div class="grid md:grid-cols-2 gap-8 lg:gap-16 items-center pb-16 border-t border-cream/10 pt-16 reveal">
      <div>
        <p class="eyebrow-cream mb-4 flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-or"></span>
          La Lettre du Chêne
        </p>
        <p class="font-serif text-2xl md:text-3xl text-cream leading-snug">
          Une édition par mois.<br/>
          <span class="italic text-or-light">Un cas, un chiffre, une actualité.</span>
        </p>
      </div>
      <form id="footer-nl" class="w-full">
        <label for="footer-nl-email" class="text-xs uppercase tracking-micro text-or-light mb-3 block">Recevoir La Lettre</label>
        <div class="flex flex-col sm:flex-row gap-3">
          <input type="email" id="footer-nl-email" name="email" required autocomplete="email" placeholder="votre@email.fr" class="flex-1 bg-transparent border-b border-cream/25 py-2.5 text-cream placeholder:text-cream/40 focus:border-or focus:outline-none" />
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
          <button type="submit" id="footer-nl-btn" class="btn-or shrink-0 justify-center">
            M'inscrire
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        </div>
        <p id="footer-nl-msg" role="status" class="text-xs text-cream/40 mt-3">Gratuit, sans engagement. <a href="/newsletter" class="underline underline-offset-2 hover:text-or-light">En savoir plus</a>.</p>
      </form>
    </div>

    <!-- 3 colonnes minimalistes, beaucoup d'air -->
    <div class="grid md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-16 pb-16 border-t border-cream/10 pt-16">
      <div class="lg:col-span-4">
        <p class="font-serif text-2xl text-cream mb-3">{site.name}</p>
        <p class="text-sm leading-relaxed text-cream/60 max-w-sm">
          Conseil en gestion de patrimoine indépendant. {site.coverage}.
        </p>
      </div>

      <div class="lg:col-span-2">
        <p class="text-xs uppercase tracking-micro text-or-light mb-5">Naviguer</p>
        <ul class="space-y-3 text-sm">
          {nav.map((item) => (
            <li><a href={item.href} class="text-cream/70 hover:text-or-light transition-colors duration-300">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <p class="text-xs uppercase tracking-micro text-or-light mb-5">Ressources</p>
        <ul class="space-y-3 text-sm">
          {navSecondary.map((item) => (
            <li><a href={item.href} class="text-cream/70 hover:text-or-light transition-colors duration-300">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <p class="text-xs uppercase tracking-micro text-or-light mb-5">Contact</p>
        <ul class="space-y-3 text-sm">
          <li><a href={`tel:${site.phone.tel}`} class="text-cream/70 hover:text-or-light transition-colors duration-300">{site.phone.display}</a></li>
          <li><a href={`mailto:${site.email}`} class="text-cream/70 hover:text-or-light transition-colors duration-300">{site.email}</a></li>
          <li><a href={site.linkedin} target="_blank" rel="noopener" class="text-cream/70 hover:text-or-light transition-colors duration-300">LinkedIn</a></li>
          <li class="pt-3 text-cream/40 text-xs">{site.city}</li>
        </ul>
      </div>
    </div>

    <!-- Pied légal ultra discret -->
    <div class="flex flex-col md:flex-row justify-between gap-3 text-xs text-cream/40 pt-6">
      <p>© {year} {site.name} · ORIAS 25 00 00 16 · RCS Montpellier 929 887 594</p>
      <div class="flex gap-6">
        <a href="/mentions-legales" class="hover:text-or-light transition-colors">Mentions légales</a>
        <a href="/confidentialite" class="hover:text-or-light transition-colors">Confidentialité</a>
      </div>
    </div>
  </div>

  <script>
    const fnl = document.getElementById('footer-nl') as HTMLFormElement | null;
    if (fnl) {
      const msg = document.getElementById('footer-nl-msg') as HTMLElement;
      const btn = document.getElementById('footer-nl-btn') as HTMLButtonElement;
      const input = document.getElementById('footer-nl-email') as HTMLInputElement;
      fnl.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = input?.value.trim() || '';
        const website = (fnl.querySelector('input[name="website"]') as HTMLInputElement)?.value || '';
        if (!email) { msg.textContent = 'Merci de saisir votre email.'; msg.className = 'text-xs text-or-light mt-3'; return; }
        btn.disabled = true;
        const label = btn.innerHTML;
        btn.textContent = 'Envoi…';
        try {
          const r = await fetch('/api/newsletter', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, website }),
          });
          const data = await r.json().catch(() => ({}));
          if (r.ok && data.ok) {
            fnl.querySelector('div')?.remove();
            msg.innerHTML = 'Presque&nbsp;! Cliquez sur le lien de confirmation qu\'on vient de vous envoyer par email.';
            msg.className = 'text-sm text-cream mt-1';
          } else {
            msg.textContent = data.error === 'email_invalide' ? 'Cet email ne semble pas valide.' : 'Une erreur est survenue. Réessayez ou écrivez à camil.cz@lechenepatrimonial.com.';
            msg.className = 'text-xs text-or-light mt-3';
            btn.disabled = false; btn.innerHTML = label;
          }
        } catch {
          msg.textContent = 'Connexion impossible. Réessayez dans un instant.';
          msg.className = 'text-xs text-or-light mt-3';
          btn.disabled = false; btn.innerHTML = label;
        }
      });
    }
  </script>
</footer>
