---
const partners = [
  { name: 'Oddo BHF',        src: '/partners/oddo-bhf.svg' },
  { name: 'Nexity',          src: '/partners/nexity.svg' },
  { name: "Corum L'Épargne", src: '/partners/corum.svg' },
  { name: 'MMA',             src: '/partners/mma.jpg' },
  { name: 'Nortia',          src: '/partners/nortia.svg' },
  { name: 'Cogedim',         src: '/partners/cogedim.svg' },
  { name: 'Icade',           src: '/partners/icade.svg' },
  { name: 'MJ Développement', src: '/partners/mj-developpement.svg' },
  { name: 'April',           src: '/partners/april.svg' },
];

// Duplicate for a seamless CSS loop, no flex gap (causes drift with %-based translate)
const track = [...partners, ...partners];
---

<section class="partners-section border-y border-ink/10 bg-cream-soft overflow-hidden">
  <div class="shell py-6">
    <p class="eyebrow text-center text-ink/50 mb-5 flex items-center justify-center gap-3">
      <span class="inline-block h-px w-8 bg-chene/60"></span>
      Ils nous accompagnent au quotidien
      <span class="inline-block h-px w-8 bg-chene/60"></span>
    </p>
  </div>

  <div class="partners-marquee relative pb-8">
    <div class="partners-track flex items-center">
      {track.map((p, i) => (
        <div class="partners-cell shrink-0 px-8 md:px-12 flex items-center justify-center" aria-hidden={i >= partners.length ? 'true' : undefined}>
          <img
            src={p.src}
            alt={i >= partners.length ? '' : p.name}
            class="partners-logo h-8 md:h-10 w-auto max-w-[140px] md:max-w-[160px] object-contain"
            loading="eager"
            decoding="async"
          />
        </div>
      ))}
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-cream-soft to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-cream-soft to-transparent"></div>
  </div>
</section>

<style>
  .partners-marquee {
    width: 100%;
    overflow: hidden;
  }
  .partners-track {
    width: max-content;
    animation: partners-scroll 45s linear infinite;
    will-change: transform;
  }
  .partners-marquee:hover .partners-track {
    animation-play-state: paused;
  }
  .partners-logo {
    filter: grayscale(100%) opacity(0.55);
    transition: filter 240ms ease;
  }
  .partners-cell:hover .partners-logo {
    filter: grayscale(0%) opacity(1);
  }
  /* Translate exactly one full copy. The track contains 2 identical copies of N items,
     each item wrapped in a padded cell, so 50% is exact, with no gap drift. */
  @keyframes partners-scroll {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .partners-track { animation: none; }
  }
</style>
