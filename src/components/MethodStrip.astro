---
// Section "Notre méthode" : rend le service tangible et rassure sur le déroulé.
// Une vraie séquence en 4 temps, donc la numérotation porte du sens.
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const contactHref = localizePath('/contact', lang);
const etapes = [
  { t: t('method.step1.t'), d: t('method.step1.d') },
  { t: t('method.step2.t'), d: t('method.step2.d') },
  { t: t('method.step3.t'), d: t('method.step3.d') },
  { t: t('method.step4.t'), d: t('method.step4.d') },
];
---

<section class="py-24 md:py-36 bg-cream border-t border-ink/10">
  <div class="shell">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-end mb-16 md:mb-20">
      <div class="lg:col-span-7 reveal">
        <p class="ms-label mb-6">{t('method.label')}</p>
        <h2 class="font-serif text-ink leading-[0.98] text-[clamp(2.4rem,5vw,4rem)] tracking-tight">
          {t('method.title1')}<br/>{t('method.title2')}
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 reveal">
        <p class="text-ink/65 leading-relaxed">
          {t('method.intro')}
        </p>
      </div>
    </div>

    <ol class="border-t border-ink/15">
      {etapes.map((e, i) => (
        <li class="grid lg:grid-cols-12 gap-y-3 lg:gap-x-10 py-9 md:py-12 border-b border-ink/15 items-baseline reveal">
          <div class="lg:col-span-5 flex items-baseline gap-5">
            <span class="ms-num font-serif">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-serif text-ink text-[clamp(1.5rem,2.4vw,2.1rem)] leading-tight">{e.t}</h3>
          </div>
          <p class="lg:col-span-6 lg:col-start-7 text-ink/70 leading-relaxed max-w-prose-wide">{e.d}</p>
        </li>
      ))}
    </ol>

    <div class="mt-14 reveal">
      <a href={contactHref} class="group inline-flex items-baseline gap-3 font-serif text-ink text-xl md:text-2xl">
        <span class="ms-cta">{t('method.cta')}</span>
        <svg class="translate-y-0.5 transition-transform duration-300 group-hover:translate-x-1.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .ms-label {
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(45, 74, 51, 0.75);
    font-weight: 600;
  }
  .ms-num {
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: rgba(212, 168, 45, 0.9);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .ms-cta {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    padding-bottom: 2px;
  }
  .group:hover .ms-cta { background-size: 100% 1px; }
</style>
