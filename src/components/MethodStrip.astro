---
// Section "Notre méthode" : rend le service tangible et rassure sur le déroulé.
// Une vraie séquence en 4 temps, donc la numérotation porte du sens.
const etapes = [
  { t: 'Échange', d: 'Un premier rendez-vous de 30 minutes, offert et sans engagement, pour cerner votre situation et vos objectifs.' },
  { t: 'Diagnostic', d: 'Une lecture claire et chiffrée de votre patrimoine, de votre fiscalité et de vos angles morts.' },
  { t: 'Stratégie', d: 'Une feuille de route sur-mesure et indépendante, hiérarchisée et réellement actionnable.' },
  { t: 'Accompagnement', d: 'Un suivi dans la durée, ajusté au fil de votre vie et des évolutions réglementaires.' },
];
---

<section class="py-24 md:py-32 bg-cream relative">
  <div class="absolute top-0 left-0 right-0 h-px bg-ink/8"></div>
  <div class="shell">
    <div class="max-w-2xl mb-16 reveal">
      <p class="eyebrow mb-5 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Notre méthode
      </p>
      <h2 class="font-serif text-display-sm text-ink mb-5 leading-tight">Une méthode claire, en quatre temps.</h2>
      <p class="text-lg text-ink/70 leading-relaxed">
        Pas de boîte noire, pas de jargon. Vous savez à chaque étape où vous en êtes et ce qui vient ensuite.
      </p>
    </div>

    <ol class="grid gap-y-12 md:grid-cols-4 md:gap-8 relative">
      <!-- Filet horizontal reliant les étapes (desktop) -->
      <div aria-hidden="true" class="hidden md:block absolute left-0 right-0 top-[22px] h-px bg-ink/12"></div>

      {etapes.map((e, i) => (
        <li class="relative reveal" style={`transition-delay:${i * 90}ms`}>
          <div class="flex items-center gap-4 mb-5 md:mb-6">
            <span class="relative z-10 flex-none w-11 h-11 rounded-full bg-navy text-or-light grid place-items-center font-serif text-lg">
              {i + 1}
            </span>
            <span class="md:hidden font-serif text-xl text-ink">{e.t}</span>
          </div>
          <h3 class="hidden md:block font-serif text-xl text-ink mb-2">{e.t}</h3>
          <p class="text-ink/65 text-[0.95rem] leading-relaxed md:pr-4">{e.d}</p>
        </li>
      ))}
    </ol>

    <div class="mt-16 reveal">
      <a href="/contact" class="btn-primary">
        Réserver mon premier échange
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
