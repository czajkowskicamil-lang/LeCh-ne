---
// Trois vrais avis clients sur l'accueil (source unique : src/data/temoignages.ts).
// On choisit des avis qui parlent de la méthode, pas d'un produit.
import { temoignages } from '../data/temoignages';
import { getLangFromUrl, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const avisHref = localizePath('/avis', lang);
const choix = ['Temenuzhka Nikolova', 'Véronique P.', 'Lucia M'];
const items = choix
  .map((a) => temoignages.find((x) => x.author === a))
  .filter((x): x is NonNullable<typeof x> => Boolean(x));

const txt = lang === 'en'
  ? { eyebrow: 'They trusted me', t1: 'In my', t2: "clients' words.", all: `Read all ${temoignages.length} reviews →` }
  : { eyebrow: 'Ils m’ont fait confiance', t1: 'Paroles de', t2: 'clients.', all: `Lire les ${temoignages.length} avis →` };
---

{items.length > 0 && (
<section class="py-24 md:py-32 bg-cream-deep relative overflow-hidden">
  <div class="shell">
    <div class="max-w-2xl mb-16 reveal">
      <p class="eyebrow mb-5 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        {txt.eyebrow}
      </p>
      <h2 class="font-serif text-display text-ink">
        {txt.t1}{' '}<span class="italic text-chene">{txt.t2}</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {items.map((t, i) => (
        <figure class="bg-cream p-8 md:p-10 border border-ink/5 flex flex-col h-full reveal" style={`animation-delay:${i * 100}ms`}>
          <svg class="text-or mb-6" width="28" height="20" viewBox="0 0 28 20" fill="currentColor" aria-hidden="true"><path d="M0 20V12C0 5.4 3.8 0.8 10 0L11 3C7.4 4 5.4 6.2 5 9H9V20H0ZM17 20V12C17 5.4 20.8 0.8 27 0L28 3C24.4 4 22.4 6.2 22 9H26V20H17Z"/></svg>
          <blockquote class="font-serif text-lg leading-snug text-ink flex-1">{t.quote}</blockquote>
          <figcaption class="mt-8 pt-6 border-t border-ink/10">
            <p class="font-medium text-ink">{t.author}</p>
            {t.role && <p class="text-sm text-stone mt-1">{t.role}</p>}
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-12 reveal">
      <a href={avisHref} class="link-underline text-chene font-medium">{txt.all}</a>
    </div>
  </div>
</section>
)}
