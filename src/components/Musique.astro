---
/* Générique du Chêne : le lounge feutré, 10 secondes, une seule fois par visite, au premier geste du visiteur sur la
   page où il arrive (accueil, lien LinkedIn ou Instagram, article), puis plus rien pendant sa navigation. Joué depuis un vrai fichier audio : il passe dans tous les navigateurs, y compris
   ceux de LinkedIn et Instagram, et sur iPhone même en mode silencieux. Les navigateurs interdisent tout son avant un
   geste du visiteur : il part donc au premier toucher. Le visiteur le coupe d'un clic, et son choix vaut pour la visite (aucun traceur). */
---
<div class="lc-musique-zone" transition:persist="lc-musique">
  <audio id="lc-musique-son" src="/sons/chene-ouverture.m4a" preload="auto" playsinline></audio>
  <button id="lc-musique" class="lc-musique" type="button" aria-pressed="false" title="Musique">
    <span class="lc-musique-note" aria-hidden="true">♪</span><span class="lc-musique-txt">Musique</span>
  </button>
</div>

<script>
  const son = () => document.getElementById('lc-musique-son') as HTMLAudioElement | null;
  // Le choix « couper » vaut pour la visite en cours seulement : au retour, le générique revient.
  const lire = (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } };
  const ecrire = (k: string, v: string) => { try { sessionStorage.setItem(k, v); } catch { /* */ } };
  const refusee = () => lire('chene_musique') === '0';
  try { localStorage.removeItem('chene_musique'); } catch { /* ancien réglage permanent, abandonné */ }
  // Une seule fois par visite : au premier geste sur la page d'arrivée, puis plus jamais pendant la navigation.
  const dejaJouee = () => lire('chene_musique_jouee') === '1';

  function afficher() {
    const b = document.getElementById('lc-musique'), a = son(); if (!b || !a) return;
    const joue = !a.paused && !a.ended;
    b.setAttribute('aria-pressed', String(joue));
    b.classList.toggle('actif', joue);
    b.querySelector('.lc-musique-txt')!.textContent = joue ? 'Couper la musique' : 'Musique';
  }
  function jouer() {
    const a = son(); if (!a || (!a.paused && !a.ended)) return;
    a.currentTime = 0;
    a.play().then(() => { ecrire('chene_musique_jouee', '1'); retirer(); }).catch(() => { /* bloqué : le prochain geste réessaie */ });
  }
  function couper() { const a = son(); if (!a) return; a.pause(); ecrire('chene_musique', '0'); }

  const GESTES = ['pointerdown', 'touchend', 'click', 'keydown'];
  const retirer = () => GESTES.forEach((g) => window.removeEventListener(g, geste, true));
  function geste(ev: Event) {
    if ((ev.target as Element | null)?.closest?.('#lc-musique')) return; // le bouton gère lui-même
    if (refusee() || dejaJouee()) return retirer();
    jouer();
  }
  if (!refusee() && !dejaJouee()) GESTES.forEach((g) => window.addEventListener(g, geste, true));

  document.getElementById('lc-musique')?.addEventListener('click', () => {
    const a = son(); if (!a) return;
    if (!a.paused && !a.ended) couper(); else { ecrire('chene_musique', '1'); jouer(); }
  });
  const a0 = son();
  ['play', 'pause', 'ended'].forEach((e) => a0?.addEventListener(e, afficher));
  document.addEventListener('astro:page-load', afficher);
  afficher();
</script>

<style>
  .lc-musique {
    position: fixed; left: 22px; bottom: 22px; z-index: 55;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px; border-radius: 999px;
    font: 500 12px/1 'Inter Variable', Inter, system-ui, sans-serif; letter-spacing: .02em;
    color: rgba(242, 237, 228, .72);
    background: color-mix(in srgb, #11151F 78%, transparent);
    border: 1px solid rgba(242, 237, 228, .14);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    transition: color .3s, border-color .3s, background .3s;
    cursor: pointer;
  }
  .lc-musique:hover { color: #F2EDE4; border-color: rgba(201, 165, 92, .5); }
  .lc-musique.actif { color: #E0C68F; border-color: rgba(201, 165, 92, .7); background: color-mix(in srgb, #C9A55C 14%, #11151F); }
  .lc-musique.actif .lc-musique-note { animation: lc-pulse 1.03s ease-in-out infinite; }
  @keyframes lc-pulse { 50% { opacity: .35; } }
  @media (max-width: 767px) {
    .lc-musique { left: 14px; bottom: calc(78px + env(safe-area-inset-bottom)); padding: 7px 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .lc-musique.actif .lc-musique-note { animation: none; } }
</style>
