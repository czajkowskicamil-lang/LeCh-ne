---
/* Musique d'ouverture du site : le lounge feutré du Chêne, 10 secondes au premier clic (pas plus : le visiteur ne doit jamais s'en lasser) du visiteur, puis le silence.
   Une fois par visite (elle continue d'une page à l'autre grâce aux transitions). Les navigateurs interdisent tout
   son avant un geste du visiteur. Le visiteur la coupe d'un clic, et son choix est retenu (préférence locale,
   aucun traceur). */
---
<button id="lc-musique" class="lc-musique" type="button" aria-pressed="false" title="Musique" transition:persist>
  <span class="lc-musique-note" aria-hidden="true">♪</span><span class="lc-musique-txt">Musique</span>
</button>

<script>
  import { construire, jouerOuverture, type Chaine } from '../scripts/musique';

  type Etat = { ctx: AudioContext; chaine: Chaine; fin: number };
  const VOLUME = 0.26;
  const DUREE = 10; // secondes, son compris : au-delà, ça lasse
  let etat: Etat | null = null;
  const lire = (k: string, s: Storage | undefined) => { try { return s?.getItem(k); } catch { return null; } };
  const ecrire = (k: string, v: string, s: Storage | undefined) => { try { s?.setItem(k, v); } catch { /* */ } };
  const refusee = () => lire('chene_musique', localStorage) === '0';
  const dejaJouee = () => lire('chene_musique_jouee', sessionStorage) === '1';

  function afficher() {
    const b = document.getElementById('lc-musique'); if (!b) return;
    b.setAttribute('aria-pressed', String(!!etat));
    b.classList.toggle('actif', !!etat);
    b.querySelector('.lc-musique-txt')!.textContent = etat ? 'Couper la musique' : dejaJouee() ? 'Réécouter' : 'Musique';
  }
  function eteindre(e: Etat) {
    clearTimeout(e.fin); setTimeout(() => e.ctx.close().catch(() => {}), 1500);
    if (etat === e) { etat = null; afficher(); }
  }
  function lancer() {
    if (etat) return;
    // iPhone : joue même si le bouton silencieux est activé (Safari 17 et plus).
    try { const n = navigator as Navigator & { audioSession?: { type: string } }; if (n.audioSession) n.audioSession.type = 'playback'; } catch { /* */ }
    const ctx = new AudioContext();
    if (ctx.state !== 'running') ctx.resume().catch(() => {});
    const chaine = construire(ctx, ctx.destination, 0);
    jouerOuverture(chaine, ctx.currentTime + 0.1, VOLUME, DUREE, 8);
    const e: Etat = { ctx, chaine, fin: 0 };
    e.fin = window.setTimeout(() => eteindre(e), (DUREE + 2) * 1000);
    etat = e;
    ecrire('chene_musique', '1', localStorage); ecrire('chene_musique_jouee', '1', sessionStorage);
    afficher();
  }
  function couper() {
    const e = etat; if (!e) return;
    const g = e.chaine.maitre.gain, t = e.ctx.currentTime;
    g.cancelScheduledValues(t); g.setValueAtTime(g.value, t); g.linearRampToValueAtTime(0, t + 1);
    eteindre(e);
    ecrire('chene_musique', '0', localStorage);
  }

  // Premier geste du visiteur sur le site : l'ouverture, une fois par visite. Safari (iPhone, Mac) ne débloque le son
  // qu'à la fin d'un toucher ou sur un clic : on écoute tous ces gestes et on relance tant que le son est bloqué.
  const GESTES = ['pointerdown', 'touchend', 'click', 'keydown'];
  const retirer = () => GESTES.forEach((g) => window.removeEventListener(g, premierGeste, true));
  function premierGeste(ev: Event) {
    if ((ev.target as Element | null)?.closest?.('#lc-musique')) return; // le bouton gère lui-même
    if (!etat) { if (refusee() || dejaJouee()) return retirer(); lancer(); }
    else if (etat.ctx.state !== 'running') etat.ctx.resume().catch(() => {});
    if (etat?.ctx.state === 'running') retirer();
  }
  if (!refusee() && !dejaJouee()) GESTES.forEach((g) => window.addEventListener(g, premierGeste, true));

  document.getElementById('lc-musique')?.addEventListener('click', () => (etat ? couper() : lancer()));
  afficher();
  document.addEventListener('astro:page-load', afficher);
</script>

<style>
  .lc-musique {
    position: fixed; left: 22px; bottom: 22px; z-index: 55;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px; border-radius: 999px;
    font: 500 12px/1 'Inter Variable', Inter, system-ui, sans-serif; letter-spacing: .02em;
    color: rgba(242, 237, 228, .72);
    background: color-mix(in srgb, #11151F 78%, transparent);
    border: 1px solid rgba(242, 237, 228, .14);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    transition: color .3s, border-color .3s, background .3s;
    cursor: pointer;
  }
  .lc-musique:hover { color: #F2EDE4; border-color: rgba(201, 165, 92, .5); }
  .lc-musique.actif { color: #E0C68F; border-color: rgba(201, 165, 92, .7); background: color-mix(in srgb, #C9A55C 14%, #11151F); }
  .lc-musique.actif .lc-musique-note { animation: lc-pulse 1.03s ease-in-out infinite; }
  @keyframes lc-pulse { 50% { opacity: .35; } }
  @media (max-width: 767px) {
    .lc-musique { left: 14px; bottom: calc(78px + env(safe-area-inset-bottom)); padding: 7px 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .lc-musique.actif .lc-musique-note { animation: none; } }
</style>
