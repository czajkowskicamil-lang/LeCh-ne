---
import { site } from '../data/site';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
interface Props {
  title?: string;
  body?: string;
}
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const contactHref = localizePath('/contact', lang);
const newsletterHref = localizePath('/newsletter', lang);
// Défauts localisés ; une page peut toujours passer un title/body explicite.
const { title = t('cta.title'), body = t('cta.body') } = Astro.props;
---

<section class="py-24 md:py-32 bg-navy-deep text-cream relative overflow-hidden">

  <div class="shell relative grid lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-8 reveal">
      <p class="eyebrow-cream mb-5 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-or"></span>
        {t('cta.eyebrow')}
      </p>
      <h2 class="font-serif text-display text-cream">
        {title}
      </h2>
    </div>
    <div class="lg:col-span-4 reveal" style="animation-delay:120ms">
      <p class="text-cream/75 leading-relaxed mb-8">{body}</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href={site.calendly} target="_blank" rel="noopener" class="btn-or">
          {t('cta.rdv')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href={contactHref} class="btn-ghost-cream">{t('cta.write')}</a>
      </div>
      <p class="mt-6 text-xs text-cream/60">
        {t('cta.orReceivePre')} <a href={newsletterHref} class="text-or-light underline underline-offset-2 hover:text-or">{t('nlt.eyebrow')}</a> {t('cta.orReceivePost')}
      </p>
    </div>
  </div>
</section>
