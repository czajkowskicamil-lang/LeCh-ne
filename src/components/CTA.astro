---
import { site } from '../data/site';
interface Props {
  title?: string;
  body?: string;
}
const {
  title = "Un patrimoine se construit comme une saison de haut niveau.",
  body = "Planifions un premier échange de 30 minutes. Sans engagement, sans jargon, juste une conversation claire sur ce qui compte pour vous.",
} = Astro.props;
---

<section class="py-24 md:py-32 bg-navy-deep text-cream relative overflow-hidden">
  <!-- Logo Le Chêne en watermark sobre (or natif sur fond navy = élégant) -->
  <img
    src="/logo.png"
    alt=""
    aria-hidden="true"
    data-parallax="0.1"
    class="pointer-events-none select-none absolute -right-16 -bottom-24 w-[480px] h-[480px] object-contain opacity-[0.15]"
  />

  <div class="shell relative grid lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-8 reveal">
      <p class="eyebrow-cream mb-5 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-or"></span>
        Commencer ensemble
      </p>
      <h2 class="font-serif text-display text-cream">
        {title}
      </h2>
    </div>
    <div class="lg:col-span-4 reveal" style="animation-delay:120ms">
      <p class="text-cream/75 leading-relaxed mb-8">{body}</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href={site.calendly} target="_blank" rel="noopener" class="btn-or">
          Prendre rendez-vous
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/contact" class="btn-ghost-cream">Écrire un message</a>
      </div>
      <p class="mt-6 text-xs text-cream/60">
        Ou recevoir <a href="/newsletter" class="text-or-light underline underline-offset-2 hover:text-or">La Lettre du Chêne</a> chaque mois.
      </p>
    </div>
  </div>
</section>
