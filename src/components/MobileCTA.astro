---
// Barre d'action permanente sur mobile : le geste de conversion le plus rentable.
// Masquée sur desktop (le bouton "Prendre rendez-vous" est déjà dans l'en-tête).
import { site } from '../data/site';
const waHref = `https://wa.me/${site.phone.tel.replace(/\D/g, '')}`;
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const rdvHref = localizePath('/rendez-vous', getLangFromUrl(Astro.url));
---

{!/\/rendez-vous\/?$/.test(Astro.url.pathname) && (
<div class="mobile-cta md:hidden" aria-hidden="false">
  <a
    href={rdvHref}
    class="mobile-cta-btn"
  >
    {t('nav.rdv')}
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </a>
  <a href={waHref} target="_blank" rel="noopener" class="mobile-wa" aria-label="WhatsApp">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
  </a>
</div>
)}

<!-- WhatsApp flottant (ordinateur) : gros, visible, direct sur le numéro -->
<a href={waHref} target="_blank" rel="noopener" class="wa-float" aria-label="Écrire à Camil sur WhatsApp">
  <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
  <span class="wa-float-label">WhatsApp</span>
</a>

<style>
  .wa-float { display: none; }
  @media (min-width: 768px) {
    .wa-float {
      position: fixed; left: 24px; bottom: 24px; z-index: 45;
      display: flex; align-items: center; gap: 10px;
      height: 62px; padding: 0 22px 0 16px; border-radius: 999px;
      background: #25D366; color: #fff; font-weight: 600; font-size: 15px;
      box-shadow: 0 14px 34px -12px rgba(37,211,102,.75);
      transition: transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s;
    }
    .wa-float:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 18px 40px -12px rgba(37,211,102,.9); }
    .wa-float::after { content: ''; position: absolute; inset: 0; border-radius: 999px; border: 2px solid #25D366; animation: wa-ping 2.6s cubic-bezier(.16,1,.3,1) infinite; pointer-events: none; }
  }
  @keyframes wa-ping { 0% { transform: scale(1); opacity: .7; } 80%, 100% { transform: scale(1.35); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .wa-float::after { animation: none; } }

  .mobile-cta {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 45;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    background: color-mix(in srgb, #F5F1E8 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid rgba(3, 16, 46, 0.08);
  }
  .mobile-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 15px 20px;
    border-radius: 0;
    background: #03102E;
    color: #F5F1E8;
    font-family: inherit;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
    box-shadow: 0 6px 20px -10px rgba(3, 16, 46, 0.5);
    transition: background 0.3s var(--ease-apple, ease);
  }
  .mobile-cta-btn:hover { background: #2D4A33; }
  @media (max-width: 767px) { .mobile-cta { display: flex; gap: 10px; align-items: center; } }
  .mobile-cta-btn { flex: 1; }
  .mobile-wa { flex: none; width: 54px; height: 54px; border-radius: 999px; display: grid; place-items: center;
    background: #25D366; color: #fff; box-shadow: 0 8px 22px -8px rgba(37,211,102,.7); }

  /* Évite que la barre ne masque le bas du contenu (pied de page). */
  @media (max-width: 767px) {
    :global(body) { padding-bottom: 76px; }
  }
</style>
