---
// Questionnaire de recherche Le Faitage.
//
// Une question par écran, des réponses en cartes cliquables, un parcours qui
// s'adapte au projet déclaré. À la fin seulement, on demande les coordonnées :
// le visiteur a déjà investi quelques clics, il va au bout.
//
// Le parcours reste strictement immobilier (achat, location, fiscalité
// immobilière). Aucune question sur des placements financiers : le cabinet est
// COA et carte T, pas CIF.
---

<section
  id="questionnaire"
  class="relative py-16 md:py-24 bg-navy-deep text-cream overflow-hidden scroll-mt-20"
>
  <!-- Halo kaki discret, pour que le bloc ne soit pas un aplat mort -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.55]"
    style="background:radial-gradient(120% 80% at 15% 0%, rgba(120,133,64,.38), transparent 62%), radial-gradient(90% 70% at 100% 100%, rgba(212,168,45,.14), transparent 60%)"
  >
  </div>

  <div class="shell relative">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <p class="eyebrow-cream mb-4 flex items-center justify-center gap-3">
          <span class="inline-block h-px w-8 bg-or"></span>
          Deux minutes, quelques questions
          <span class="inline-block h-px w-8 bg-or"></span>
        </p>
        <h2 class="font-serif text-3xl md:text-4xl text-cream">
          Dites-nous ce que vous <span class="italic text-or-light">cherchez</span>
        </h2>
        <p class="text-cream/75 leading-relaxed mt-3 max-w-xl mx-auto">
          Pas de catalogue à éplucher. Vous décrivez votre projet, on vous
          répond avec ce qui correspond vraiment.
        </p>
      </div>

      <div class="bg-white/[0.045] border border-cream/15 backdrop-blur-sm">
        <!-- Progression -->
        <div class="h-[3px] bg-cream/10">
          <div
            id="q-barre"
            class="h-full bg-or transition-[width] duration-500 ease-out"
            style="width:0%"
          >
          </div>
        </div>

        <div class="p-6 sm:p-10">
          <div class="flex items-center justify-between mb-7 min-h-[24px]">
            <button
              id="q-retour"
              type="button"
              class="hidden items-center gap-1.5 text-sm text-cream/60 hover:text-or-light transition-colors"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
              Retour
            </button>
            <span id="q-etape" class="ml-auto text-xs uppercase tracking-micro text-or-light/80"
            ></span>
          </div>

          <div id="q-zone" aria-live="polite"></div>

          <noscript>
            <p class="text-cream/75 leading-relaxed">
              Ce questionnaire a besoin de JavaScript.
              <a href="/contact" class="text-or-light font-medium underline underline-offset-4"
                >Écrivez-nous directement</a
              >, on vous répond aussi bien.
            </p>
          </noscript>
        </div>
      </div>

      <p class="text-xs text-cream/55 leading-relaxed mt-5 text-center max-w-xl mx-auto">
        Vos réponses servent uniquement à préparer notre réponse. Aucune donnée
        n'est revendue, aucun appel automatisé. Vous pouvez demander leur
        suppression à tout moment.
      </p>
    </div>
  </div>
</section>

<script>
  type Option = { v: string; desc?: string; suivant?: string };
  type Question = {
    titre: string;
    aide?: string;
    type: 'choix' | 'texte' | 'fin';
    label?: string;
    options?: Option[];
    placeholder?: string;
    facultatif?: boolean;
    suivant?: string;
  };

  // Le parcours. Chaque option peut rediriger vers une branche précise ;
  // sinon on suit le `suivant` de la question.
  const Q: Record<string, Question> = {
    projet: {
      titre: 'Votre projet, c’est plutôt…',
      type: 'choix',
      options: [
        { v: 'Investir dans l’immobilier locatif', desc: 'Faire travailler mon épargne, me constituer des revenus', suivant: 'inv_budget' },
        { v: 'Acheter ma résidence principale', desc: 'Le logement dans lequel je vais vivre', suivant: 'rp_ville' },
        { v: 'Réduire mes impôts', desc: 'Utiliser l’immobilier pour alléger ma fiscalité', suivant: 'fisc_tmi' },
        { v: 'Je ne sais pas encore', desc: 'J’explore, j’aimerais qu’on m’oriente', suivant: 'situation' },
      ],
    },

    // ---------- Investissement locatif ----------
    inv_budget: {
      titre: 'Quel budget avez-vous en tête ?',
      aide: 'Une fourchette suffit, rien n’est figé.',
      type: 'choix',
      options: [
        { v: 'Moins de 80 000 €' },
        { v: '80 000 à 150 000 €' },
        { v: '150 000 à 300 000 €' },
        { v: 'Plus de 300 000 €' },
      ],
      suivant: 'inv_priorite',
    },
    inv_priorite: {
      titre: 'Qu’est-ce qui compte le plus pour vous ?',
      type: 'choix',
      options: [
        { v: 'Le rendement', desc: 'Maximiser le loyer par rapport au prix' },
        { v: 'Ne rien avoir à gérer', desc: 'Un exploitant s’occupe de tout' },
        { v: 'La sécurité du loyer', desc: 'Un bail solide, un exploitant fiable' },
        { v: 'L’emplacement', desc: 'Une ville et un quartier qui tiennent dans le temps' },
      ],
      suivant: 'inv_type',
    },
    inv_type: {
      titre: 'Un type de bien en particulier ?',
      aide: 'Si vous ne savez pas, dites-le, c’est précisément notre travail.',
      type: 'choix',
      options: [
        { v: 'LMNP en résidence gérée', desc: 'Étudiante, tourisme ou senior, loyer par bail commercial' },
        { v: 'Nue-propriété', desc: 'Les murs à prix décoté, sans gestion ni fiscalité pendant l’usufruit' },
        { v: 'Immobilier neuf', desc: 'VEFA, frais de notaire réduits, garanties du neuf' },
        { v: 'Je ne sais pas encore', desc: 'Orientez-moi selon ma situation' },
      ],
      suivant: 'inv_financement',
    },
    inv_financement: {
      titre: 'Comment comptez-vous financer ?',
      type: 'choix',
      options: [
        { v: 'À crédit' },
        { v: 'Comptant' },
        { v: 'Un peu des deux' },
        { v: 'À étudier ensemble' },
      ],
      suivant: 'situation',
    },

    // ---------- Résidence principale ----------
    rp_ville: {
      titre: 'Dans quelle ville, ou quel secteur ?',
      type: 'texte',
      label: 'Ville ou secteur recherché',
      placeholder: 'Montpellier, alentours de Lyon, bord de mer…',
      suivant: 'rp_budget',
    },
    rp_budget: {
      titre: 'Quel budget pour ce logement ?',
      aide: 'Prix d’achat envisagé, hors frais de notaire.',
      type: 'choix',
      options: [
        { v: 'Moins de 200 000 €' },
        { v: '200 000 à 350 000 €' },
        { v: '350 000 à 500 000 €' },
        { v: 'Plus de 500 000 €' },
      ],
      suivant: 'rp_typologie',
    },
    rp_typologie: {
      titre: 'Combien de pièces vous faut-il ?',
      type: 'choix',
      options: [
        { v: 'T1 ou T2' },
        { v: 'T3' },
        { v: 'T4' },
        { v: 'T5 ou plus' },
      ],
      suivant: 'rp_surface',
    },
    rp_surface: {
      titre: 'Quelle surface visez-vous ?',
      type: 'texte',
      label: 'Surface souhaitée',
      placeholder: 'Environ 70 m², ou 60 m² minimum…',
      facultatif: true,
      suivant: 'rp_etage',
    },
    rp_etage: {
      titre: 'Une préférence sur l’étage ?',
      type: 'choix',
      options: [
        { v: 'Rez-de-chaussée avec extérieur', desc: 'Jardin ou grande terrasse' },
        { v: 'Étage intermédiaire' },
        { v: 'Dernier étage', desc: 'Vue dégagée, pas de voisin au-dessus' },
        { v: 'Peu importe' },
      ],
      suivant: 'rp_neuf',
    },
    rp_neuf: {
      titre: 'Neuf ou ancien ?',
      type: 'choix',
      options: [
        { v: 'Neuf', desc: 'Frais de notaire réduits, rien à refaire' },
        { v: 'Ancien', desc: 'Plus de charme, plus de choix d’emplacement' },
        { v: 'Les deux m’intéressent' },
      ],
      suivant: 'situation',
    },

    // ---------- Fiscalité ----------
    fisc_tmi: {
      titre: 'Dans quelle tranche d’imposition êtes-vous ?',
      aide: 'C’est le taux qui s’applique à la dernière partie de vos revenus. Si vous ne savez pas, ce n’est pas grave.',
      type: 'choix',
      options: [
        { v: '11 %' },
        { v: '30 %' },
        { v: '41 %' },
        { v: '45 %' },
      ],
      suivant: 'fisc_montant',
    },
    fisc_montant: {
      titre: 'Combien payez-vous d’impôt par an, environ ?',
      type: 'choix',
      options: [
        { v: 'Moins de 3 000 €' },
        { v: '3 000 à 8 000 €' },
        { v: '8 000 à 15 000 €' },
        { v: 'Plus de 15 000 €' },
      ],
      suivant: 'fisc_objectif',
    },
    fisc_objectif: {
      titre: 'Votre objectif principal ?',
      type: 'choix',
      options: [
        { v: 'Payer moins d’impôt sur le revenu' },
        { v: 'Me constituer un patrimoine en même temps' },
        { v: 'Préparer ma retraite' },
        { v: 'Transmettre à mes enfants' },
      ],
      suivant: 'situation',
    },

    // ---------- Commun ----------
    situation: {
      titre: 'Votre situation professionnelle ?',
      aide: 'Elle change beaucoup de choses : fiscalité, capacité d’emprunt, horizon.',
      type: 'choix',
      options: [
        { v: 'Salarié' },
        { v: 'Dirigeant d’entreprise' },
        { v: 'Profession libérale ou indépendant' },
        { v: 'Sportif de haut niveau' },
        { v: 'Retraité' },
        { v: 'Autre' },
      ],
      suivant: 'horizon',
    },
    horizon: {
      titre: 'À quelle échéance ?',
      type: 'choix',
      options: [
        { v: 'Dès maintenant', desc: 'Le projet est prêt' },
        { v: 'Dans 3 à 6 mois' },
        { v: 'Dans 6 à 12 mois' },
        { v: 'Je me renseigne', desc: 'Pas de calendrier arrêté' },
      ],
      suivant: 'fin',
    },
    fin: { titre: 'Où peut-on vous répondre ?', type: 'fin' },
  };

  const zone = document.getElementById('q-zone');
  if (zone) {
    const barre = document.getElementById('q-barre') as HTMLElement;
    const retour = document.getElementById('q-retour') as HTMLButtonElement;
    const compteur = document.getElementById('q-etape') as HTMLElement;

    const reponses: { cle: string; label: string; value: string }[] = [];
    const pile: string[] = [];
    let courante = 'projet';

    // Chaque branche a sa longueur : le compteur doit dire vrai, sinon il
    // décourage au lieu de rassurer. Clé = première question de la branche.
    const LONGUEURS: Record<string, number> = {
      inv_budget: 7, // projet + 4 questions + situation + horizon
      rp_ville: 9, // projet + 6 questions + situation + horizon
      fisc_tmi: 6, // projet + 3 questions + situation + horizon
      situation: 3, // projet + situation + horizon
    };
    let total = 7;

    const echappe = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    function enregistrer(cle: string, label: string, value: string) {
      const i = reponses.findIndex((r) => r.cle === cle);
      const item = { cle, label, value };
      if (i >= 0) reponses.splice(i, 1, item);
      else reponses.push(item);
    }

    function aller(cle: string) {
      // Le choix du projet détermine la longueur réelle du parcours.
      if (courante === 'projet' && LONGUEURS[cle]) total = LONGUEURS[cle];
      pile.push(courante);
      courante = cle;
      rendre();
    }

    function progression() {
      const fait = Math.min(pile.length, total);
      barre.style.width = `${Math.round((fait / total) * 100)}%`;
      compteur.textContent =
        courante === 'fin' ? 'Dernière étape' : `Étape ${Math.min(pile.length + 1, total)} sur ${total}`;
      retour.classList.toggle('hidden', pile.length === 0);
      retour.classList.toggle('inline-flex', pile.length > 0);
    }

    function rendre() {
      const q = Q[courante];
      progression();

      if (q.type === 'fin') return rendreFin(q);

      const aide = q.aide ? `<p class="text-[0.95rem] text-cream/65 leading-relaxed mt-2">${echappe(q.aide)}</p>` : '';

      if (q.type === 'texte') {
        zone!.innerHTML = `
          <h3 class="font-serif text-2xl md:text-[1.75rem] text-cream leading-snug">${echappe(q.titre)}</h3>
          ${aide}
          <div class="mt-7">
            <label for="q-texte" class="sr-only">${echappe(q.label ?? q.titre)}</label>
            <input id="q-texte" type="text" placeholder="${echappe(q.placeholder ?? '')}" class="q-champ w-full" />
            <div class="flex items-center gap-4 mt-5">
              <button id="q-suite" type="button" class="btn-or inline-flex items-center gap-2">
                Continuer
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </button>
              ${q.facultatif ? '<button id="q-passer" type="button" class="text-sm text-cream/60 hover:text-or-light transition-colors underline underline-offset-4">Passer</button>' : ''}
            </div>
          </div>`;

        const champ = document.getElementById('q-texte') as HTMLInputElement;
        const valider = () => {
          const v = champ.value.trim();
          if (!v && !q.facultatif) {
            champ.focus();
            return;
          }
          if (v) enregistrer(courante, q.label ?? q.titre, v);
          aller(q.suivant!);
        };
        document.getElementById('q-suite')!.addEventListener('click', valider);
        champ.addEventListener('keydown', (e) => {
          if ((e as KeyboardEvent).key === 'Enter') valider();
        });
        document.getElementById('q-passer')?.addEventListener('click', () => aller(q.suivant!));
        champ.focus();
        return;
      }

      // Question à choix.
      const cartes = q
        .options!.map(
          (o, i) => `
          <button type="button" data-i="${i}"
            class="q-choix group w-full text-left border border-cream/15 bg-cream/[0.04] hover:border-or hover:bg-cream/[0.09] transition-colors px-5 py-4 flex items-start gap-4">
            <span class="mt-[3px] h-4 w-4 shrink-0 rounded-full border border-cream/35 group-hover:border-or group-hover:border-[5px] transition-all"></span>
            <span>
              <span class="block text-[15.5px] font-medium text-cream leading-snug">${echappe(o.v)}</span>
              ${o.desc ? `<span class="block text-[13.5px] text-cream/60 mt-0.5 leading-relaxed">${echappe(o.desc)}</span>` : ''}
            </span>
          </button>`
        )
        .join('');

      zone!.innerHTML = `
        <h3 class="font-serif text-2xl md:text-[1.75rem] text-cream leading-snug">${echappe(q.titre)}</h3>
        ${aide}
        <div class="grid gap-2.5 mt-7">${cartes}</div>`;

      zone!.querySelectorAll<HTMLElement>('.q-choix').forEach((b) => {
        b.addEventListener('click', () => {
          const o = q.options![Number(b.dataset.i)];
          enregistrer(courante, q.titre, o.v);
          aller(o.suivant ?? q.suivant!);
        });
      });
    }

    function rendreFin(q: Question) {
      const projet = reponses.find((r) => r.cle === 'projet')?.value ?? 'Non précisé';
      const recap = reponses
        .map(
          (r) =>
            `<div class="flex items-baseline justify-between gap-4 py-2 border-b border-cream/10 last:border-0">
               <span class="text-[13px] text-cream/60">${echappe(r.label)}</span>
               <span class="text-[13.5px] font-medium text-cream text-right">${echappe(r.value)}</span>
             </div>`
        )
        .join('');

      zone!.innerHTML = `
        <h3 class="font-serif text-2xl md:text-[1.75rem] text-cream leading-snug">${echappe(q.titre)}</h3>
        <p class="text-[0.95rem] text-cream/65 leading-relaxed mt-2">
          On vous répond sous 24 heures ouvrées, par une personne qui aura lu vos réponses.
        </p>

        <form id="q-form" class="mt-7 grid gap-3" novalidate>
          <div class="grid sm:grid-cols-2 gap-3">
            <input name="prenom" type="text" required placeholder="Prénom" class="q-champ" />
            <input name="nom" type="text" placeholder="Nom" class="q-champ" />
          </div>
          <input name="email" type="email" required placeholder="Adresse email" class="q-champ" />
          <input name="telephone" type="tel" placeholder="Téléphone (facultatif)" class="q-champ" />
          <input name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

          <label class="flex gap-2.5 items-start text-[12.5px] text-cream/65 leading-relaxed mt-1">
            <input name="consent" type="checkbox" class="mt-0.5 w-4 h-4 shrink-0 accent-[#D4A82D]" />
            <span>J’accepte d’être recontacté au sujet de cette recherche. Mes données ne sont ni revendues ni cédées, et je peux demander leur suppression à tout moment.</span>
          </label>
          <label class="flex gap-2.5 items-start text-[12.5px] text-cream/65 leading-relaxed">
            <input name="optin" type="checkbox" class="mt-0.5 w-4 h-4 shrink-0 accent-[#D4A82D]" />
            <span>Je souhaite aussi recevoir La Lettre du Chêne, une fois par mois. Facultatif.</span>
          </label>

          <button type="submit" class="btn-or mt-2 inline-flex items-center justify-center gap-2">
            Envoyer ma recherche
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
          <p id="q-retour-msg" class="hidden text-[13.5px] leading-relaxed"></p>
        </form>

        <details class="mt-6 group">
          <summary class="text-[13px] text-cream/60 hover:text-or-light cursor-pointer transition-colors list-none">
            <span class="underline underline-offset-4">Revoir mes réponses</span>
          </summary>
          <div class="mt-3 border-t border-cream/15 pt-2">${recap}</div>
        </details>`;

      const form = document.getElementById('q-form') as HTMLFormElement;
      const msg = document.getElementById('q-retour-msg') as HTMLElement;
      const bouton = form.querySelector('button[type=submit]') as HTMLButtonElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const d = new FormData(form);
        bouton.disabled = true;
        const libelle = bouton.innerHTML;
        bouton.textContent = 'Envoi…';
        msg.className = 'hidden';

        try {
          const r = await fetch('/api/tool-lead', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              source: 'faitage',
              prenom: d.get('prenom'),
              nom: d.get('nom'),
              email: d.get('email'),
              telephone: d.get('telephone'),
              website: d.get('website'),
              consent: d.get('consent') === 'on',
              optin: d.get('optin') === 'on',
              projet,
              reponses: reponses.map((r) => ({ label: r.label, value: r.value })),
            }),
          });
          const res = await r.json();

          if (res.ok) {
            barre.style.width = '100%';
            compteur.textContent = 'Terminé';
            retour.classList.add('hidden');
            zone!.innerHTML = `
              <div class="text-center py-6">
                <div class="mx-auto w-14 h-14 rounded-full bg-or/15 border border-or/40 grid place-items-center">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6C259" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </div>
                <h3 class="font-serif text-2xl text-cream mt-5">C’est envoyé.</h3>
                <p class="text-cream/70 leading-relaxed mt-2 max-w-md mx-auto">
                  Votre recherche est bien arrivée. Vous recevez une réponse sous 24 heures
                  ouvrées, écrite à la main, pas un catalogue automatique.
                </p>
                <a href="/opportunites" class="inline-flex items-center gap-2 mt-7 px-6 py-3 border border-cream/25 text-sm font-medium text-cream hover:border-or hover:text-or-light transition-colors">
                  Voir la sélection du moment
                </a>
              </div>`;
            return;
          }

          msg.className = 'text-[13.5px] leading-relaxed text-red-700';
          msg.textContent =
            res.error === 'consentement_requis'
              ? 'Merci de cocher la case de consentement.'
              : res.error === 'champs_invalides'
                ? 'Vérifiez votre prénom et votre adresse email.'
                : 'Une erreur est survenue. Réessayez dans un instant.';
        } catch {
          msg.className = 'text-[13.5px] leading-relaxed text-red-700';
          msg.textContent = 'Connexion impossible. Réessayez dans un instant.';
        } finally {
          bouton.disabled = false;
          bouton.innerHTML = libelle;
        }
      });
    }

    retour.addEventListener('click', () => {
      const p = pile.pop();
      if (p) {
        courante = p;
        rendre();
      }
    });

    rendre();
  }
</script>

<style is:global>
  /* Champs posés sur le bloc navy : translucides, pas de rectangle blanc. */
  #questionnaire .q-champ {
    @apply border border-cream/20 bg-cream/[0.06] px-4 py-3 text-[15px] text-cream outline-none transition;
  }
  #questionnaire .q-champ::placeholder {
    @apply text-cream/45;
  }
  #questionnaire .q-champ:focus {
    @apply border-or bg-cream/[0.1];
  }
  /* Le navigateur repeint les champs auto-remplis en blanc : on l'en empêche. */
  #questionnaire .q-champ:-webkit-autofill,
  #questionnaire .q-champ:-webkit-autofill:focus {
    -webkit-text-fill-color: #f5f1e8;
    caret-color: #f5f1e8;
    transition: background-color 9999s ease-in-out 0s;
  }
  #questionnaire details > summary::-webkit-details-marker {
    display: none;
  }
</style>
