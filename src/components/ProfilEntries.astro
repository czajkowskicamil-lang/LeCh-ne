---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const contactHref = localizePath('/contact', lang);
const expertiseHref = localizePath('/expertise', lang);

// Leviers réutilisés : slug (URL) + clé i18n (libellé traduit).
const AV = { key: 'exp.assurance-vie', slug: 'assurance-vie' };
const IMMO = { key: 'exp.immobilier', slug: 'immobilier-lmnp-demembrement' };
const PER = { key: 'exp.per', slug: 'plan-epargne-retraite' };
const TRANS = { key: 'exp.transmission', slug: 'transmission' };
const TRANS_ANT = { key: 'exp.transmission-anticipee', slug: 'transmission' };
const SAL = { key: 'exp.epargne-salariale', slug: 'epargne-salariale-dirigeant' };
const CRED = { key: 'exp.credit', slug: 'credit-strategie-patrimoniale' };
const PE = { key: 'exp.private-equity', slug: 'private-equity-non-cote' };
const SCPI = { key: 'exp.scpi', slug: 'scpi' };

const profils = [
  { title: t('profils.1.title'), description: t('profils.1.desc'), expertises: [AV, IMMO, PER, TRANS_ANT] },
  { title: t('profils.2.title'), description: t('profils.2.desc'), expertises: [PER, IMMO, SAL, TRANS] },
  { title: t('profils.3.title'), description: t('profils.3.desc'), expertises: [CRED, IMMO, PE, TRANS] },
  { title: t('profils.4.title'), description: t('profils.4.desc'), expertises: [AV, IMMO, PER, SCPI] },
];
---

<section class="py-24 md:py-36 bg-cream">
  <div class="shell">
    <!-- En-tête asymétrique -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-end mb-16 md:mb-20">
      <div class="lg:col-span-7 reveal">
        <p class="pe-label mb-6">{t('profils.label')}</p>
        <h2 class="font-serif text-ink leading-[0.98] text-[clamp(2.4rem,5vw,4rem)] tracking-tight">
          {t('profils.title1')}<br/>{t('profils.title2')}
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 reveal">
        <p class="text-ink/65 leading-relaxed">
          {t('profils.intro')}
        </p>
      </div>
    </div>

    <!-- Index éditorial -->
    <div class="border-t border-ink/15">
      {profils.map((p, i) => (
        <div class="pe-row group grid lg:grid-cols-12 gap-y-5 lg:gap-x-10 py-10 md:py-14 border-b border-ink/15 reveal">
          <!-- Numéro + titre -->
          <div class="lg:col-span-4 flex items-baseline gap-5">
            <span class="pe-num font-serif">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-serif text-ink text-[clamp(1.5rem,2.4vw,2rem)] leading-tight">{p.title}</h3>
          </div>

          <!-- Description -->
          <div class="lg:col-span-5">
            <p class="text-ink/70 leading-relaxed max-w-prose-wide">{p.description}</p>
          </div>

          <!-- Leviers + lien -->
          <div class="lg:col-span-3">
            <p class="pe-label mb-3">{t('profils.leviers')}</p>
            <ul class="flex flex-wrap gap-x-4 gap-y-1.5 mb-6">
              {p.expertises.map((e) => (
                <li>
                  <a href={localizePath(`/expertise/${e.slug}`, lang)} class="text-sm text-ink/80 hover:text-chene transition-colors">{t(e.key)}</a>
                </li>
              ))}
            </ul>
            <a href={contactHref} class="inline-flex items-center gap-2 text-sm font-medium text-chene">
              <span class="pe-cta">{t('profils.rowCta')}</span>
              <svg class="transition-transform duration-300 group-hover:translate-x-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-14 reveal">
      <a href={expertiseHref} class="inline-flex items-baseline gap-3 font-serif text-ink text-xl md:text-2xl group">
        <span class="pe-cta">{t('profils.bottomCta')}</span>
        <svg class="translate-y-0.5 transition-transform duration-300 group-hover:translate-x-1.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .pe-label {
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(45, 74, 51, 0.75);
    font-weight: 600;
  }
  .pe-num {
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: rgba(212, 168, 45, 0.9);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    padding-top: 0.35rem;
  }
  /* Soulignement fin qui s'anime, façon lien éditorial */
  .pe-cta {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    padding-bottom: 2px;
  }
  .group:hover .pe-cta { background-size: 100% 1px; }
</style>
