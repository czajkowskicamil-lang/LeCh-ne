---
const profils = [
  {
    title: 'Sportifs professionnels',
    description: 'Huit à quinze ans pour bâtir un patrimoine qui devra tenir soixante. Carrière dense, fiscalité parfois internationale, fin de carrière qui arrive tôt. La méthode se construit pendant, pas après. Je l\'ai vécu, je la pilote pour vous.',
    expertises: [
      { label: 'Assurance-vie', slug: 'assurance-vie' },
      { label: 'Immobilier patrimonial', slug: 'immobilier-lmnp-demembrement' },
      { label: 'Plan Épargne Retraite', slug: 'plan-epargne-retraite' },
      { label: 'Transmission anticipée', slug: 'transmission' },
    ],
  },
  {
    title: 'Dirigeants & cadres',
    description: 'Revenus solides, enveloppes accumulées sans cohérence d\'ensemble. Plusieurs contrats, plusieurs logiques, qui ne se parlent pas. Ce qui n\'est pas mis en cohérence vous coûte chaque année, en fiscalité comme en performance.',
    expertises: [
      { label: 'Plan Épargne Retraite', slug: 'plan-epargne-retraite' },
      { label: 'Immobilier patrimonial', slug: 'immobilier-lmnp-demembrement' },
      { label: 'Épargne salariale & retraite dirigeant', slug: 'epargne-salariale-dirigeant' },
      { label: 'Transmission', slug: 'transmission' },
    ],
  },
  {
    title: 'Entrepreneurs',
    description: 'Votre entreprise est votre actif principal, et c\'est précisément là le risque. Cession, holding, Pacte Dutreil : ces leviers se préparent deux ans en amont, pas deux mois. Modélisation avant signature, jamais l\'inverse.',
    expertises: [
      { label: 'Crédit & effet de levier', slug: 'credit-strategie-patrimoniale' },
      { label: 'Immobilier patrimonial', slug: 'immobilier-lmnp-demembrement' },
      { label: 'Private Equity', slug: 'private-equity-non-cote' },
      { label: 'Transmission', slug: 'transmission' },
    ],
  },
  {
    title: 'Particuliers',
    description: 'Vous gagnez, vous épargnez, vous payez vos impôts. Personne ne vous a appris à articuler les trois. Bâtir un patrimoine cohérent ne demande pas d\'être déjà fortuné, mais une méthode. Et la méthode commence par savoir précisément où vous en êtes.',
    expertises: [
      { label: 'Assurance-vie', slug: 'assurance-vie' },
      { label: 'Immobilier patrimonial', slug: 'immobilier-lmnp-demembrement' },
      { label: 'Plan Épargne Retraite', slug: 'plan-epargne-retraite' },
      { label: 'SCPI', slug: 'scpi' },
    ],
  },
];
---

<section class="py-24 md:py-36 bg-cream">
  <div class="shell">
    <!-- En-tête asymétrique -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-end mb-16 md:mb-20">
      <div class="lg:col-span-7 reveal">
        <p class="pe-label mb-6">Pour qui</p>
        <h2 class="font-serif text-ink leading-[0.98] text-[clamp(2.4rem,5vw,4rem)] tracking-tight">
          Quatre profils,<br/>une même exigence.
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 reveal">
        <p class="text-ink/65 leading-relaxed">
          Le cabinet accompagne quatre trajectoires patrimoniales. Chacune appelle ses propres leviers, jamais les mêmes priorités.
        </p>
      </div>
    </div>

    <!-- Index éditorial -->
    <div class="border-t border-ink/15">
      {profils.map((p, i) => (
        <div class="pe-row group grid lg:grid-cols-12 gap-y-5 lg:gap-x-10 py-10 md:py-14 border-b border-ink/15 reveal">
          <!-- Numéro + titre -->
          <div class="lg:col-span-4 flex items-baseline gap-5">
            <span class="pe-num font-serif">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-serif text-ink text-[clamp(1.5rem,2.4vw,2rem)] leading-tight">{p.title}</h3>
          </div>

          <!-- Description -->
          <div class="lg:col-span-5">
            <p class="text-ink/70 leading-relaxed max-w-prose-wide">{p.description}</p>
          </div>

          <!-- Leviers + lien -->
          <div class="lg:col-span-3">
            <p class="pe-label mb-3">Leviers</p>
            <ul class="flex flex-wrap gap-x-4 gap-y-1.5 mb-6">
              {p.expertises.map((e) => (
                <li>
                  <a href={`/expertise/${e.slug}`} class="text-sm text-ink/80 hover:text-chene transition-colors">{e.label}</a>
                </li>
              ))}
            </ul>
            <a href="/contact" class="inline-flex items-center gap-2 text-sm font-medium text-chene">
              <span class="pe-cta">Premier échange offert</span>
              <svg class="transition-transform duration-300 group-hover:translate-x-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-14 reveal">
      <a href="/expertise" class="inline-flex items-baseline gap-3 font-serif text-ink text-xl md:text-2xl group">
        <span class="pe-cta">Voir les dix domaines d'expertise</span>
        <svg class="translate-y-0.5 transition-transform duration-300 group-hover:translate-x-1.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .pe-label {
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(45, 74, 51, 0.75);
    font-weight: 600;
  }
  .pe-num {
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: rgba(212, 168, 45, 0.9);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    padding-top: 0.35rem;
  }
  /* Soulignement fin qui s'anime, façon lien éditorial */
  .pe-cta {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    padding-bottom: 2px;
  }
  .group:hover .pe-cta { background-size: 100% 1px; }
</style>
