---
const profils = [
  {
    eyebrow: 'Carrière courte, revenus concentrés',
    title: 'Sportifs professionnels',
    description: 'Huit à quinze ans pour bâtir un patrimoine qui devra tenir soixante ans. Je l\'ai vécu, je l\'ai construit pour moi, je le pilote pour vous.',
    expertises: [
      { label: 'Assurance-vie', slug: 'assurance-vie' },
      { label: 'Immobilier patrimonial', slug: 'immobilier-lmnp-demembrement' },
      { label: 'Plan Épargne Retraite', slug: 'plan-epargne-retraite' },
      { label: 'Transmission anticipée', slug: 'transmission' },
    ],
  },
  {
    eyebrow: 'Optimisation, retraite, transmission',
    title: 'Dirigeants & cadres',
    description: 'Rémunération, retraite supplémentaire, capitalisation, succession familiale. La performance vient de la cohérence des enveloppes, pas de leur empilement.',
    expertises: [
      { label: 'Plan Épargne Retraite', slug: 'plan-epargne-retraite' },
      { label: 'Immobilier patrimonial', slug: 'immobilier-lmnp-demembrement' },
      { label: 'Épargne salariale & retraite dirigeant', slug: 'epargne-salariale-dirigeant' },
      { label: 'Transmission', slug: 'transmission' },
    ],
  },
  {
    eyebrow: 'Cession, holding, Pacte Dutreil',
    title: 'Entrepreneurs',
    description: 'Préparer la cession, structurer le patrimoine pro et perso, transmettre l\'outil familial. Chaque arbitrage modélisé avant signature, pas après.',
    expertises: [
      { label: 'Crédit & effet de levier', slug: 'credit-strategie-patrimoniale' },
      { label: 'Immobilier patrimonial', slug: 'immobilier-lmnp-demembrement' },
      { label: 'Private Equity', slug: 'private-equity-non-cote' },
      { label: 'Transmission', slug: 'transmission' },
    ],
  },
  {
    eyebrow: 'Construction patrimoniale long terme',
    title: 'Particuliers',
    description: 'Salarié, profession libérale, couple en milieu de carrière. Bâtir un patrimoine cohérent ne demande pas d\'être déjà fortuné. Ce sont les premières décisions qui structurent les vingt suivantes.',
    expertises: [
      { label: 'Assurance-vie', slug: 'assurance-vie' },
      { label: 'Immobilier patrimonial', slug: 'immobilier-lmnp-demembrement' },
      { label: 'Plan Épargne Retraite', slug: 'plan-epargne-retraite' },
      { label: 'SCPI', slug: 'scpi' },
    ],
  },
];
---

<section class="py-24 md:py-32">
  <div class="shell">
    <div class="grid lg:grid-cols-12 gap-8 md:gap-16 mb-16 items-end">
      <div class="lg:col-span-7 reveal">
        <p class="eyebrow mb-5 flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-chene"></span>
          Pour qui
        </p>
        <h2 class="font-serif text-display text-ink">
          Quatre profils, <span class="italic text-chene">une même rigueur.</span>
        </h2>
      </div>
      <div class="lg:col-span-5 reveal">
        <p class="text-ink/70 leading-relaxed">
          Le cabinet accompagne ces quatre trajectoires patrimoniales. Chacune appelle des leviers différents, jamais les mêmes priorités.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {profils.map((p, i) => (
        <div class="bg-cream-soft border border-ink/10 p-8 md:p-10 flex flex-col reveal" style={`animation-delay:${i * 80}ms`}>
          <span class="text-[0.65rem] uppercase tracking-micro text-chene mb-6">{p.eyebrow}</span>
          <h3 class="font-serif text-2xl md:text-[1.7rem] leading-tight mb-4">{p.title}</h3>
          <p class="text-sm text-ink/70 leading-relaxed mb-8">{p.description}</p>

          <div class="border-t border-ink/10 pt-6 mt-auto">
            <p class="text-[0.65rem] uppercase tracking-micro text-ink/50 mb-3">Leviers principaux</p>
            <ul class="space-y-2 mb-8">
              {p.expertises.map((e) => (
                <li>
                  <a href={`/expertise/${e.slug}`} class="text-sm text-ink hover:text-chene transition flex items-center gap-2">
                    <span class="w-1 h-1 rounded-full bg-or"></span>
                    {e.label}
                  </a>
                </li>
              ))}
            </ul>
            <a href="/contact" class="inline-flex items-center gap-2 text-sm font-medium text-chene hover:text-ink transition">
              <span>Premier échange offert</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center reveal">
      <a href="/expertise" class="link-underline text-chene font-medium text-sm">
        Voir les dix domaines d'expertise en détail →
      </a>
    </div>
  </div>
</section>
