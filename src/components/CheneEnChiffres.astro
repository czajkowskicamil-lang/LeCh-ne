---
import CountUp from './CountUp.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const t = useTranslations(getLangFromUrl(Astro.url));
---

<section class="py-24 md:py-32 bg-cream relative overflow-hidden">
  <div class="shell">
    <div class="mb-16 reveal max-w-3xl">
      <p class="eyebrow mb-5 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        {t('figures.eyebrow')}
      </p>
      <h2 class="font-serif text-display text-ink">
        {t('figures.title')}
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-y-12 gap-x-8 lg:gap-x-12">
      <div class="reveal">
        <p class="font-serif text-display text-ink leading-none mb-3">
          <CountUp value="2" />
        </p>
        <p class="text-ink/70 text-sm leading-relaxed border-t border-or/40 pt-3">
          {t('figures.d1')}
        </p>
      </div>

      <div class="reveal" style="animation-delay:80ms">
        <p class="font-serif text-display text-ink leading-none mb-3">
          <CountUp value="100%" />
        </p>
        <p class="text-ink/70 text-sm leading-relaxed border-t border-or/40 pt-3">
          {t('figures.d2')}
        </p>
      </div>

      <div class="reveal" style="animation-delay:160ms">
        <p class="font-serif text-display text-ink leading-none mb-3">
          <CountUp value="30" /><span class="text-2xl text-ink/60 ml-1">min</span>
        </p>
        <p class="text-ink/70 text-sm leading-relaxed border-t border-or/40 pt-3">
          {t('figures.d3')}
        </p>
      </div>

      <div class="reveal" style="animation-delay:240ms">
        <p class="font-serif text-display text-ink leading-none mb-3">
          <CountUp value="0" />
        </p>
        <p class="text-ink/70 text-sm leading-relaxed border-t border-or/40 pt-3">
          {t('figures.d4')}
        </p>
      </div>
    </div>

    <p class="mt-16 text-sm text-ink/50 italic max-w-2xl">
      {t('figures.legal')}
    </p>
  </div>
</section>
