---
import Logo from './Logo.astro';
import LanguageToggle from './LanguageToggle.astro';
import { nav, site } from '../data/site';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
import { translatedRoutes } from '../i18n/ui';

interface Props {
  heroDark?: boolean;
}
const { heroDark = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const pad = (n: number) => String(n + 1).padStart(2, '0');

// Menu localisé : libellé traduit + href préfixé selon la langue.
const menu = nav.map((item) => ({
  ...item,
  // Une page sans version anglaise garde son URL française (pas de lien vers une 404).
  href: translatedRoutes.has(item.href) ? localizePath(item.href, lang) : item.href,
  label: t(item.key),
}));
const avisHref = localizePath('/avis', lang);
// Le Faitage a son propre site : le lien sort, il ne reste pas dans le site
// du cabinet, pour que le visiteur sache toujours chez qui il est.
const faitageHref = 'https://www.lefaitage.fr';
const rdvHref = localizePath('/rendez-vous', getLangFromUrl(Astro.url));
// Espaces sécurisés : pages d'attente « en construction » sur le site, à
// rediriger vers espace.lechenepatrimonial.com le jour de la mise en ligne.
const espaceClientHref = '/espace-client';
const espaceProHref = '/espace-pro';
---

<header
  id="site-header"
  data-hero-dark={heroDark ? 'true' : undefined}
  class:list={[
    'sticky top-0 z-40 transition-colors duration-500',
    heroDark ? 'nav-hero' : 'bg-cream/80 backdrop-blur-xl border-b border-ink/5 text-ink',
  ]}
>
  <div class="shell flex items-center justify-between h-20">
    <Logo />

    <div class="flex items-center gap-4 sm:gap-5 md:gap-7">
      <!-- Le Faitage a son propre emplacement, hors du menu déroulant : c'est une
           marque du cabinet, elle doit se voir sans avoir à ouvrir le menu.
           Sa couleur kaki la distingue du vert chêne du cabinet. -->
      <a
        href={faitageHref}
        target="_blank"
        rel="noopener"
        class="nav-faitage nav-item hidden sm:inline-flex"
        aria-label="Le Faitage, le portail d'annonces du cabinet"
      >Le Faitage</a>

      <a href={avisHref} class="nav-avis nav-item" aria-label={t('nav.ariaAvis')}>{t('nav.avisShort')}</a>
      <a href={espaceClientHref} class="nav-item hidden md:inline-flex" aria-label="Espace client, accès sécurisé à votre dossier">Espace client</a>
      <LanguageToggle />
      <a href={rdvHref} class="nav-cta hidden sm:inline-flex btn-primary text-sm">
        {t('nav.rdv')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
      </a>

      <button id="menu-toggle" class="group flex items-center gap-3 text-current" aria-label={t('nav.ariaMenu')} aria-expanded="false" aria-controls="menu-overlay">
        <span class="nav-item hidden sm:inline">{t('nav.menu')}</span>
        <span class="flex flex-col items-end gap-[5px] w-6">
          <span class="block h-px w-6 bg-current transition-all duration-500 ease-out-expo"></span>
          <span class="block h-px w-4 bg-current transition-all duration-500 ease-out-expo group-hover:w-6"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Menu plein écran -->
<div
  id="menu-overlay"
  class="fixed inset-0 z-50 invisible opacity-0 transition-[opacity,visibility] duration-500 ease-out-expo"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <div id="menu-backdrop" class="absolute inset-0 bg-ink"></div>

  <div class="relative h-full flex flex-col">
    <!-- Barre haute du menu -->
    <div class="shell flex items-center justify-between h-20 shrink-0">
      <span class="font-serif text-cream text-lg tracking-tight">{site.name}</span>
      <button id="menu-close" class="group flex items-center gap-3 text-cream" aria-label={t('nav.fermer')}>
        <span class="hidden sm:inline text-xs uppercase tracking-micro font-medium">{t('nav.fermer')}</span>
        <span class="relative block w-6 h-6">
          <span class="absolute top-1/2 left-0 block h-px w-6 bg-cream rotate-45 transition-transform duration-500 group-hover:rotate-[135deg]"></span>
          <span class="absolute top-1/2 left-0 block h-px w-6 bg-cream -rotate-45 transition-transform duration-500 group-hover:rotate-[45deg]"></span>
        </span>
      </button>
    </div>

    <!-- Liens -->
    <div class="shell flex-1 min-h-0 overflow-y-auto flex flex-col justify-center py-8">
      <nav aria-label="Navigation principale" class="grid sm:grid-cols-2 gap-x-16 gap-y-1 max-w-4xl">
        {menu.map((item, i) => {
          const active = isActive(item.href);
          const isTool = item.href === '/calculatrice-rentabilite-credit';
          return (
            <a href={item.href} class="menu-link group flex items-baseline gap-4 py-2.5 border-b border-cream/10" data-i={i}>
              <span class="text-xs font-sans text-or/60 tabular-nums pt-1 w-6 shrink-0">{pad(i)}</span>
              <span class:list={[
                'font-serif text-[1.75rem] md:text-4xl leading-tight transition-colors duration-300',
                active ? 'text-or-light' : 'text-cream group-hover:text-or-light',
              ]}>
                {item.label}
                {isTool && <span class="align-middle ml-3 text-[0.6rem] uppercase tracking-micro font-sans text-ink bg-or rounded-full px-2 py-0.5">{t('nav.toolBadge')}</span>}
              </span>
              <svg class="ml-auto self-center w-5 h-5 text-or opacity-0 -translate-x-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          );
        })}
      </nav>
    </div>

    <!-- Pied du menu -->
    <div class="shell shrink-0 border-t border-cream/10 py-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-1 text-sm">
        <a href={`tel:${site.phone.tel}`} class="text-cream/70 hover:text-or-light transition-colors">{site.phone.display}</a>
        <a href={`mailto:${site.email}`} class="text-cream/70 hover:text-or-light transition-colors">{site.email}</a>
        <a href={site.linkedin} target="_blank" rel="noopener" class="text-cream/70 hover:text-or-light transition-colors">LinkedIn</a>
        <a href={espaceClientHref} class="text-cream/70 hover:text-or-light transition-colors">Espace client</a>
        <a href={espaceProHref} class="text-cream/70 hover:text-or-light transition-colors">Espace pro</a>
      </div>
      <a href={rdvHref} class="btn-or self-start md:self-auto">
        {t('nav.rdv')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</div>

<style>
  /* Nav transparente au-dessus du hero sombre, puis crème au scroll */
  header.nav-hero {
    background: transparent;
    border-bottom: 1px solid transparent;
    color: #F2EDE4;
  }
  header.nav-hero.is-solid {
    background: rgba(245, 241, 232, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom-color: rgba(242, 237, 228, 0.06);
    color: #0A0D14;
  }
  /* Logo lisible sur la zone claire du hero (ombre portée douce) */
  header.nav-hero:not(.is-solid) img {
    filter: drop-shadow(0 1px 2px rgba(3, 9, 28, 0.55)) drop-shadow(0 3px 10px rgba(3, 9, 28, 0.45));
  }
  /* Le Faitage en kaki : soutenu sur fond crème, éclairci au-dessus d'un hero
     sombre pour rester lisible. Le cabinet garde sa propre couleur. */
  .nav-faitage {
    color: #4C5526;
  }
  .nav-faitage:hover {
    color: #353C18;
  }
  /* Au-dessus d'un hero photo, le kaki se noie dans les zones claires. On passe
     au crème du reste du header, avec l'ombre portée déjà utilisée pour le logo
     du cabinet. Le kaki revient dès que le header devient solide. */
  header.nav-hero:not(.is-solid) .nav-faitage {
    color: #F2EDE4;
    filter: drop-shadow(0 1px 2px rgba(3, 9, 28, 0.6)) drop-shadow(0 3px 10px rgba(3, 9, 28, 0.5));
  }
  header.nav-hero:not(.is-solid) .nav-faitage:hover {
    color: #D8B872;
  }
  /* Bouton CTA doré tant qu'on survole le hero */
  header.nav-hero:not(.is-solid) .nav-cta {
    background-color: #C9A55C;
    color: #0A0D14;
  }
  header.nav-hero:not(.is-solid) .nav-cta:hover {
    background-color: #D8B872;
  }

  #menu-overlay .menu-link {
    opacity: 0;
    transform: translateY(14px);
  }
  #menu-overlay.is-open .menu-link {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s var(--ease-apple), transform 0.6s var(--ease-apple);
  }
</style>

<script>
  // Menu plein écran, réinitialisé à chaque navigation (Astro View Transitions)
  // pour rebinder les écouteurs sur le DOM fraîchement rendu.
  function initFullscreenMenu() {
    const toggle = document.getElementById('menu-toggle');
    const overlay = document.getElementById('menu-overlay');
    const closeBtn = document.getElementById('menu-close');
    const backdrop = document.getElementById('menu-backdrop');
    if (!toggle || !overlay) return;

    const links = Array.from(overlay.querySelectorAll<HTMLElement>('.menu-link'));
    const root = document.documentElement;

    function open() {
      overlay.classList.remove('invisible', 'opacity-0');
      overlay.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      root.style.overflow = 'hidden';
      links.forEach((l, i) => {
        l.style.transitionDelay = 90 + i * 55 + 'ms';
      });
    }

    function close() {
      overlay.classList.add('opacity-0');
      overlay.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      root.style.overflow = '';
      links.forEach((l) => (l.style.transitionDelay = '0ms'));
      window.setTimeout(() => overlay.classList.add('invisible'), 500);
    }

    // Toujours partir d'un état fermé après une navigation.
    close();

    toggle.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    backdrop?.addEventListener('click', close);
    overlay.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('is-open')) close();
    });
  }

  initFullscreenMenu();
  document.addEventListener('astro:page-load', initFullscreenMenu);

  // Solidifie la nav transparente (hero sombre) dès qu'on scrolle.
  function initHeaderScroll() {
    const header = document.getElementById('site-header');
    if (!header || header.dataset.heroDark !== 'true') return;
    const onScroll = () => {
      header.classList.toggle('is-solid', window.scrollY > 40);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  initHeaderScroll();
  document.addEventListener('astro:page-load', initHeaderScroll);
</script>
