---
/* Ouverture du site, la même que l'espace client : forêt plein écran et logo, puis un bouton doré « Entrer ».
   Au toucher, la musique (composant Musique) et le défilement partent ensemble : « Faire fructifier ce qui compte. »
   mot par mot sur le rythme, trait doré, et le site apparaît quand la musique s'éteint (7 s).
   Les navigateurs interdisent tout son avant un geste du visiteur : le toucher « Entrer » est ce geste.
   Une seule fois par visite (30 minutes, tous onglets confondus). Placée tout en haut du <body> et cachée par
   défaut : un visiteur qui l'a déjà vue n'a aucun flash. Jamais montrée aux robots (Google, Lighthouse). */
---
<div id="lc-intro" class="lc-intro" hidden>
  <div class="lc-intro-fond"></div>
  <div class="lc-intro-halo"></div>
  <div class="lc-intro-centre">
    <img src="/logo.png" width="170" height="149" alt="Le Chêne Patrimonial" class="lc-intro-pop" decoding="async" />
    <p class="lc-intro-titre" aria-hidden="true">
      <span class="lc-intro-mot" style="--d:0.5">Faire</span> <span class="lc-intro-mot" style="--d:1.5">fructifier</span><br />
      <em class="lc-intro-mot" style="--d:2.5">ce qui compte.</em>
    </p>
    <div class="lc-intro-trait"></div>
    <button type="button" class="lc-intro-entrer">Entrer</button>
  </div>
</div>
<script is:inline>
  (function () {
    if (window.__cheneIntro) return; // une seule fois par document (les transitions de page relancent ce script)
    window.__cheneIntro = 1;
    var el = document.getElementById('lc-intro'); if (!el) return;
    var VISITE = 30 * 60 * 1000, vu = false;
    try {
      if (/[?&]musique=test/.test(location.search)) localStorage.removeItem('chene_intro_vue');
      vu = Date.now() - Number(localStorage.getItem('chene_intro_vue') || 0) < VISITE;
    } catch (e) { /* stockage indisponible : on montre l'ouverture */ }
    if (vu || /bot|crawl|spider|slurp|lighthouse|pagespeed/i.test(navigator.userAgent)) return;
    el.hidden = false;
    document.documentElement.classList.add('lc-intro-ouverte');

    var pret = false, joue = false, fini = false, t1;
    // Le logo n'apparaît qu'une fois la page réellement à l'écran (Instagram et Facebook la chargent souvent en
    // arrière-plan avant de la montrer).
    function preparer() {
      if (pret || document.visibilityState !== 'visible') return;
      pret = true; el.classList.add('lc-intro-pret');
    }
    function fermer() {
      if (fini) return; fini = true; clearTimeout(t1);
      try { localStorage.setItem('chene_intro_vue', String(Date.now())); } catch (e) { /* */ }
      el.classList.add('lc-intro-sort');
      document.documentElement.classList.remove('lc-intro-ouverte');
      setTimeout(function () { el.hidden = true; }, 950);
    }
    // Le toucher lance la musique (écoute globale du composant Musique) et le défilement, ensemble.
    function entrer() {
      if (joue) return fermer(); // second toucher : on passe directement au site
      joue = true; preparer();
      el.classList.add('lc-intro-joue');
      t1 = setTimeout(fermer, 6000); // fondu de 0,95 s : le site apparaît quand la musique s'éteint
    }
    requestAnimationFrame(function () { requestAnimationFrame(preparer); });
    document.addEventListener('visibilitychange', preparer);
    window.addEventListener('pageshow', preparer);
    el.addEventListener('click', entrer);
    document.addEventListener('keydown', function (e) { if (!fini && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); entrer(); } });
  })();
</script>

<style is:global>
  html.lc-intro-ouverte, html.lc-intro-ouverte body { overflow: hidden; }
  .lc-intro {
    --t: 0.517s; /* un temps à 116 BPM */
    position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center; overflow: hidden;
    background: #0A0D14; cursor: pointer; color: #F2EDE4;
    transition: opacity .95s cubic-bezier(.6,0,.2,1), transform .95s cubic-bezier(.6,0,.2,1), visibility .95s;
  }
  .lc-intro[hidden] { display: none; }
  .lc-intro.lc-intro-sort { opacity: 0; transform: translateY(-6%); visibility: hidden; }
  .lc-intro-fond {
    position: absolute; inset: 0; background-size: cover; background-position: center 70%;
    background-image: linear-gradient(180deg, rgba(10,13,20,.45), rgba(10,13,20,.85)), url(/hero-forest.jpg);
  }
  .lc-intro-joue .lc-intro-fond { animation: lc-intro-zoom 7s ease-out both; }
  .lc-intro-halo { position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(201,165,92,.18), transparent 60%); }
  .lc-intro-centre { position: relative; padding: 0 24px; text-align: center; display: grid; justify-items: center; }

  /* Avant le toucher : le logo, puis le bouton « Entrer » qui respire doucement. */
  .lc-intro-pop { display: block; width: 170px; height: auto; opacity: 0; }
  .lc-intro-pret .lc-intro-pop { animation: lc-intro-pop .9s cubic-bezier(.2,.8,.2,1) both; }
  .lc-intro-entrer {
    grid-row: 2; margin-top: 44px; padding: 14px 44px; border-radius: 999px; cursor: pointer;
    font: 500 13px/1 "Inter Variable", Inter, system-ui, sans-serif; letter-spacing: .32em; text-transform: uppercase; text-indent: .32em;
    color: #0A0D14; background: linear-gradient(180deg, #E0C68F, #C9A55C); border: 0;
    box-shadow: 0 0 0 0 rgba(201,165,92,.55), 0 10px 30px -10px rgba(201,165,92,.6);
    opacity: 0; transition: opacity .5s, transform .5s;
  }
  .lc-intro-pret .lc-intro-entrer { animation: lc-intro-apparait .7s .6s cubic-bezier(.2,.8,.2,1) both, lc-intro-respire 2.4s 1.4s ease-in-out infinite; }
  .lc-intro-joue .lc-intro-entrer { animation: none; opacity: 0; transform: scale(.9); pointer-events: none; }

  /* Au toucher : les mots sur le rythme de la musique, puis le trait doré. */
  .lc-intro-titre { grid-row: 2; grid-column: 1; margin-top: 36px; font-family: "Chiffres Serif", "Fraunces Variable", Fraunces, Georgia, serif; font-size: clamp(2.6rem, 8vw, 4.6rem); line-height: 1.02; letter-spacing: -0.02em; }
  .lc-intro-titre em { color: #D8B871; font-style: italic; }
  .lc-intro-entrer { grid-column: 1; align-self: center; }
  .lc-intro-mot { display: inline-block; opacity: 0; }
  .lc-intro-joue .lc-intro-mot { animation: lc-intro-mot .8s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--d) * var(--t)); }
  .lc-intro-trait { grid-row: 3; width: 224px; height: 1px; margin: 32px auto 0; background: #C9A55C; transform: scaleX(0); }
  .lc-intro-joue .lc-intro-trait { animation: lc-intro-trait .9s cubic-bezier(.6,0,.2,1) both; animation-delay: calc(4 * var(--t)); }

  @keyframes lc-intro-pop { 0% { opacity: 0; transform: scale(.6); filter: blur(8px); } 60% { opacity: 1; transform: scale(1.06); filter: blur(0); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes lc-intro-apparait { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes lc-intro-respire { 0%, 100% { box-shadow: 0 0 0 0 rgba(201,165,92,.5), 0 10px 30px -10px rgba(201,165,92,.6); } 50% { box-shadow: 0 0 0 12px rgba(201,165,92,0), 0 10px 30px -10px rgba(201,165,92,.6); } }
  @keyframes lc-intro-mot { 0% { opacity: 0; transform: translateY(28px); letter-spacing: .2em; } 100% { opacity: 1; transform: none; letter-spacing: normal; } }
  @keyframes lc-intro-trait { 0% { transform: scaleX(0); } 100% { transform: scaleX(1); } }
  @keyframes lc-intro-zoom { 0% { transform: scale(1); } 100% { transform: scale(1.12); } }
  @media (prefers-reduced-motion: reduce) {
    .lc-intro-pret .lc-intro-pop, .lc-intro-pret .lc-intro-entrer, .lc-intro-joue .lc-intro-fond, .lc-intro-joue .lc-intro-mot, .lc-intro-joue .lc-intro-trait { animation-duration: .01s !important; animation-delay: 0s !important; animation-iteration-count: 1 !important; }
  }
</style>
