---
/* Générique du site : seul ajout au site, qui reste tel quel. Fondu depuis le noir sur la forêt, logo, puis
   « Faire fructifier ce qui compte. » en Cormorant Garamond léger, mot par mot sortant d'un flou, filet doré tracé
   depuis le centre. Il dure 7 secondes puis le site apparaît, sans rien toucher. Si le visiteur touche l'écran pendant
   le générique, la musique (composant Musique) part, le générique repart calé sur elle, et elle s'arrête quand le
   site apparaît (les navigateurs interdisent tout son avant un geste). À chaque chargement de page (lien, rafraîchissement) ; pas pendant la navigation dans le site. Caché par défaut : aucun flash pour qui l'a
   déjà vu. Jamais montré aux robots (Google, Lighthouse). */
---
<div id="lc-intro" class="lc-intro" hidden>
  <div class="lc-intro-fond"></div>
  <div class="lc-intro-voile"></div>
  <div class="lc-intro-centre">
    <img src="/logo.png" width="170" height="149" alt="Le Chêne Patrimonial" class="lc-intro-logo" decoding="async" />
    <p class="lc-intro-titre" aria-hidden="true">
      <span class="lc-intro-mot" style="--i:0">Faire</span> <span class="lc-intro-mot" style="--i:1">fructifier</span><br />
      <em class="lc-intro-mot" style="--i:2">ce qui compte.</em>
    </p>
    <div class="lc-intro-filet"></div>
  </div>
</div>
<script is:inline>
  (function () {
    if (window.__cheneIntro) return; // une seule fois par document (les transitions de page relancent ce script)
    window.__cheneIntro = 1;
    var el = document.getElementById('lc-intro'); if (!el) return;
    // À chaque chargement de page (lien Instagram, Facebook, Google, SMS, rafraîchissement) : le générique.
    // La navigation dans le site (transitions, même page chargée) ne le rejoue pas.
    var vu = false;
    try { localStorage.removeItem('chene_intro_vue'); sessionStorage.removeItem('chene_intro_vue'); } catch (e) { /* anciens verrous */ }
    // Outil ouvert depuis l'espace client : le client a déjà vu le générique, on va droit à l'outil.
    if (/[?&]depuis=espace/.test(location.search)) vu = true;
    if (vu || /bot|crawl|spider|slurp|lighthouse|pagespeed/i.test(navigator.userAgent)) return;
    el.hidden = false;
    document.documentElement.classList.add('lc-intro-ouverte');

    var lance = false, musique = false, fini = false, t1;
    function fermer() {
      if (fini) return; fini = true; clearTimeout(t1);
      document.dispatchEvent(new Event('chene:intro-fin')); // le site apparaît : la musique s'arrête
      // Les blocs déjà « révélés » derrière le générique refont leur apparition sous les yeux du visiteur.
      var deja = document.querySelectorAll('.reveal.is-visible, .reveal-left.is-visible, .reveal-right.is-visible, .reveal-scale.is-visible, .reveal-clip.is-visible');
      deja.forEach(function (b) { b.classList.remove('is-visible'); });
      el.classList.add('lc-intro-sort');
      document.documentElement.classList.remove('lc-intro-ouverte');
      requestAnimationFrame(function () { requestAnimationFrame(function () { deja.forEach(function (b) { b.classList.add('is-visible'); }); }); });
      setTimeout(function () { el.hidden = true; }, 1200);
    }
    function jouer(duree) {
      clearTimeout(t1);
      el.classList.remove('lc-intro-joue'); void el.offsetWidth; el.classList.add('lc-intro-joue');
      if (duree) t1 = setTimeout(fermer, duree);
    }
    // Instagram et Facebook chargent souvent la page en arrière-plan : le générique ne démarre qu'à l'écran.
    // Le générique se joue 7 secondes puis le site apparaît tout seul.
    function lancer() {
      if (lance || document.visibilityState !== 'visible') return;
      lance = true; jouer(7000); // 7 secondes, puis le site, sans rien toucher
      document.dispatchEvent(new Event('chene:intro-debut')); // la musique tente de partir d'elle-même
    }
    // Premier toucher : la musique part et le générique repart calé sur elle ; le site apparaît quand elle s'éteint.
    // Un second toucher passe directement au site.
    function toucher() {
      if (fini) return;
      if (musique) return fermer();
      // Musique déjà partie toute seule (navigateur qui l'autorise) : le générique continue tel quel.
      var a = document.getElementById('lc-musique-son');
      if (a && !a.paused && a.currentTime > 0) { musique = true; el.classList.add('lc-intro-musique'); return; }
      musique = true; lance = true; el.classList.add('lc-intro-musique');
      jouer(5900);
    }
    requestAnimationFrame(function () { requestAnimationFrame(lancer); });
    document.addEventListener('visibilitychange', lancer);
    window.addEventListener('pageshow', lancer);
    el.addEventListener('click', toucher);
    document.addEventListener('keydown', function (e) { if (!fini && /^(Enter| |Escape)$/.test(e.key)) { e.preventDefault(); e.key === 'Escape' ? fermer() : toucher(); } });
  })();
</script>

<style is:global>
  html.lc-intro-ouverte, html.lc-intro-ouverte body { overflow: hidden; }
  /* La page attend la fin du générique pour faire sa propre entrée : ses animations (titre, boutons, chiffres)
     restent en pause derrière le générique et se jouent quand la forêt s'efface, comme avant le générique. */
  html.lc-intro-ouverte .ep-in { animation-play-state: paused; }
  html.lc-intro-ouverte .reveal, html.lc-intro-ouverte .reveal-left, html.lc-intro-ouverte .reveal-right,
  html.lc-intro-ouverte .reveal-scale, html.lc-intro-ouverte .reveal-clip { transition: none !important; }
  .lc-intro {
    position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center; overflow: hidden;
    background: #05070B; cursor: pointer; color: #F2EDE4;
    transition: opacity 1.1s cubic-bezier(.4,0,.2,1), visibility 1.1s;
  }
  .lc-intro[hidden] { display: none; }
  .lc-intro.lc-intro-sort { opacity: 0; visibility: hidden; }

  /* Forêt : fondu depuis le noir, très lente avancée de caméra. */
  .lc-intro-fond {
    position: absolute; inset: -2%; background: url(/hero-forest.jpg) center 70% / cover no-repeat;
    opacity: 0; will-change: transform;
  }
  .lc-intro-joue .lc-intro-fond { animation: lc-intro-fond 8s cubic-bezier(.25,.1,.25,1) both; }
  .lc-intro-voile {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 50% 48%, rgba(201,165,92,.10), transparent 70%),
      linear-gradient(180deg, rgba(5,7,11,.55) 0%, rgba(5,7,11,.72) 55%, rgba(5,7,11,.92) 100%);
  }
  .lc-intro-centre { position: relative; padding: 0 28px; text-align: center; }

  .lc-intro-logo { display: block; margin: 0 auto; width: 112px; height: auto; opacity: 0; }
  .lc-intro-joue .lc-intro-logo { animation: lc-intro-flou 1.8s .35s cubic-bezier(.16,1,.3,1) both; }

  .lc-intro-titre {
    margin-top: 44px;
    font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 300;
    font-size: clamp(2.5rem, 6.6vw, 4.6rem); line-height: 1.06; letter-spacing: .005em;
  }
  .lc-intro-titre em { font-style: italic; font-weight: 400; color: #D9BE86; }
  .lc-intro-mot { display: inline-block; opacity: 0; }
  .lc-intro-joue .lc-intro-mot { animation: lc-intro-mot 1.7s cubic-bezier(.16,1,.3,1) both; animation-delay: calc(1.1s + var(--i) * .5s); }

  .lc-intro-filet {
    width: 180px; height: 1px; margin: 34px auto 0; transform: scaleX(0);
    background: linear-gradient(90deg, transparent, #C9A55C 30%, #E6D3A3 50%, #C9A55C 70%, transparent);
  }
  .lc-intro-joue .lc-intro-filet { animation: lc-intro-filet 1.6s 2.7s cubic-bezier(.65,0,.35,1) both; }

  .lc-intro-son {
    position: absolute; left: 0; right: 0; bottom: calc(34px + env(safe-area-inset-bottom)); text-align: center;
    font: 400 10.5px/1 'Inter Variable', Inter, system-ui, sans-serif; letter-spacing: .34em; text-transform: uppercase;
    color: rgba(242,237,228,.5); opacity: 0;
  }
  .lc-intro-joue .lc-intro-son { animation: lc-intro-flou 1.4s 1.6s ease both, lc-intro-souffle 3s 3s ease-in-out infinite; }
  .lc-intro-musique .lc-intro-son { display: none; }
  .lc-intro-souris { display: none; }
  @media (hover: hover) and (pointer: fine) { .lc-intro-tactile { display: none; } .lc-intro-souris { display: inline; } }

  @keyframes lc-intro-fond { 0% { opacity: 0; transform: scale(1) translate3d(0,0,0); } 12% { opacity: 1; } 100% { opacity: 1; transform: scale(1.16) translate3d(-1.5%,-1.2%,0); } }
  @keyframes lc-intro-flou { from { opacity: 0; filter: blur(10px); } to { opacity: 1; filter: blur(0); } }
  @keyframes lc-intro-mot { from { opacity: 0; filter: blur(12px); transform: translateY(12px); } to { opacity: 1; filter: blur(0); transform: none; } }
  @keyframes lc-intro-filet { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes lc-intro-souffle { 0%, 100% { opacity: 1; } 50% { opacity: .45; } }
  @media (prefers-reduced-motion: reduce) {
    .lc-intro-joue .lc-intro-fond, .lc-intro-joue .lc-intro-logo, .lc-intro-joue .lc-intro-mot, .lc-intro-joue .lc-intro-filet, .lc-intro-joue .lc-intro-son { animation-duration: .01s !important; animation-delay: 0s !important; animation-iteration-count: 1 !important; }
  }
</style>
