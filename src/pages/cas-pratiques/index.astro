---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CTA from '../../components/CTA.astro';
import { getCollection } from 'astro:content';

const cases = (await getCollection('cas')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
---

<Base
  heroDark
  title="Cas pratiques, Le Chêne Patrimonial"
  description="Trois exemples concrets d'accompagnement patrimonial : dirigeant SaaS, athlète en reconversion, couple en transmission. Stratégie, chiffres, résultats."
>
  <PageHeader
    image="/cas-pratiques-header.jpg"
    alt="Lumière dorée dans une forêt d'automne"
    eyebrow="Cas pratiques"
    title={`Des profils,<br/><span class="italic text-or-light">des résultats.</span>`}
    intro="Trois dossiers réels, anonymisés avec l'accord des clients. Même méthode, trois situations très différentes, chiffres à l'appui."
  />

  <section class="py-12 md:py-16">
    <div class="shell">
      <div class="grid gap-px bg-ink/10 border-y border-ink/10">
        {cases.map((c, i) => (
          <a href={`/cas-pratiques/${c.slug}`} class="group bg-cream hover:bg-cream-soft transition p-8 md:p-12 grid lg:grid-cols-12 gap-8 items-center reveal" style={`animation-delay:${i * 80}ms`}>
            <div class="lg:col-span-1">
              <span class="font-serif italic text-4xl text-or">0{i + 1}</span>
            </div>
            <div class="lg:col-span-6">
              <p class="text-xs uppercase tracking-micro text-chene mb-3 font-medium">{c.data.profil}</p>
              <h2 class="font-serif text-2xl md:text-3xl text-ink mb-3 leading-tight group-hover:text-chene transition">{c.data.title}</h2>
              <p class="text-ink/70 leading-relaxed">{c.data.problematique}</p>
            </div>
            <div class="lg:col-span-5 flex lg:justify-end">
              <span class="link-underline text-chene font-medium">Lire le dossier →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA title="Votre situation ressemble à l'un de ces cas ?" body="Un premier rendez-vous découverte permet souvent de voir immédiatement s'il y a matière à agir. Planifions-en un, sans engagement." />
</Base>
