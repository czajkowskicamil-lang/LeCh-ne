---
import Base from '../../layouts/Base.astro';
---

<Base noIndex title="Page not found, Le Chêne Patrimonial" description="This page does not exist.">
  <section class="py-32 md:py-48">
    <div class="shell max-w-2xl text-center">
      <p class="eyebrow mb-6 justify-center flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Error 404
      </p>
      <h1 class="font-serif text-display text-ink mb-6">
        This page has <span class="italic text-chene">vanished.</span>
      </h1>
      <p class="text-ink/70 text-lg mb-10">
        The link you followed doesn't exist, or no longer does. No worries, let's start again from the beginning.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/en/" class="btn-primary">Back to home</a>
        <a href="/en/expertise" class="btn-ghost">Browse the expertise</a>
      </div>
    </div>
  </section>
</Base>
