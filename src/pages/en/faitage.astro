---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import LogoFaitage from '../../components/LogoFaitage.astro';

// English version of /faitage. Le Faitage is a brand owned by the firm, never
// presented as a third party. No property is listed until distribution
// agreements are signed with developers and operators.

const principles = [
  {
    t: 'Figures before the first call',
    d: 'Price, monthly rent, yield, lease term and operator. Shown on the listing itself, without having to hand over a phone number to see an amount.',
  },
  {
    t: 'No sponsored listings',
    d: 'Ranking is not for sale. No property is pushed up the page because it pays better than the next one.',
  },
  {
    t: 'Few properties, all verified',
    d: 'A property goes live only once its official documentation is complete and its operator identified. Otherwise it does not appear.',
  },
];
---

<Base
  title="Le Faitage, the firm's property brand"
  description="Le Faitage is the property portal of Le Chêne Patrimonial: tell us about your project and we answer with what actually matches. Figures shown, no sponsored listings."
>
  <section class="pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="shell">
      <!-- The brand comes first: this is Le Faitage's page. -->
      <div class="flex flex-col items-center text-center pb-12 md:pb-16 border-b border-ink/10">
        <LogoFaitage size={230} layout="empile" class="text-kaki" />
        <p class="eyebrow mt-6 flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-kaki"></span>
          A brand by Le Chêne Patrimonial
          <span class="inline-block h-px w-8 bg-kaki"></span>
        </p>
      </div>

      <div class="grid lg:grid-cols-12 gap-14 items-center pt-12 md:pt-16">
        <div class="lg:col-span-7">
          <h1 class="font-serif text-display-xl text-ink mb-6">
            The beam that <span class="italic text-kaki">holds it up.</span>
          </h1>
          <p class="text-xl text-ink/75 max-w-2xl leading-relaxed">
            A faitage is the ridge beam of a roof: the piece that carries everything
            else, traditionally cut from oak. The firm follows properties across
            France, with their real figures. Rather than have you wade through a
            catalogue, we start from your project.
          </p>

          <div class="flex flex-wrap gap-4 mt-10">
            <a href="/en/contact" class="btn-or inline-flex items-center gap-2">
              Tell me when it opens
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
            <a
              href="/en/opportunites"
              class="inline-flex items-center gap-2 px-6 py-3 border border-ink/15 text-sm font-medium text-ink hover:border-chene/50 hover:text-chene transition-colors"
            >
              See the current selection
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-navy-deep text-cream p-10 md:p-12 flex flex-col items-center text-center">
            <LogoFaitage size={150} layout="empile" class="text-kaki-light" />
            <div class="mt-6 h-px w-12 bg-or/60"></div>
            <p class="text-sm text-cream/70 mt-5 leading-relaxed">
              The property portal of Le Chêne Patrimonial
            </p>
          </div>
          <p class="text-xs text-stone/80 mt-3 leading-relaxed">
            Brand operated by Le Chêne Patrimonial. The portal will be published under
            the firm's responsibility and registrations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 border-t border-ink/10">
    <div class="shell">
      <div class="max-w-3xl mb-10">
        <div class="border-t-2 border-or w-11 mb-4"></div>
        <p class="text-xs uppercase tracking-micro text-or-dark font-semibold">
          What Le Faitage commits to
        </p>
        <h2 class="font-serif text-3xl md:text-4xl text-ink mt-2 mb-3">
          Three rules, held from the very first listing
        </h2>
        <p class="text-ink/70 leading-relaxed">
          A listings portal is judged on what it refuses to publish, not on how many
          units it stacks up. These rules apply from day one.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-px bg-ink/10 border border-ink/10">
        {
          principles.map((p, i) => (
            <div class="bg-cream-soft/60 p-6">
              <div class="text-xs font-semibold text-or-dark tabular-nums">0{i + 1}</div>
              <h3 class="font-serif text-xl text-ink leading-tight mt-2">{p.t}</h3>
              <p class="text-sm text-stone mt-2 leading-relaxed">{p.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pt-12 pb-16 md:pb-24 border-t border-ink/10">
    <div class="shell">
      <p class="text-xs text-stone/80 leading-relaxed max-w-3xl">
        Le Faitage is a brand operated by Le Chêne Patrimonial. This page presents a
        planned portal and constitutes neither an offer, nor a solicitation, nor
        personalised investment advice. No property is distributed through it to date.
        Le Chêne Patrimonial · Camil Czajkowski, insurance broker (COA, ORIAS
        no. 25 00 00 16) and estate agent (carte T no. CPI 3402 2024 000 000 049).
      </p>
    </div>
  </section>

  <CTA />
</Base>
