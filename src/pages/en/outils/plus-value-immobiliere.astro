---
import Base from '../../../layouts/Base.astro';
import CTA from '../../../components/CTA.astro';

const title = "2026 Real Estate Capital Gains Tax Calculator (plus-value immobilière) | Le Chêne Patrimonial";
const description = "Estimate the tax on the capital gain when reselling a rental property or a second home: allowances by holding period, income tax and social security contributions.";
---

<Base title={title} description={description}>
  <header class="pt-16 pb-8 md:pt-24 md:pb-10">
    <div class="shell max-w-4xl">
      <nav class="text-xs uppercase tracking-micro text-stone mb-10 flex gap-3" aria-label="Breadcrumb">
        <a href="/en" class="hover:text-chene">Home</a>
        <span>/</span>
        <a href="/en/outils" class="hover:text-chene">Tools</a>
        <span>/</span>
        <span class="text-ink">Real estate capital gains</span>
      </nav>
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Real estate
      </p>
      <h1 class="font-serif text-display text-ink mb-6 leading-tight">How much tax on resale?</h1>
      <p class="text-xl text-ink/75 max-w-prose-wide leading-relaxed">
        Reselling a rental property or a second home triggers tax on the capital gain (plus-value immobilière), which decreases over time. Estimate it, and see why the holding period changes everything.
      </p>
    </div>
  </header>

  <div class="shell max-w-5xl pb-16">
    <div class="tool-card">
      <div class="tool-grid">
        <div>
          <div class="tool-field">
            <label>Purchase price <b id="pv-achat-val">200 000 €</b></label>
            <input class="tool-range" type="range" id="pv-achat" min="20000" max="1500000" step="5000" value="200000" />
          </div>
          <div class="tool-field">
            <label>Resale price <b id="pv-vente-val">300 000 €</b></label>
            <input class="tool-range" type="range" id="pv-vente" min="20000" max="2000000" step="5000" value="300000" />
          </div>
          <div class="tool-field">
            <label>Holding period <b id="pv-dur-val">10 years</b></label>
            <input class="tool-range" type="range" id="pv-dur" min="0" max="32" step="1" value="10" />
          </div>
          <p class="tool-note">Property other than your primary residence (which is exempt). Capital gain = resale price minus purchase price (fees and renovation costs are not factored in here). A surtax of 2 to 6% may apply if the taxable capital gain exceeds 50,000 €.</p>
        </div>

        <div class="tool-result">
          <p class="lbl">Total tax on the capital gain</p>
          <p class="big" id="pv-total">—</p>
          <div class="tool-brk"><span class="k">Gross capital gain</span><span class="v" id="pv-brute">—</span></div>
          <div class="tool-brk"><span class="k">Income tax allowance</span><span class="v" id="pv-abir">—</span></div>
          <div class="tool-brk"><span class="k">Income tax (19%)</span><span class="v" id="pv-ir">—</span></div>
          <div class="tool-brk"><span class="k">Social security contributions (17.2%)</span><span class="v" id="pv-ps">—</span></div>
          <div class="tool-brk"><span class="k">Capital gain net of tax</span><span class="v" id="pv-net">—</span></div>
        </div>
      </div>
    </div>

    <div class="tool-card pv-chart-card">
      <p class="pv-chart-title">Tax owed by length of ownership</p>
      <svg id="pv-svg" viewBox="0 0 640 280" role="img" aria-label="Chart of the capital gains tax by number of years of ownership">
        <line class="pv-axis" x1="44" y1="238" x2="628" y2="238" />
        <path id="pv-area" class="pv-area" d="" />
        <path id="pv-line" class="pv-line" d="" fill="none" />
        <line id="pv-mark-line" class="pv-mark-line" x1="0" y1="20" x2="0" y2="238" />
        <circle id="pv-mark-dot" class="pv-mark-dot" cx="-20" cy="0" r="4.5" />
        <text id="pv-mark-lab" class="pv-mark-lab" x="0" y="14" text-anchor="middle"></text>
        <text id="pv-ymax" class="pv-tick" x="40" y="30" text-anchor="end">—</text>
        <text class="pv-tick" x="40" y="242" text-anchor="end">0</text>
        <text id="pv-t0" class="pv-tick" x="44" y="262" text-anchor="start">0 yr</text>
        <text id="pv-t22" class="pv-tick" x="336" y="262" text-anchor="middle">22 yrs</text>
        <text id="pv-t30" class="pv-tick" x="628" y="262" text-anchor="end">30 yrs</text>
      </svg>
      <div class="pv-leg">
        <span><i class="pv-leg-line"></i> Total tax due at resale</span>
      </div>
    </div>

    <div class="max-w-prose-wide mt-14 prose-editorial">
      <h2>Time erases the tax</h2>
      <p>Two allowances stack, one on income tax, the other on social security contributions. The result: after <strong>22 years</strong> of ownership, no more income tax, and after <strong>30 years</strong>, full exemption. In between, the bill shrinks year by year.</p>
      <p>Selling a year too early can cost several thousand euros. Conversely, a well-designed structure (split ownership, contribution to a company, timing the sale) can significantly lighten the bill. This is the kind of decision that is prepared for, not improvised.</p>
    </div>
  </div>

  <CTA />
</Base>

<style is:global>
  .pv-chart-card{margin-top:22px;}
  .pv-chart-title{color:#9fb0c8;font-size:.8rem;text-transform:uppercase;letter-spacing:.09em;font-weight:700;margin-bottom:14px;}
  #pv-svg{width:100%;height:auto;display:block;overflow:visible;}
  .pv-axis{stroke:rgba(255,255,255,.12);stroke-width:1;}
  .pv-area{fill:rgba(212,168,45,.30);}
  .pv-line{stroke:#E6C259;stroke-width:2.5;stroke-linejoin:round;stroke-linecap:round;}
  .pv-mark-line{stroke:rgba(255,255,255,.4);stroke-width:1;stroke-dasharray:3 3;}
  .pv-mark-dot{fill:#fff;stroke:#E6C259;stroke-width:2;}
  .pv-mark-lab{fill:#e9edf4;font-size:12px;font-weight:600;font-family:system-ui,sans-serif;}
  .pv-tick{fill:#7f8ea6;font-size:12px;font-family:system-ui,sans-serif;}
  .pv-leg{display:flex;gap:20px;font-size:.8rem;color:#9fb0c8;margin-top:14px;flex-wrap:wrap;}
  .pv-leg span{display:inline-flex;align-items:center;gap:7px;}
  .pv-leg i{width:16px;height:0;border-top:2.5px solid #E6C259;display:block;}
</style>

<script is:inline>
  (function () {
    const eur = n => Math.round(n).toLocaleString('fr-FR') + ' €';
    function abIR(y){ return y<6?0 : (y<22?(y-5)*6 : 100); }
    function abPS(y){ return y<6?0 : (y<=21?(y-5)*1.65 : (y===22?28 : Math.min(100,28+(y-22)*9))); }
    function calc(){
      const a=+document.getElementById('pv-achat').value, v=+document.getElementById('pv-vente').value, y=+document.getElementById('pv-dur').value;
      document.getElementById('pv-achat-val').textContent=eur(a);
      document.getElementById('pv-vente-val').textContent=eur(v);
      document.getElementById('pv-dur-val').textContent=y+' year'+(y>1?'s':'');
      const pv=Math.max(0,v-a);
      const ir=pv*(1-abIR(y)/100)*0.19;
      const ps=pv*(1-abPS(y)/100)*0.172;
      const total=ir+ps;
      document.getElementById('pv-brute').textContent=eur(pv);
      document.getElementById('pv-abir').textContent=abIR(y)+' %';
      document.getElementById('pv-ir').textContent=eur(ir);
      document.getElementById('pv-ps').textContent=eur(ps);
      document.getElementById('pv-total').textContent=eur(total);
      document.getElementById('pv-net').textContent=eur(pv-total);
      drawChart(pv, y);
    }
    function impot(pv,y){ return pv*(1-abIR(y)/100)*0.19 + pv*(1-abPS(y)/100)*0.172; }
    function drawChart(pv, sel){
      const x0=44,x1=628,yTop=20,yBase=238, xmax=30;
      const vals=[]; for(let y=0;y<=xmax;y++) vals.push(impot(pv,y));
      const maxV=Math.max(1, vals[0]);
      const X=y=>x0+(y/xmax)*(x1-x0);
      const Yc=v=>yBase-(Math.min(v,maxV)/maxV)*(yBase-yTop);
      const line=vals.map((v,i)=>(i?'L':'M')+X(i).toFixed(1)+' '+Yc(v).toFixed(1)).join(' ');
      document.getElementById('pv-line').setAttribute('d',line);
      document.getElementById('pv-area').setAttribute('d',line+' L'+X(xmax).toFixed(1)+' '+yBase+' L'+x0+' '+yBase+' Z');
      const yy=Math.min(sel,xmax), fx=X(yy), fv=impot(pv,yy), fy=Yc(fv);
      const ml=document.getElementById('pv-mark-line'), md=document.getElementById('pv-mark-dot'), mlab=document.getElementById('pv-mark-lab');
      ml.setAttribute('x1',fx.toFixed(1)); ml.setAttribute('x2',fx.toFixed(1));
      md.setAttribute('cx',fx.toFixed(1)); md.setAttribute('cy',fy.toFixed(1));
      mlab.setAttribute('x',Math.max(44,Math.min(x1-44,fx)).toFixed(1)); mlab.setAttribute('y',Math.max(14,fy-12).toFixed(1));
      mlab.textContent=eur(fv);
      document.getElementById('pv-t22').setAttribute('x',X(22).toFixed(1));
      document.getElementById('pv-ymax').textContent=eur(maxV);
    }
    function init(){
      const r=document.getElementById('pv-achat'); if(!r||r.dataset.ready) return; r.dataset.ready='1';
      ['pv-achat','pv-vente','pv-dur'].forEach(id=>document.getElementById(id).addEventListener('input',calc));
      calc();
    }
    init();
    if(!window['__hk_pv-achat']){window['__hk_pv-achat']=1;document.addEventListener('astro:page-load',init);}
  })();
</script>
