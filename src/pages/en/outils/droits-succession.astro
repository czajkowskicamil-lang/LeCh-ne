---
import Base from '../../../layouts/Base.astro';
import CTA from '../../../components/CTA.astro';

const title = "2026 Inheritance Tax Calculator (French estate transferred to children) | Le Chêne Patrimonial";
const description = "How much inheritance tax (droits de succession) would your children pay? Get a free estimate using the 100,000 € allowance and the official 2026 scale. And see what anticipating the transfer can change.";
---

<Base title={title} description={description}>
  <header class="pt-16 pb-8 md:pt-24 md:pb-10">
    <div class="shell max-w-4xl">
      <nav class="text-xs uppercase tracking-micro text-stone mb-10 flex gap-3" aria-label="Breadcrumb">
        <a href="/en" class="hover:text-chene">Home</a>
        <span>/</span>
        <a href="/en/outils" class="hover:text-chene">Tools</a>
        <span>/</span>
        <span class="text-ink">Inheritance tax</span>
      </nav>
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Wealth transfer
      </p>
      <h1 class="font-serif text-display text-ink mb-6 leading-tight">How much would your children pay?</h1>
      <p class="text-xl text-ink/75 max-w-prose-wide leading-relaxed">
        Estate planning is the subject we always put off. Yet a few thousand euros of transferred wealth can cost your heirs dearly. Estimate it, then see what anticipating the transfer can save.
      </p>
    </div>
  </header>

  <div class="shell max-w-5xl pb-16">
    <div class="tool-card">
      <div class="tool-grid">
        <div>
          <div class="tool-field">
            <label>Estate transferred <b id="ds-pat-val">500 000 €</b></label>
            <input class="tool-range" type="range" id="ds-pat" min="0" max="3000000" step="10000" value="500000" />
          </div>
          <div class="tool-field">
            <label>Number of children (heirs)</label>
            <div class="tool-seg" id="ds-enf">
              <button data-n="1">1</button>
              <button class="on" data-n="2">2</button>
              <button data-n="3">3</button>
              <button data-n="4">4</button>
              <button data-n="5">5</button>
            </div>
          </div>
          <p class="tool-note">Direct-line transfer (parent to children), in equal shares. Allowance of 100,000 € per child, official 2026 scale. Excludes the surviving spouse (exempt), gifts made in the last 15 years, and special cases (usufruct, disability, etc.).</p>
        </div>

        <div class="tool-result">
          <p class="lbl">Inheritance tax due</p>
          <p class="big" id="ds-total">—</p>
          <div class="tool-brk"><span class="k">Total allowance applied</span><span class="v" id="ds-abat">—</span></div>
          <div class="tool-brk"><span class="k">Tax per child</span><span class="v" id="ds-parenf">—</span></div>
          <div class="tool-brk"><span class="k">Net amount actually received per child</span><span class="v" id="ds-net">—</span></div>
          <div class="tool-brk"><span class="k">Effective rate on the estate</span><span class="v" id="ds-taux">—</span></div>
        </div>
      </div>
    </div>

    <div class="max-w-prose-wide mt-14 prose-editorial">
      <h2>The lever almost no one pulls in time</h2>
      <p>Each child benefits from an allowance of <strong>100,000 €</strong> on what they receive. Beyond that, the scale rises quickly: 20% from 16,000 € of taxable amount, up to 45%. On a substantial estate, the bill can reach several hundred thousand euros.</p>
      <p>The good news: this allowance <strong>renews every 15 years</strong> for gifts. Giving during your lifetime, at the right pace and with the right tools (gifting, split ownership, life insurance (assurance-vie)), can often significantly reduce, or even eliminate, the tax to come. But it has to be planned early.</p>
      <p>That is exactly the work we do: turning a bill you simply endure into a strategy you choose.</p>
    </div>
  </div>

  <CTA />
</Base>

<script is:inline>
  (function () {
    const eur = n => Math.round(n).toLocaleString('fr-FR') + ' €';
    function droits(t){
      return Math.min(t,8072)*0.05
        + Math.max(0,Math.min(t,12109)-8072)*0.10
        + Math.max(0,Math.min(t,15932)-12109)*0.15
        + Math.max(0,Math.min(t,552324)-15932)*0.20
        + Math.max(0,Math.min(t,902838)-552324)*0.30
        + Math.max(0,Math.min(t,1805677)-902838)*0.40
        + Math.max(0,t-1805677)*0.45;
    }
    let nb=2;
    function calc(){
      const pat=+document.getElementById('ds-pat').value;
      const part=pat/nb;
      const taxable=Math.max(0,part-100000);
      const dEnf=droits(taxable);
      const dTot=dEnf*nb;
      document.getElementById('ds-pat-val').textContent=eur(pat);
      document.getElementById('ds-total').textContent=eur(dTot);
      document.getElementById('ds-abat').textContent=eur(100000*nb);
      document.getElementById('ds-parenf').textContent=eur(dEnf);
      document.getElementById('ds-net').textContent=eur(part-dEnf);
      document.getElementById('ds-taux').textContent=(pat>0?(dTot/pat*100):0).toFixed(1).replace('.',',')+' %';
    }
    function init(){
      const r=document.getElementById('ds-pat'); if(!r||r.dataset.ready) return; r.dataset.ready='1';
      r.addEventListener('input',calc);
      document.querySelectorAll('#ds-enf button').forEach(b=>b.addEventListener('click',()=>{
        document.querySelectorAll('#ds-enf button').forEach(x=>x.classList.remove('on'));
        b.classList.add('on'); nb=+b.dataset.n; calc();
      }));
      calc();
    }
    init();
    if(!window['__hk_ds-pat']){window['__hk_ds-pat']=1;document.addEventListener('astro:page-load',init);}
  })();
</script>
