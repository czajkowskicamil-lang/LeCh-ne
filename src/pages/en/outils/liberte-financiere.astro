---
import Base from '../../../layouts/Base.astro';
import CTA from '../../../components/CTA.astro';

const title = "At What Age Will You Be Free? Financial Independence Calculator | Le Chêne Patrimonial";
const description = "Calculate your freedom number and the age at which your savings will let you live without depending on a salary. Free, confidential, no sign-up required.";
---

<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.lechenepatrimonial.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.lechenepatrimonial.com/en/outils' },
        { '@type': 'ListItem', position: 3, name: 'At what age will you be free?', item: 'https://www.lechenepatrimonial.com/en/outils/liberte-financiere' },
      ]},
      { '@type': 'WebApplication', name: 'At what age will you be free?', applicationCategory: 'FinanceApplication',
        operatingSystem: 'Web', url: 'https://www.lechenepatrimonial.com/en/outils/liberte-financiere',
        description: "Free financial independence calculator: work out your freedom number and the age at which your savings will let you live without depending on a salary.",
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
        provider: { '@id': 'https://www.lechenepatrimonial.com/#organization' } },
    ],
  })} />
  <header class="pt-16 pb-8 md:pt-24 md:pb-10">
    <div class="shell max-w-4xl">
      <nav class="text-xs uppercase tracking-micro text-stone mb-10 flex gap-3" aria-label="Breadcrumb">
        <a href="/en/" class="hover:text-chene">Home</a>
        <span>/</span>
        <a href="/en/outils" class="hover:text-chene">Tools</a>
        <span>/</span>
        <span class="text-ink">Financial independence</span>
      </nav>
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Financial independence · For everyone
      </p>
      <h1 class="font-serif text-display text-ink mb-6 leading-tight">At what age will you be free?</h1>
      <p class="text-xl text-ink/75 max-w-prose-wide leading-relaxed">
        Being free is the day your wealth lets you live <em class="text-chene not-italic font-medium">without depending on a salary</em>. Discover your freedom number, the age at which you'll reach it at your current pace, and the path to get there sooner.
      </p>
    </div>
  </header>

  <div class="shell max-w-5xl pb-16">
    <div class="tool-card">
      <div class="tool-grid">
        <div>
          <div class="tool-field">
            <label>Your age today <b id="lf-age-val">35 years old</b></label>
            <input class="tool-range" type="range" id="lf-age" min="20" max="65" step="1" value="35" />
          </div>
          <div class="tool-field">
            <label>Your net income, per month <b id="lf-rev-val">€4,000</b></label>
            <input class="tool-range" type="range" id="lf-rev" min="1200" max="25000" step="100" value="4000" />
            <span class="lf-hint">Salary, business income: whatever comes in net each month.</span>
          </div>
          <div class="tool-field">
            <label>What you spend to live, per month <b id="lf-dep-val">€2,800</b></label>
            <input class="tool-range" type="range" id="lf-dep" min="800" max="18000" step="100" value="2800" />
            <span class="lf-hint">Housing, everyday life, family, pleasures. This is the amount your wealth alone will need to cover.</span>
          </div>
          <div class="tool-field">
            <label>Savings and wealth already built <b id="lf-epa-val">€30,000</b></label>
            <input class="tool-range" type="range" id="lf-epa" min="0" max="2000000" step="5000" value="30000" />
            <span class="lf-hint">Everything you've already set aside: savings accounts, life insurance (assurance-vie), rental property.</span>
          </div>
          <div class="tool-field">
            <label>Annual return on your investments <b id="lf-rdt-val">4.0%</b></label>
            <input class="tool-range" type="range" id="lf-rdt" min="2" max="7" step="0.5" value="4" />
            <span class="lf-hint">What a well-invested capital yields on average each year. A cautious assumption, not a promise.</span>
          </div>
          <p class="tool-note">Indicative, educational estimate based solely on the information entered. Your freedom number is the sum that, at a prudent withdrawal rate of 3.5%/year, covers your expenses on its own. Excludes inflation and detailed taxation. This does not constitute personalised advice or a recommendation on financial instruments. Le Chêne Patrimonial acts as an insurance broker and real estate intermediary.</p>
        </div>

        <div class="tool-result">
          <p class="lbl">Your freedom number</p>
          <p class="big" id="lf-cible">—</p>
          <p class="lf-sub">The sum that, well invested, lets you live without depending on a salary.</p>

          <div class="lf-free">
            <span class="lf-free-k">At your current pace, you're free at</span>
            <span class="lf-free-v" id="lf-age-libre">—</span>
          </div>

          <div class="lf-timeline">
            <div class="lf-tl-track"><div class="lf-tl-fill" id="lf-tl-fill"></div></div>
            <div class="lf-tl-marker" id="lf-tl-marker"><span class="lf-tl-dot"></span><span class="lf-tl-lab" id="lf-tl-lab">free</span></div>
            <div class="lf-tl-ends"><span id="lf-tl-start">today</span><span>age 90</span></div>
          </div>

          <div class="lf-progress">
            <div class="lf-progress-top"><span>Already on the way to your freedom</span><span id="lf-prog-pct">—</span></div>
            <div class="lf-progress-track"><div class="lf-progress-fill" id="lf-prog-fill"></div></div>
          </div>

          <div class="tool-brk"><span class="k">What you need to live</span><span class="v" id="lf-besoin">—</span></div>
          <div class="tool-brk"><span class="k">What you set aside / month</span><span class="v" id="lf-eff">—</span></div>
          <div class="tool-brk"><span class="k">Years until your freedom</span><span class="v" id="lf-annees">—</span></div>
          <p class="lf-verdict" id="lf-verdict">—</p>
          <details class="lf-method">
            <summary>How this result is calculated</summary>
            <ul>
              <li>Your freedom number = what you spend to live each year, divided by a <b>prudent withdrawal rate of 3.5%/year</b> (sustainable withdrawal rule).</li>
              <li>The age of freedom = the year your savings, assuming you keep setting aside what you do today, reach this amount.</li>
              <li>Growth assumes your <b>targeted return</b>, compounded. Excludes inflation and detailed taxation.</li>
            </ul>
          </details>
        </div>
      </div>
    </div>

    <div id="lf-lead" class="mt-10 rounded-none border border-ink/10 bg-cream-soft p-6 md:p-8">
      <h3 class="font-serif text-xl text-ink mb-1.5">Receive your financial freedom plan as a PDF</h3>
      <p class="text-sm text-ink/60 mb-5 leading-relaxed">Enter your details to receive your detailed report. Camil Czajkowski will get back to you to discuss it, with no obligation. Your data is never sold.</p>
      <form id="lf-lead-form" class="space-y-3.5" novalidate>
        <div class="grid sm:grid-cols-2 gap-3.5">
          <input name="prenom" required placeholder="First name" class="w-full rounded-lg border border-ink/15 bg-white px-4 py-2.5 text-ink placeholder:text-stone/60 focus:border-chene focus:outline-none" />
          <input name="nom" required placeholder="Last name" class="w-full rounded-lg border border-ink/15 bg-white px-4 py-2.5 text-ink placeholder:text-stone/60 focus:border-chene focus:outline-none" />
        </div>
        <input name="email" type="email" required placeholder="Email address" class="w-full rounded-lg border border-ink/15 bg-white px-4 py-2.5 text-ink placeholder:text-stone/60 focus:border-chene focus:outline-none" />
        <input name="telephone" type="tel" required placeholder="Phone number" class="w-full rounded-lg border border-ink/15 bg-white px-4 py-2.5 text-ink placeholder:text-stone/60 focus:border-chene focus:outline-none" />
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <label class="flex items-start gap-2.5 text-xs text-ink/60 cursor-pointer">
          <input type="checkbox" name="consent" required class="mt-0.5 accent-chene" />
          <span>I agree that Le Chêne Patrimonial may collect and process this information (name, email, phone, calculator responses) in order to send me my report and contact me about it. <a href="/en/confidentialite" class="underline hover:text-ink" target="_blank">Privacy policy</a>.</span>
        </label>
        <label class="flex items-start gap-2.5 text-xs text-ink/60 cursor-pointer">
          <input type="checkbox" name="optin" class="mt-0.5 accent-chene" />
          <span>I would also like to receive The Oak Letter (optional, unsubscribe at any time).</span>
        </label>
        <button type="submit" class="btn-primary w-full justify-center py-3"><span class="lf-lead-btn-label">Get my plan (PDF)</span></button>
        <p class="text-[11px] text-ink/45 text-center leading-relaxed">Data controller: Le Chêne Patrimonial. Data retained for the duration of the business relationship, never sold.</p>
        <p id="lf-lead-msg" class="text-sm text-center hidden"></p>
      </form>
    </div>

    <div class="max-w-prose-wide mt-14 prose-editorial">
      <h2>Financial freedom isn't a dream, it's a calculation</h2>
      <p>Most people work without knowing what number they're working towards. Yet it exists: it's the capital that, well invested, generates enough income to cover your lifestyle without you having to work. Here, we call it your <strong>freedom number</strong>.</p>
      <p>Knowing it changes everything: you stop saving "at random" and instead aim for a defined target, by a defined date. And above all, you discover the three levers that bring that date closer: what you spend, what you set aside, and how you invest it. This is exactly the work I do with the people I support.</p>
    </div>
  </div>

  <CTA
    title="Your financial freedom starts now."
    body="This calculator sets the course. Together, we turn it into a concrete strategy: wrappers, allocation, tax planning. A first 30-minute conversation, with no obligation."
  />

  <style is:global>
  .lf-sub { font-size: .82rem; color: #9fb0c8; margin: -6px 0 18px; }
  .lf-hint { display: block; font-size: .74rem; line-height: 1.45; color: #8a8574; margin-top: 6px; }
  .lf-free { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 0 0 18px; padding: 14px 16px; background: rgba(230,194,89,.09); border: 1px solid rgba(230,194,89,.22); border-radius: 10px; }
  .lf-free-k { font-size: .82rem; color: #cbd5e6; }
  .lf-free-v { font-family: Georgia, serif; font-weight: 700; color: #E6C259; font-size: 1.5rem; white-space: nowrap; }
  .lf-timeline { margin: 0 0 22px; }
  .lf-tl-track { position: relative; height: 8px; border-radius: 100px; background: rgba(255,255,255,.10); overflow: hidden; }
  .lf-tl-fill { height: 100%; width: 0; border-radius: 100px; background: linear-gradient(90deg,#3a5f86,#5a82ad); transition: width .5s cubic-bezier(.16,1,.3,1); }
  .lf-tl-marker { position: relative; height: 26px; margin-top: -13px; }
  .lf-tl-dot { position: absolute; top: 0; left: 0; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: #E6C259; border: 2px solid #03102E; box-shadow: 0 0 0 3px rgba(230,194,89,.25); transition: left .5s cubic-bezier(.16,1,.3,1); }
  .lf-tl-lab { position: absolute; top: 18px; left: 0; transform: translateX(-50%); font-size: .66rem; letter-spacing: .04em; text-transform: uppercase; color: #E6C259; white-space: nowrap; transition: left .5s cubic-bezier(.16,1,.3,1); }
  .lf-tl-ends { display: flex; justify-content: space-between; font-size: .7rem; color: #9fb0c8; margin-top: 26px; }
  .lf-progress { margin: 0 0 22px; }
  .lf-progress-top { display: flex; justify-content: space-between; align-items: baseline; font-size: .78rem; color: #EDE7DA; margin-bottom: 7px; }
  .lf-progress-top span:last-child { font-family: Georgia, serif; font-weight: 700; color: #E6C259; font-size: .95rem; }
  .lf-progress-track { height: 8px; border-radius: 100px; background: rgba(255,255,255,.1); overflow: hidden; }
  .lf-progress-fill { height: 100%; width: 0; border-radius: 100px; background: linear-gradient(90deg,#D4A82D,#E6C259); transition: width .5s cubic-bezier(.16,1,.3,1); }
  .lf-verdict { font-size: .9rem; line-height: 1.5; margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.12); color: #EDE7DA; }
  .lf-verdict.on-track { color: #a9e0bd; }
  .lf-verdict.effort { color: #f2d38a; }
  .lf-method { margin-top: 16px; border-top: 1px solid rgba(255,255,255,.12); padding-top: 14px; }
  .lf-method summary { font-size: .78rem; color: #cbd5e6; cursor: pointer; list-style: none; display: flex; align-items: center; gap: 7px; }
  .lf-method summary::-webkit-details-marker { display: none; }
  .lf-method summary::before { content: "+"; color: #E6C259; font-weight: 700; width: 12px; text-align: center; }
  .lf-method[open] summary::before { content: "\2013"; }
  .lf-method ul { margin: 12px 0 2px; padding-left: 0; list-style: none; display: flex; flex-direction: column; gap: 9px; }
  .lf-method li { position: relative; padding-left: 16px; font-size: .76rem; line-height: 1.5; color: #b9c4d6; }
  .lf-method li::before { content: ""; position: absolute; left: 0; top: .5em; width: 5px; height: 5px; border-radius: 50%; background: #E6C259; }
  .lf-method b { color: #EDE7DA; font-weight: 600; }
</style>

<script is:inline>
  (function () {
    const eur = n => '€' + Math.round(n).toLocaleString('en-GB');
    const TAUX_RETRAIT = 0.035;
    const CALENDLY = 'https://calendly.com/camil-cz-lechenepatrimonial/30min';
    let state = {};

    function calc(){
      const age=+document.getElementById('lf-age').value, rev=+document.getElementById('lf-rev').value,
        dep=+document.getElementById('lf-dep').value, epa=+document.getElementById('lf-epa').value,
        rdt=+document.getElementById('lf-rdt').value;

      document.getElementById('lf-age-val').textContent=age+' years old';
      document.getElementById('lf-rev-val').textContent=eur(rev);
      document.getElementById('lf-dep-val').textContent=eur(dep);
      document.getElementById('lf-epa-val').textContent=eur(epa);
      document.getElementById('lf-rdt-val').textContent=rdt.toFixed(1)+'%';
      document.getElementById('lf-tl-start').textContent="today ("+age+" years old)";

      const r=rdt/100;
      const depA=dep*12, cible=depA/TAUX_RETRAIT;
      const capaciteM=Math.max(0, rev-dep), saveA=capaciteM*12;

      // Simulation année par année : quand l'épargne atteint la cible.
      let cap=epa, free=null;
      for(let a=age; a<=100; a++){
        if(free===null && cap>=cible){ free=a; break; }
        cap = cap*(1+r) + saveA;
      }
      const dejaLibre = epa>=cible;
      const annees = free!==null ? Math.max(0, free-age) : null;

      document.getElementById('lf-cible').textContent = eur(cible);
      document.getElementById('lf-age-libre').textContent = dejaLibre ? 'already free' : (free!==null ? free+' years old' : 'beyond 90');

      // Frise : position du marqueur entre l'âge actuel et 90 ans.
      const span = Math.max(1, 90-age);
      let pos = free!==null ? (free-age)/span*100 : 100;
      pos = Math.max(0, Math.min(100, pos));
      document.getElementById('lf-tl-fill').style.width = pos+'%';
      document.getElementById('lf-tl-marker').querySelector('.lf-tl-dot').style.left = pos+'%';
      const lab = document.getElementById('lf-tl-lab');
      lab.style.left = Math.max(11, Math.min(89, pos))+'%';
      lab.textContent = dejaLibre ? 'free' : (free!==null ? 'free at '+free : 'after 90');

      // Progression : épargne actuelle vs cible.
      const prog = cible>0 ? Math.max(0, Math.min(100, epa/cible*100)) : 100;
      document.getElementById('lf-prog-pct').textContent = Math.round(prog)+'%';
      document.getElementById('lf-prog-fill').style.width = prog+'%';

      document.getElementById('lf-besoin').textContent = eur(depA)+' / year';
      document.getElementById('lf-eff').textContent = eur(capaciteM)+' / month';
      document.getElementById('lf-annees').textContent = dejaLibre ? '0 years' : (annees!==null ? annees+' years' : 'over 55 years');

      const v=document.getElementById('lf-verdict');
      v.classList.remove('on-track','effort');
      if(dejaLibre){
        v.textContent = "Your wealth already lets you live without a salary: you are financially free. The challenge now is to protect this capital, optimise it for tax, and prepare its transmission.";
        v.classList.add('on-track');
      } else if(capaciteM<=0){
        v.textContent = "You're not generating any savings today: the first step is to create a gap between your income and your spending. That's where it all begins, and it's at the heart of what I help clients with.";
        v.classList.add('effort');
      } else if(free!==null && annees<=15){
        v.textContent = "You're on a strong trajectory: free at "+free+" at your current pace. Well invested, this capital could even get you there sooner.";
        v.classList.add('on-track');
      } else {
        v.textContent = "Freedom is achievable, but distant at your current pace. We can bring it closer by acting on three levers: your spending, your savings effort, and how you invest it. This is exactly what we build together.";
        v.classList.add('effort');
      }

      state = { age, revenuMensuel:rev, depensesMensuel:dep, epargne:epa, rendement:rdt,
        capitalLiberte:Math.round(cible), depensesAnnuel:Math.round(depA),
        ageLiberte: dejaLibre ? 'already free' : (free!==null ? (free+' years old') : 'beyond 90'),
        anneesRestantes: dejaLibre ? 0 : annees, capaciteMensuelle:Math.round(capaciteM),
        progression:Math.round(prog), verdict: v.textContent };
    }

    function init(){
      const g=document.getElementById('lf-age'); if(!g||g.dataset.ready) return; g.dataset.ready='1';
      ['lf-age','lf-rev','lf-dep','lf-epa','lf-rdt'].forEach(id=>document.getElementById(id).addEventListener('input',calc));
      calc();

      const form=document.getElementById('lf-lead-form');
      if(form){
        const msg=document.getElementById('lf-lead-msg');
        const btnLabel=document.querySelector('.lf-lead-btn-label');
        const showMsg=(t,ok)=>{msg.textContent=t;msg.className='text-sm text-center '+(ok?'text-chene':'text-[#b4472e]');msg.classList.remove('hidden');};
        const downloadPdf=async()=>{try{const res=await fetch('/api/liberte-financiere-lead',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:'pdf',prenom:form.prenom.value,nom:form.nom.value,data:state})});if(!res.ok)throw 0;const b=await res.blob();const u=URL.createObjectURL(b);const a=document.createElement('a');a.href=u;a.download='liberte-financiere-le-chene.pdf';document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(u);}catch(e){}};
        form.addEventListener('submit',async(e)=>{
          e.preventDefault();
          const fd=new FormData(form);
          if(!fd.get('prenom')||!fd.get('nom')||!fd.get('email')){showMsg('Please fill in your details.',false);return;}
          if(!fd.get('telephone')){showMsg("Please provide a phone number.",false);return;}
          if(!fd.get('consent')){showMsg('Your consent is required to receive the report.',false);return;}
          btnLabel.textContent='Sending...';
          try{
            const res=await fetch('/api/liberte-financiere-lead',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({prenom:fd.get('prenom'),nom:fd.get('nom'),email:fd.get('email'),telephone:fd.get('telephone'),consent:!!fd.get('consent'),optin:!!fd.get('optin'),website:fd.get('website'),data:state})});
            const data=await res.json().catch(()=>({}));
            if(res.ok&&data.ok){
              downloadPdf();
              const em=String(fd.get('email')||'');
              form.innerHTML='<div class="text-center py-4"><div class="mx-auto mb-3 w-12 h-12 rounded-full bg-chene/10 grid place-items-center text-chene"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4.5 4.5L19 7"/></svg></div><p class="font-serif text-xl text-ink mb-1">Your plan has been sent to you by email</p><p class="text-sm text-ink/60 mb-4">It\'s on its way to <strong class="text-ink">'+em+'</strong> (check your spam folder just in case). Camil will get back to you very soon.</p><button id="lf-pdf-again" class="btn-ghost text-sm">Also download it now</button><div class="mt-5"><a href="'+CALENDLY+'" target="_blank" rel="noopener" class="btn-primary">Choose a time with Camil</a></div></div>';
              const again=form.querySelector('#lf-pdf-again'); if(again) again.onclick=downloadPdf;
            } else { showMsg('Something went wrong. Please try again or contact us directly.',false); btnLabel.textContent='Get my plan (PDF)'; }
          }catch(err){ showMsg('Connection failed. Please try again in a moment.',false); btnLabel.textContent='Get my plan (PDF)'; }
        });
      }
    }
    init();
    if(!window['__hk_lf-age']){window['__hk_lf-age']=1;document.addEventListener('astro:page-load',init);}
  })();
</script>
</Base>
