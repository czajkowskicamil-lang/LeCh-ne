---
import Base from '../../../layouts/Base.astro';
import CTA from '../../../components/CTA.astro';

const title = "Notary Fees Calculator 2026 (Existing and New-Build) | Le Chêne Patrimonial";
const description = "Estimate your notary fees for free when buying property, existing or new-build: transfer duties, notary's fee, disbursements. Instant result.";
---

<Base title={title} description={description}>
  <header class="pt-16 pb-8 md:pt-24 md:pb-10">
    <div class="shell max-w-4xl">
      <nav class="text-xs uppercase tracking-micro text-stone mb-10 flex gap-3" aria-label="Breadcrumb">
        <a href="/en" class="hover:text-chene">Home</a>
        <span>/</span>
        <a href="/en/outils" class="hover:text-chene">Tools</a>
        <span>/</span>
        <span class="text-ink">Notary Fees</span>
      </nav>
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Property Purchase
      </p>
      <h1 class="font-serif text-display text-ink mb-6 leading-tight">Calculate your notary fees</h1>
      <p class="text-xl text-ink/75 max-w-prose-wide leading-relaxed">
        The famous "notary fees" are mostly taxes. Estimate them in two clicks, for existing or new-build property, before you sign.
      </p>
    </div>
  </header>

  <div class="shell max-w-5xl pb-16">
    <div class="tool-card">
      <div class="tool-grid">
        <div>
          <div class="tool-field">
            <label>Property type</label>
            <div class="tool-seg" id="fn-type">
              <button class="on" data-t="ancien">Existing</button>
              <button data-t="neuf">New-build (VEFA)</button>
            </div>
          </div>
          <div class="tool-field">
            <label>Property price <b id="fn-prix-val">250 000 €</b></label>
            <input class="tool-range" type="range" id="fn-prix" min="50000" max="1500000" step="5000" value="250000" />
          </div>
          <p class="tool-note">Indicative estimate for a residential property. Transfer duties vary slightly by department (standard rate used here). Deductible furniture is not taken into account.</p>
        </div>

        <div class="tool-result">
          <p class="lbl">Estimated notary fees</p>
          <p class="big" id="fn-total">—</p>
          <div class="tool-brk"><span class="k">Transfer duties (taxes)</span><span class="v" id="fn-droits">—</span></div>
          <div class="tool-brk"><span class="k">Notary's fee</span><span class="v" id="fn-emol">—</span></div>
          <div class="tool-brk"><span class="k">Land registration + disbursements</span><span class="v" id="fn-autres">—</span></div>
          <div class="tool-brk"><span class="k">As a share of the property price</span><span class="v" id="fn-pct">—</span></div>
          <div class="tool-brk"><span class="k">Total budget (property + fees)</span><span class="v" id="fn-budget">—</span></div>
        </div>
      </div>
    </div>

    <div class="max-w-prose-wide mt-14 prose-editorial">
      <h2>Why these fees, and what are they for?</h2>
      <p>Contrary to popular belief, the notary keeps only a small part of these fees. The bulk of it is made up of <strong>taxes passed on to the State and local authorities</strong> (transfer duties). Next come the notary's fees, set by a national scale, then disbursements (costs advanced on your behalf).</p>
      <p>For <strong>new-build</strong> property, these fees are much lower (around 2 to 3% versus 7 to 8% for existing property), because the land registration tax is reduced. A point worth factoring into any purchase decision.</p>
    </div>
  </div>

  <CTA />
</Base>

<script is:inline>
  (function () {
    function emolHT(p){
      return Math.min(p,6500)*0.03870
        + Math.max(0,Math.min(p,17000)-6500)*0.01596
        + Math.max(0,Math.min(p,60000)-17000)*0.01064
        + Math.max(0,p-60000)*0.00799;
    }
    const eur = n => Math.round(n).toLocaleString('fr-FR') + ' €';
    let type='ancien';
    function calc(){
      const p = +document.getElementById('fn-prix').value;
      const droits = p * (type==='neuf' ? 0.00715 : 0.0580);
      const emol = emolHT(p) * 1.2;
      const autres = p*0.001 + 1000;
      const total = droits + emol + autres;
      document.getElementById('fn-prix-val').textContent = eur(p);
      document.getElementById('fn-total').textContent = eur(total);
      document.getElementById('fn-droits').textContent = eur(droits);
      document.getElementById('fn-emol').textContent = eur(emol);
      document.getElementById('fn-autres').textContent = eur(autres);
      document.getElementById('fn-pct').textContent = (total/p*100).toFixed(1).replace('.',',') + ' %';
      document.getElementById('fn-budget').textContent = eur(p+total);
    }
    function init(){
      const r=document.getElementById('fn-prix'); if(!r||r.dataset.ready) return; r.dataset.ready='1';
      r.addEventListener('input',calc);
      document.querySelectorAll('#fn-type button').forEach(b=>b.addEventListener('click',()=>{
        document.querySelectorAll('#fn-type button').forEach(x=>x.classList.remove('on'));
        b.classList.add('on'); type=b.dataset.t; calc();
      }));
      calc();
    }
    init();
    if(!window['__hk_fn-prix']){window['__hk_fn-prix']=1;document.addEventListener('astro:page-load',init);}
  })();
</script>
