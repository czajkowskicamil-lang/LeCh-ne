  .om-badge{display:inline-block;font-size:.8rem;font-weight:700;padding:4px 12px;border-radius:20px;margin-bottom:16px;}
  .om-b0{background:rgba(123,189,144,.18);color:#7bbd90;}.om-b1{background:rgba(230,194,89,.18);color:#E6C259;}.om-b2{background:rgba(217,154,63,.2);color:#d99a3f;}.om-b3{background:rgba(217,105,79,.2);color:#e08a70;}
  .om-row{display:flex;justify-content:space-between;align-items:center;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.07);}
  .om-row:last-child{border-bottom:none;}
  .om-row .k{color:#9fb0c8;font-size:.9rem;}
  .om-row .v{font-family:'Fraunces Variable',Fraunces,Georgia,serif;font-size:1.15rem;font-weight:600;}
  .om-row .v.pos{color:#7bbd90;}.om-row .v.neg{color:#e08a70;}.om-row .v.neu{color:#F5F1E8;}
  .om-hint{color:#7a8aa3;font-style:italic;}
  .om-legend{display:flex;gap:16px;flex-wrap:wrap;margin-top:16px;font-size:.78rem;color:#9fb0c8;}
  .om-legend span{display:inline-flex;align-items:center;gap:7px;}
  .om-legend .om-dot{width:11px;height:11px;border-radius:50%;display:block;}
  .om-note{color:#6f7f98;font-size:.75rem;margin-top:18px;}
</style>

