    position: sticky; top: 0; background: #FAF7EF; text-align: right; font-size: .68rem;
    letter-spacing: .05em; text-transform: uppercase; color: #7A7566; font-weight: 700;
    padding: 12px 12px; border-bottom: 2px solid rgba(3,16,46,.12); white-space: nowrap; font-family: 'Inter Variable', Inter, sans-serif;
  }
  #obs-tbl thead th:nth-child(1), #obs-tbl thead th:nth-child(2) { text-align: left; }
  #obs-tbl thead th[data-k] { cursor: pointer; }
  #obs-tbl thead th[data-k]:hover { color: #A7801F; }
  #obs-tbl tbody td { padding: 10px 12px; border-bottom: 1px solid rgba(3,16,46,.08); text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  #obs-tbl tbody td.obs-city { text-align: left; font-weight: 600; color: #03102E; font-family: 'Fraunces Variable', Fraunces, serif; font-size: .95rem; }
  #obs-tbl tbody td.obs-rank { text-align: left; color: #7A7566; width: 30px; }
  #obs-tbl tbody tr:hover { background: rgba(212,168,45,.06); }
  #obs-tbl .obs-dom { color: #A7801F; font-size: .68rem; }
  .obs-pill { display: inline-block; padding: 2px 8px; border-radius: 7px; font-weight: 600; min-width: 50px; font-variant-numeric: tabular-nums; }
  .obs-g { background: #e2ebdf; color: #2D4A33; }
  .obs-r { background: #f4ddd3; color: #B0442F; }
  .obs-w { background: #f3e7cf; color: #6E5414; }
  .obs-n { color: #7A7566; }
  .obs-alert { display: inline-block; padding: 2px 10px; border-radius: 20px; font-weight: 700; font-size: .78rem; font-variant-numeric: tabular-nums; }
  .obs-a0 { background: #e2ebdf; color: #2D4A33; }
  .obs-a1 { background: rgba(122,117,102,.16); color: #504B3F; }
  .obs-a2 { background: #f3e7cf; color: #6E5414; }
  .obs-a3 { background: #f4ddd3; color: #B0442F; }
</style>

