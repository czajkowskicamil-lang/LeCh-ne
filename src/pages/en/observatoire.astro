      [29,"Annecy",0,4.1,20.4,7.3,5.1,"5 180",3.7,0],[30,"Limoges",0,-1.7,22.7,9.2,7.6,"1 611",8.7,0],
      [31,"Metz",0,5.3,17.5,11.0,7.7,"2 358",7.1,0],[32,"Perpignan",0,1.2,23.0,14.6,12.7,"1 794",7.7,0],
      [33,"Boulogne-Billancourt",0,-0.9,17.4,7.2,7.8,"8 287",3.9,0],[34,"Besançon",0,2.2,18.8,9.5,6.7,"2 473",6.3,0],
      [35,"Rouen",0,6.8,14.4,9.7,9.1,"2 543",6.1,0],[36,"Orléans",0,-0.3,16.8,10.3,7.6,"2 577",6.7,0],
      [37,"Montreuil",0,1.9,13.0,5.5,7.8,"6 459",4.5,0],[38,"Caen",0,3.8,18.9,8.9,7.6,"3 131",5.4,0],
      [39,"Saint-Paul",0,3.4,14.7,9.4,18.1,"5 220",5.1,1],[40,"Argenteuil",0,-3.7,13.6,6.1,7.8,"3 323",6.9,0]
    ];
    const num = s => parseFloat((""+s).replace(/\s/g,"").replace(",","."));
    const pct = v => (v>0?"+":"")+(""+v).replace(".",",")+" %";
    const demoC = v => v>=3?"obs-g":(v<=-1?"obs-r":"obs-n");
    const seniorC = v => v>=20?"obs-r":(v<14?"obs-g":"obs-n");
    const vacC = v => v>=10?"obs-r":(v<=6.5?"obs-g":"obs-n");
    const chomC = v => v<=7?"obs-g":(v>=9.5?"obs-r":"obs-w");
    const yieldC = v => v>=7?"obs-g":(v<4.5?"obs-r":"obs-n");
    const score = r => (r[4]>=20?1:0)+(r[5]>=10?1:0)+(r[3]<=0?1:0);
    let asc = {};

    function render(rows, tb) {
      tb.innerHTML = "";
      rows.forEach(r => {
        const sc = score(r);
        const tr = document.createElement("tr");
        tr.innerHTML =
          '<td class="obs-rank">'+r[0]+'</td>'+
          '<td class="obs-city">'+r[1]+(r[9]?' <span class="obs-dom">DOM</span>':'')+'</td>'+
          '<td><span class="obs-pill '+demoC(r[3])+'">'+pct(r[3])+'</span></td>'+
          '<td><span class="obs-pill '+seniorC(r[4])+'">'+(""+r[4]).replace(".",",")+' %</span></td>'+
          '<td><span class="obs-pill '+vacC(r[5])+'">'+(""+r[5]).replace(".",",")+' %</span></td>'+
          '<td><span class="obs-pill '+chomC(r[6])+'">'+(""+r[6]).replace(".",",")+' %</span></td>'+
          '<td>'+r[7]+'</td>'+
          '<td><span class="obs-pill '+yieldC(r[8])+'">'+(""+r[8]).replace(".",",")+' %</span></td>'+
          '<td><span class="obs-alert obs-a'+sc+'">'+sc+'/3</span></td>';
        tb.appendChild(tr);
      });
    }

    function init() {
      const tbl = document.getElementById("obs-tbl");
      if (!tbl || tbl.dataset.ready) return;
      tbl.dataset.ready = "1";
      const tb = tbl.querySelector("tbody");
      render(data, tb);
      tbl.querySelectorAll("thead th[data-k]").forEach(th => {
        const k = +th.dataset.k, isNum = th.dataset.num;
        th.addEventListener("click", () => {
          asc[k] = !asc[k];
          const sorted = [...data].sort((a,b) => {
            let x = a[k], y = b[k];
            if (isNum) { x = num(x); y = num(y); }
            return (x>y?1:x<y?-1:0)*(asc[k]?1:-1);
          });
          render(sorted, tb);
        });
      });
    }

    init();
    document.addEventListener("astro:page-load", () => {
      const t = document.getElementById("obs-tbl");
      if (t) t.dataset.ready = "";
      init();
    });
  })();
</script>

<style is:global>
  .om-card{background:#0c1f3c;border:1px solid rgba(212,168,45,.25);border-radius:20px;padding:clamp(22px,4vw,36px);color:#F5F1E8;}
