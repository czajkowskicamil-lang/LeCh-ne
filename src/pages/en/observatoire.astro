  @media(max-width:820px){.om-grid{grid-template-columns:1fr;}}
  #om-map{display:block;width:100%;height:auto;}
  .om-outline{fill:#102847;stroke:#D4A82D;stroke-width:1.2;opacity:.85;}
  .om-city{stroke:#0c1f3c;stroke-width:1.4;cursor:pointer;transition:r .15s;}
  .om-city:hover{r:8;}
  .om-city.sel{stroke:#F5F1E8;stroke-width:2.5;}
  .om-clbl{font:600 12px system-ui,sans-serif;fill:#eef1f6;pointer-events:none;}
  .om-lo{fill:#7bbd90;} .om-mid{fill:#E6C259;} .om-hi{fill:#d99a3f;} .om-max{fill:#d9694f;}
  .om-panel{background:#102847;border:1px solid rgba(212,168,45,.2);border-radius:16px;padding:24px;min-height:340px;}
