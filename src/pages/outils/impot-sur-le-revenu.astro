<script is:inline>
  (function(){
    var TRANCHES=[{min:0,max:11600,rate:0},{min:11600,max:29579,rate:0.11},{min:29579,max:84577,rate:0.30},{min:84577,max:181917,rate:0.41},{min:181917,max:Infinity,rate:0.45}];
    var PLAFOND_DEMIPART=1807, ABAT_MAX=14555, ABAT_MIN=509;
    var DECOTE_SEUIL_S=1982, DECOTE_SEUIL_C=3277, DECOTE_HAUT_S=897, DECOTE_HAUT_C=1483, DECOTE_TAUX=0.4525, SEUIL_RECOUVREMENT=61;
    var eur=function(n){return Math.round(n).toLocaleString('fr-FR')+' €';};
    var pct=function(n){return (Math.round(n*10)/10).toLocaleString('fr-FR')+' %';};
    function taxParPart(q){var t=0;for(var i=0;i<TRANCHES.length;i++){var tr=TRANCHES[i];if(q>tr.min)t+=(Math.min(q,tr.max)-tr.min)*tr.rate;}return t;}
    function tmiRate(q){var r=0;for(var i=0;i<TRANCHES.length;i++)if(q>TRANCHES[i].min)r=TRANCHES[i].rate;return r;}
    function calcul(revenu,p,baseParts,decoteCouple){
      var dsup=Math.round((p-baseParts)/0.5), qf=revenu/p;
      var full=taxParPart(qf)*p, bas=taxParPart(revenu/baseParts)*baseParts;
      var av=bas-full, pl=PLAFOND_DEMIPART*dsup, iad=full, plaf=false;
      if(dsup>0&&av>pl){iad=bas-pl;plaf=true;}
      var seuil=decoteCouple?DECOTE_SEUIL_C:DECOTE_SEUIL_S, haut=decoteCouple?DECOTE_HAUT_C:DECOTE_HAUT_S, dec=0;
      if(iad<seuil){dec=Math.max(0,haut-DECOTE_TAUX*iad);dec=Math.min(dec,iad);}
      var net=iad-dec, rec=net>=SEUIL_RECOUVREMENT;
      return {parts:p,qf:qf,full:full,iad:iad,plaf:plaf,plafond:pl,dec:dec,net:rec?net:0,rec:rec,tmi:tmiRate(qf),moyen:revenu>0?((rec?net:0)/revenu*100):0};
    }

    var statut='single', kids=0, isole=false, fraisMode='forfait', last=null, lastCtx=null;

    function parseNum(v){return parseInt((v||'').replace(/[^0-9]/g,''),10)||0;}
    function $(id){return document.getElementById(id);}

    function foyerParts(){
      var couple=statut==='couple', veufFam=statut==='veuf'&&kids>0;
      var base=(couple||veufFam)?2:1;
      var enf=Math.min(kids,2)*0.5+Math.max(0,kids-2)*1;
      var iso=isole&&kids>0&&(statut==='single'||statut==='divorce');
      return {p:base+enf+(iso?0.5:0), base:base};
    }

    function bindMoney(id,cb){
      var el=$(id); if(!el)return;
      el.addEventListener('input',function(){
        var caret=this.selectionStart,len=this.value.length,n=parseNum(this.value);
        this.value=n?n.toLocaleString('fr-FR'):'';
        this.selectionStart=this.selectionEnd=Math.max(0,caret+(this.value.length-len));
        cb();
      });
    }

    function render(){
      var couple=statut==='couple', nbDecl=couple?2:1;
      var iw=$('imp-isole-wrap'); if(iw) iw.hidden=!(kids>0&&(statut==='single'||statut==='divorce'));
      var salaires=parseNum($('imp-salaires').value);
      var fraisPro;
      if(fraisMode==='reel'){fraisPro=parseNum($('imp-frais-reel').value);}
      else{fraisPro=Math.min(salaires*0.10,ABAT_MAX*nbDecl);fraisPro=Math.max(fraisPro,Math.min(ABAT_MIN*nbDecl,salaires));}
      var salNet=Math.max(0,salaires-fraisPro);
      var retraites=parseNum($('imp-retraites').value);
      var foncier=parseNum($('imp-foncier').value);
      var lmnp=parseNum($('imp-lmnp').value);
      var bic=parseNum($('imp-bic').value);
      var autres=parseNum($('imp-autres').value);
      var pension=parseNum($('imp-pension').value), per=parseNum($('imp-per').value);
      var immoDed=parseNum($('imp-immo-ded').value);
      var revenu=Math.max(0,Math.round(salNet+retraites+foncier+lmnp+bic+autres-pension-per-immoDed));
      var psSociaux=Math.round((Math.max(0,foncier)+Math.max(0,lmnp))*0.172);
      var fp=foyerParts(), r=calcul(revenu,fp.p,fp.base,couple);
      last=r; lastCtx={revenu:revenu,statut:statut,ps:psSociaux};

      var det=[];
      if(salaires>0) det.push('Salaires −frais '+(fraisMode==='reel'?'(réels)':'(10 %)')+' : '+eur(salNet));
      if(retraites>0) det.push('Retraites : '+eur(retraites));
      if(foncier>0) det.push('Foncier : '+eur(foncier));
      if(lmnp>0) det.push('LMNP : '+eur(lmnp));
      if(bic>0) det.push('BIC/BNC : '+eur(bic));
      if(autres>0) det.push('Autres : '+eur(autres));
      if(pension>0) det.push('Pension : − '+eur(pension));
      if(per>0) det.push('PER : − '+eur(per));
      if(immoDed>0) det.push('Déduction immo : − '+eur(immoDed));
      $('imp-readout').innerHTML='Revenu net imposable retenu<span class="big2">'+eur(revenu)+'</span>'+(det.length?'<span class="det">'+det.join(' · ')+'</span>':'');

      // Réductions (non remboursables, plafonnées à l'impôt) & crédits (remboursables)
      var dons=parseNum($('imp-dons').value), domicile=parseNum($('imp-domicile').value);
      var coll=parseNum($('imp-coll').value), lyc=parseNum($('imp-lyc').value), sup=parseNum($('imp-sup').value);
      var synd=parseNum($('imp-synd').value);
      var immoRed=parseNum($('imp-immo-red').value);
      var don75=Math.min(dons,1000)*0.75;
      var don66=Math.min(Math.max(0,dons-1000), revenu*0.20)*0.66;
      var redDonsRaw=Math.round(don75+don66);
      var redScolRaw=coll*61+lyc*153+sup*183;
      var base=r.net;
      var redDons=Math.min(redDonsRaw, base); base-=redDons;
      var redScol=Math.min(redScolRaw, base); base-=redScol;
      var redImmo=Math.min(immoRed, base); base-=redImmo;     // impôt après réductions
      var credDom=Math.round(Math.min(domicile,12000)*0.50);
      var credSynd=Math.round(Math.min(synd, Math.max(0,salaires+retraites)*0.01)*0.66);
      var credit=credDom+credSynd;                            // crédits remboursables
      var finalIR=base-credit;                                // < 0 = restitution
      var restit=finalIR<0?-finalIR:0, aPayer=finalIR>0?finalIR:0;
      var moyen=revenu>0?aPayer/revenu*100:0;
      lastCtx.finalIR=finalIR; lastCtx.moyen=moyen;

      var anyInput=revenu>0||dons>0||domicile>0||synd>0||coll>0||lyc>0||sup>0||immoRed>0;
      $('imp-res').textContent=anyInput?(finalIR>=0?eur(finalIR):'− '+eur(restit)):'—';
      var sub;
      if(!anyInput) sub='Renseignez vos revenus à gauche.';
      else if(finalIR<0) sub='<b>Crédit d\'impôt restitué</b> : l\'administration vous rembourse '+eur(restit)+'.';
      else if(!r.rec && redDons===0 && redScol===0 && redImmo===0 && credit===0) sub='Impôt <b>non mis en recouvrement</b> (inférieur à 61 €). Vous ne payez pas d\'IR.';
      else sub='Soit un taux moyen de <b>'+pct(moyen)+'</b> sur '+eur(revenu)+' de revenu imposable.';
      if(psSociaux>0) sub+=' <span style="color:#8ba0bd">+ '+eur(psSociaux)+' de prélèvements sociaux (foncier + LMNP).</span>';
      $('imp-sub').innerHTML=sub;

      $('imp-parts').textContent=r.parts.toLocaleString('fr-FR');
      $('imp-qf').textContent=revenu>0?eur(r.qf):'—';
      $('imp-tmi').textContent=revenu>0?pct(r.tmi*100):'—';
      $('imp-tmi-bar').style.width=(r.tmi/0.45*100)+'%';
      $('imp-moyen').textContent=revenu>0?pct(moyen):'—';

      $('imp-bareme-note').innerHTML=revenu>0
        ? 'Le barème s\'applique à votre quotient familial (<b>'+eur(r.qf)+'</b>), puis le résultat est multiplié par vos <b>'+r.parts.toLocaleString('fr-FR')+' parts</b>.'
        : 'Le barème s\'applique à votre quotient familial (revenu ÷ parts).';

      var q=revenu>0?r.qf:0;
      for(var i=0;i<TRANCHES.length;i++){
        var tr=TRANCHES[i];
        var span=(tr.max===Infinity)?1:(tr.max-tr.min);
        var filled=Math.max(0,Math.min(q,tr.max)-tr.min);
        var ratio=(tr.max===Infinity)?(q>tr.min?1:0):(span>0?filled/span:0);
        var taxHere=filled*tr.rate*r.parts;
        var fill=$('imp-fill-'+i); if(fill) fill.style.right=(100-ratio*100)+'%';
        var tx=$('imp-tax-'+i); if(tx) tx.textContent=filled>0?eur(taxHere):'—';
      }

      var rows='';
      if(anyInput){
        rows+='<div class="imp-brl"><span>Impôt selon le barème</span><b>'+eur(r.full>0?r.full:0)+'</b></div>';
        if(r.plaf) rows+='<div class="imp-brl"><span>Plafonnement du quotient familial</span><b>'+eur(r.iad)+'</b></div>';
        if(r.dec>0) rows+='<div class="imp-brl minus"><span>Décote (impôts modérés)</span><b>− '+eur(r.dec)+'</b></div>';
        if(redDons>0||redScol>0||redImmo>0||credit>0){
          rows+='<div class="imp-brl"><span>Impôt après barème</span><b>'+eur(r.net)+'</b></div>';
          if(redDons>0) rows+='<div class="imp-brl minus"><span>Réduction — dons</span><b>− '+eur(redDons)+'</b></div>';
          if(redScol>0) rows+='<div class="imp-brl minus"><span>Réduction — frais de scolarité</span><b>− '+eur(redScol)+'</b></div>';
          if(redImmo>0) rows+='<div class="imp-brl minus"><span>Réduction — défiscalisation immobilière</span><b>− '+eur(redImmo)+'</b></div>';
          if(credDom>0) rows+='<div class="imp-brl minus"><span>Crédit — emploi à domicile</span><b>− '+eur(credDom)+'</b></div>';
          if(credSynd>0) rows+='<div class="imp-brl minus"><span>Crédit — cotisations syndicales</span><b>− '+eur(credSynd)+'</b></div>';
        }
        if(finalIR>=0) rows+='<div class="imp-brl tot"><span>Impôt sur le revenu net</span><b>'+eur(finalIR)+'</b></div>';
        else rows+='<div class="imp-brl tot"><span>Crédit d\'impôt restitué</span><b>− '+eur(restit)+'</b></div>';
        if(psSociaux>0){
          rows+='<div class="imp-brl"><span>Prélèvements sociaux — foncier + LMNP (17,2 %)</span><b>'+eur(psSociaux)+'</b></div>';
          var totNet=aPayer+psSociaux-restit;
          rows+='<div class="imp-brl tot"><span>'+(totNet>=0?'Total dû (IR + prélèvements sociaux)':'Solde en votre faveur')+'</span><b>'+(totNet>=0?eur(totNet):'− '+eur(-totNet))+'</b></div>';
        }
      }
      $('imp-breakdown').innerHTML=rows;
    }

    // lignes de résultat pour la capture de lead (PDF)
    window.__leadRows=function(){
      if(!last||!lastCtx) return [];
      var stMap={single:'Célibataire',couple:'Marié / pacsé',divorce:'Divorcé',veuf:'Veuf'};
      var fi=lastCtx.finalIR||0;
      var rows=[
        {label:'Situation du foyer', value:stMap[lastCtx.statut]||''},
        {label:'Revenu net imposable', value:eur(lastCtx.revenu)},
        {label:'Nombre de parts', value:last.parts.toLocaleString('fr-FR')},
        {label:'Impôt sur le revenu estimé', value:(fi>=0?eur(fi):'− '+eur(-fi)+' (restitué)'), strong:true},
        {label:'Taux marginal (TMI)', value:pct(last.tmi*100)},
        {label:'Taux moyen réel', value:pct(lastCtx.moyen||0)}
      ];
      if(lastCtx.ps>0) rows.push({label:'Prélèvements sociaux (foncier)', value:eur(lastCtx.ps)});
      return rows;
    };

    function selectExp(n){
      for(var i=1;i<=10;i++){var e=$('imp-exp-'+i); if(e) e.hidden=(i!==n);}
      document.querySelectorAll('.imp-line').forEach(function(b){b.classList.toggle('on',+b.dataset.i===n);});
    }

    function init(){
      var root=$('imp-salaires'); if(!root||root.dataset.ready) return; root.dataset.ready='1';

      var st=$('imp-statut');
      if(st) st.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;statut=b.dataset.v;st.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});render();});
      var fr=$('imp-frais');
      if(fr) fr.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;fraisMode=b.dataset.v;fr.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});$('imp-reel-wrap').hidden=fraisMode!=='reel';render();});
      $('imp-kminus').addEventListener('click',function(){kids=Math.max(0,kids-1);$('imp-kn').textContent=kids;render();});
      $('imp-kplus').addEventListener('click',function(){kids=Math.min(8,kids+1);$('imp-kn').textContent=kids;render();});
      $('imp-isole').addEventListener('change',function(){isole=this.checked;render();});
      ['imp-salaires','imp-frais-reel','imp-retraites','imp-foncier','imp-lmnp','imp-bic','imp-autres','imp-pension','imp-per','imp-dons','imp-domicile','imp-synd','imp-immo-red','imp-immo-ded'].forEach(function(id){bindMoney(id,render);});
      ['imp-coll','imp-lyc','imp-sup'].forEach(function(id){var el=$(id); if(el) el.addEventListener('input',function(){var n=parseNum(this.value);this.value=n?String(n):'';render();});});

      document.querySelectorAll('.imp-line').forEach(function(b){b.addEventListener('click',function(){selectExp(+b.dataset.i);});});

      selectExp(1);
      render();
    }

    init();
    if(!window.__impInit){window.__impInit=1;document.addEventListener('astro:page-load',init);}
  })();
</script>
