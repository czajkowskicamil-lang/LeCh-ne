---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import ToolLeadCapture from '../../components/ToolLeadCapture.astro';

const title = "Comprendre et simuler son impôt sur le revenu 2026 | Le Chêne Patrimonial";
const description = "Apprenez à lire votre avis d'imposition (revenu imposable, parts, quotient familial, TMI) et calculez votre impôt 2026 avec le barème officiel. Leviers immobiliers et fiscalité des placements expliqués simplement.";

// Barème officiel — imposition 2026 sur les revenus 2025
const tranches = [
  { rate: '0 %',  rng: 'Jusqu’à 11 600 €',  cls: 'r0' },
  { rate: '11 %', rng: '11 600 – 29 579 €',       cls: 'r1' },
  { rate: '30 %', rng: '29 579 – 84 577 €',       cls: 'r2' },
  { rate: '41 %', rng: '84 577 – 181 917 €',      cls: 'r3' },
  { rate: '45 %', rng: '181 918 € et plus',       cls: 'r4' },
];

// Décrypteur de l'avis — exemple : couple, 2 enfants, 62 000 € imposables (chiffres exacts)
const lignes = [
  { n: 1,  lbl: 'Nombre de parts', sub: 'Quotient familial',        val: '3 parts' },
  { n: 2,  lbl: 'Revenu brut global', sub: 'Après abattements',     val: '62 000 €' },
  { n: 3,  lbl: 'Revenu net imposable', sub: 'La base de calcul',   val: '62 000 €' },
  { n: 4,  lbl: 'Impôt sur les revenus soumis au barème', sub: 'Avant corrections', val: '2 992 €' },
  { n: 5,  lbl: 'Quotient familial', sub: 'Revenu ÷ parts',         val: '20 667 €' },
  { n: 6,  lbl: 'Revenu fiscal de référence (RFR)', sub: 'Ouvre / ferme des droits', val: '62 000 €' },
  { n: 7,  lbl: 'Taux marginal d’imposition (TMI)', sub: 'Votre tranche haute', val: '11 %' },
  { n: 8,  lbl: 'Taux moyen d’imposition', sub: 'Impôt ÷ revenu', val: '4,6 %' },
  { n: 9,  lbl: 'Montant de votre impôt', sub: 'Net à payer',       val: '2 863 €' },
  { n: 10, lbl: 'Taux de prélèvement à la source', sub: 'Appliqué sur vos revenus', val: '4,6 %' },
];

const explications = [
  { n: 1, t: 'Le nombre de parts', h: `C'est la « taille fiscale » de votre foyer. Un célibataire compte <b>1 part</b>, un couple marié ou pacsé <b>2 parts</b>. Chacun des deux premiers enfants ajoute <b>0,5 part</b>, et à partir du troisième, <b>1 part</b> par enfant.<br><br>Ici : 2 (couple) + 0,5 + 0,5 = <b>3 parts</b>.<br><span class="imp-aside">Plus vous avez de parts, plus votre revenu est « divisé », donc moins il est taxé : c'est tout l'effet du quotient familial.</span>` },
  { n: 2, t: 'Le revenu brut global', h: `La somme de tous vos revenus (salaires, pensions, foncier…) <b>après l'abattement de 10 %</b> pour frais professionnels sur les salaires, mais avant vos déductions personnelles.<br><span class="imp-aside">Ce n'est pas votre salaire brut de fiche de paie : l'administration part de votre net imposable, puis retire 10 %.</span>` },
  { n: 3, t: 'Le revenu net imposable', h: `<b>C'est LE chiffre clé.</b> C'est sur lui que l'impôt est calculé, une fois retirées vos charges déductibles (pension alimentaire, PER…).<br><br>Ni votre salaire brut, ni votre net perçu chaque mois : c'est le montant retenu par le fisc.<br><span class="imp-aside">Vous le retrouvez aussi sur votre fiche de paie de décembre, ligne « net imposable » (cumul annuel).</span>` },
  { n: 4, t: 'L’impôt « brut » selon le barème', h: `Le résultat du barème progressif appliqué à votre quotient familial, <b>avant</b> plafonnement, décote et réductions d'impôt.<br><br>C'est une étape de calcul intermédiaire : le montant réellement dû figure plus bas.` },
  { n: 5, t: 'Le quotient familial', h: `Votre revenu imposable divisé par votre nombre de parts : 62 000 ÷ 3 = <b>20 667 €</b>. C'est ce quotient qui est passé dans le barème, puis le résultat est multiplié par le nombre de parts.<br><span class="imp-aside">Ce mécanisme atténue la progressivité pour les familles. Son avantage est toutefois <b>plafonné</b> (1 807 € par demi-part).</span>` },
  { n: 6, t: 'Le revenu fiscal de référence', h: `Un indicateur plus large que le revenu imposable (il réintègre certains revenus exonérés). Il <b>ne sert pas à calculer votre impôt</b>, mais à déterminer votre éligibilité à des aides, exonérations, taux réduits, bourses…<br><span class="imp-aside">C'est souvent le chiffre qu'on vous demande pour un dossier (crèche, aide, prêt).</span>` },
  { n: 7, t: 'Le taux marginal (TMI)', h: `Le taux de la <b>tranche la plus élevée</b> que vous atteignez. Il s'applique seulement à la part de revenu au-dessus du seuil de tranche, <b>pas à tout votre revenu</b>. Dans notre exemple, le quotient (20 667 €) reste dans la tranche à <b>11 %</b>.<br><span class="imp-aside">C'est le bon repère pour une décision : 1 000 € versés sur un PER vous font économiser « votre TMI » d'impôt (300 € si vous êtes à 30 %).</span>` },
  { n: 8, t: 'Le taux moyen', h: `Votre impôt réel divisé par votre revenu imposable. Toujours <b>plus faible que le TMI</b>, parce que vos premières tranches sont taxées à 0 % et 11 %.<br><span class="imp-aside">C'est votre taux d'imposition « ressenti » : ce que l'impôt vous coûte réellement en proportion.</span>` },
  { n: 9, t: 'L’impôt net', h: `Le montant réellement dû, une fois appliqués le plafonnement, la décote et vos éventuelles réductions et crédits d'impôt.<br><br>C'est ce qui est comparé à ce que vous avez déjà payé via le prélèvement à la source, pour déterminer votre solde (à payer ou à rembourser).` },
  { n: 10, t: 'Le taux de prélèvement à la source', h: `Le taux que l'administration transmet à votre employeur (ou caisse de retraite) pour prélever l'impôt <b>chaque mois</b>, en temps réel.<br><span class="imp-aside">Vous pouvez l'individualiser au sein d'un couple, ou le moduler en cours d'année si vos revenus changent.</span>` },
];

const immo = [
  { nom: 'Déficit foncier', badge: 'Déduction', cls: 'imp-b-ded',
    principe: 'Location nue au réel : les travaux et charges qui dépassent vos loyers créent un déficit.',
    avantage: 'Jusqu’à <b>10 700 €/an</b> imputables sur votre revenu global (plafond relevé pour certains travaux de rénovation énergétique). Surplus reportable 10 ans.',
    surveiller: 'Location nue à maintenir 3 ans après la dernière imputation.' },
  { nom: 'LMNP', badge: 'Amortissement', cls: 'imp-b-amo',
    principe: 'Location meublée au réel : vous amortissez le bien et le mobilier, ce qui efface une large part des loyers imposables.',
    avantage: 'Des revenus locatifs souvent <b>très peu fiscalisés</b> pendant des années.',
    surveiller: 'Depuis 2025, les amortissements déduits sont réintégrés dans le calcul de la plus-value à la revente : à anticiper.' },
  { nom: 'Denormandie', badge: 'Réduction d’impôt', cls: 'imp-b-red',
    principe: 'Achat d’un logement ancien à rénover dans une ville éligible, loué sous conditions.',
    avantage: 'Réduction d’impôt de <b>12, 18 ou 21 %</b> du prix (location 6, 9 ou 12 ans).',
    surveiller: 'Travaux ≥ 25 % du coût total, plafonds de loyer et de ressources du locataire. Prolongé jusqu’à fin 2027.' },
  { nom: 'Pinel', badge: 'Clos depuis 2025', cls: 'imp-b-clos',
    principe: 'Logement neuf loué sous conditions de plafonds de loyer et de ressources.',
    avantage: 'Réduction jusqu’à <b>14 %</b> du prix (derniers taux 2024).',
    surveiller: 'Fermé aux nouveaux investissements depuis le 1ᵉʳ janvier 2025. Ne concerne plus que les opérations engagées avant.' },
  { nom: 'Malraux', badge: 'Réduction d’impôt', cls: 'imp-b-red',
    principe: 'Restauration complète d’un immeuble ancien en site patrimonial remarquable.',
    avantage: 'Réduction de <b>22 % ou 30 %</b> des travaux (plafonnés à 400 000 € sur 4 ans), <b>hors</b> plafonnement des niches fiscales.',
    surveiller: 'Opération lourde, encadrée par les Architectes des Bâtiments de France.' },
  { nom: 'Monument Historique', badge: 'Déduction', cls: 'imp-b-ded',
    principe: 'Bien classé ou inscrit : charges et travaux déductibles du revenu.',
    avantage: 'Déduction sur le revenu global <b>sans plafonnement</b> des niches — d’autant plus forte que votre TMI est élevée.',
    surveiller: 'Engagement de conservation 15 ans, fortes contraintes patrimoniales.' },
];

const placements = [
  { nom: 'Intérêts & obligations', badge: 'Flat tax 30 %', cls: 'imp-b-ded',
    principe: 'Coupons d’obligations, intérêts de comptes à terme, fonds obligataires : des revenus de capitaux mobiliers.',
    impo: 'PFU de <b>30 %</b> (12,8 % d’impôt + 17,2 % de prélèvements sociaux). Option possible pour le barème si c’est plus favorable.',
    note: 'Souvent la fiscalité la plus lourde : d’où l’intérêt des enveloppes ci-dessous.' },
  { nom: 'Dividendes & actions', badge: 'Flat tax 30 %', cls: 'imp-b-ded',
    principe: 'Dividendes perçus et plus-values de cession de titres.',
    impo: 'PFU de <b>30 %</b>. Sur option pour le barème : abattement de 40 % sur les dividendes.',
    note: 'L’option barème s’applique à tout le foyer et à tous les revenus de l’année.' },
  { nom: 'Assurance-vie', badge: 'Enveloppe', cls: 'imp-b-red',
    principe: 'Enveloppe souple : la fiscalité ne porte que sur les gains, uniquement lors d’un retrait.',
    impo: 'Après 8 ans : abattement annuel de <b>4 600 € (seul) / 9 200 € (couple)</b> sur les gains, puis 7,5 % (+17,2 % PS) jusqu’à 150 000 € de primes.',
    note: 'Atout aussi pour la transmission : abattement de 152 500 € par bénéficiaire.' },
  { nom: 'PEA', badge: 'Après 5 ans', cls: 'imp-b-red',
    principe: 'Enveloppe dédiée aux actions européennes.',
    impo: 'Après 5 ans, gains <b>exonérés d’impôt</b> — seuls les 17,2 % de prélèvements sociaux restent dus.',
    note: 'Un retrait avant 5 ans entraîne la clôture du plan (sauf exceptions).' },
  { nom: 'Livret A · LDDS · LEP', badge: 'Exonéré', cls: 'imp-b-red',
    principe: 'Épargne de précaution réglementée, disponible à tout moment.',
    impo: 'Intérêts <b>totalement exonérés</b> d’impôt et de prélèvements sociaux.',
    note: 'Plafonds de versement et taux fixés par l’État : une réserve, pas un moteur de rendement.' },
  { nom: 'PER', badge: 'Déduction à l’entrée', cls: 'imp-b-ded',
    principe: 'Épargne retraite : les versements réduisent votre revenu imposable (voir le simulateur ci-dessus).',
    impo: 'Gain immédiat = versement × votre <b>TMI</b>. La sortie (capital ou rente) est ensuite imposée.',
    note: 'Épargne bloquée jusqu’à la retraite, sauf déblocage anticipé (achat résidence principale, accidents de la vie).' },
];
---

<Base title={title} description={description}>
  <header class="pt-16 pb-8 md:pt-24 md:pb-10">
    <div class="shell max-w-4xl">
      <nav class="text-xs uppercase tracking-micro text-stone mb-10 flex gap-3" aria-label="Fil d'ariane">
        <a href="/" class="hover:text-chene">Accueil</a>
        <span>/</span>
        <a href="/outils" class="hover:text-chene">Outils</a>
        <span>/</span>
        <span class="text-ink">Impôt sur le revenu</span>
      </nav>
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Fiscalité
      </p>
      <h1 class="font-serif text-display text-ink mb-6 leading-tight">Savoir lire son <span class="italic text-chene">avis d'imposition</span></h1>
      <p class="text-xl text-ink/75 max-w-prose-wide leading-relaxed">
        Revenu imposable, parts fiscales, quotient familial, taux marginal… On décrypte chaque ligne de votre avis, puis vous simulez votre impôt avec le barème officiel 2026 (revenus 2025).
      </p>
    </div>
  </header>

  <!-- ============ I. DÉCRYPTEUR ============ -->
  <section class="shell max-w-5xl pb-4">
    <p class="eyebrow mb-4 flex items-center gap-3"><span class="inline-block h-px w-8 bg-chene"></span>I · Décrypter votre avis, ligne par ligne</p>
    <h2 class="font-serif text-display-sm text-ink mb-3 leading-tight">Chaque ligne, expliquée</h2>
    <p class="text-ink/65 max-w-prose-wide mb-8 leading-relaxed">Cliquez sur une ligne de l'avis pour comprendre à quoi elle correspond. Les montants sont un exemple : un couple avec deux enfants, 62 000 € de revenu imposable.</p>

    <div class="grid md:grid-cols-[1.15fr_.85fr] gap-6 items-start">
      <div class="imp-avis" role="list">
        <div class="imp-avis-top">
          <span>RÉPUBLIQUE FRANÇAISE<br><span class="opacity-80 text-[0.78rem]">Avis d'impôt sur le revenu 2026</span></span>
          <span class="imp-kind">Revenus 2025</span>
        </div>
        {lignes.map((l) => (
          <button class="imp-line" data-i={l.n} role="listitem">
            <span class="imp-mk">{l.n}</span>
            <span class="imp-lbl"><b>{l.lbl}</b>{l.sub}</span>
            <span class="imp-val">{l.val}</span>
          </button>
        ))}
      </div>

      <aside class="imp-explain" id="imp-explain" aria-live="polite">
        {explications.map((e) => (
          <div class="imp-exp" id={`imp-exp-${e.n}`} hidden>
            <span class="imp-tag"><span class="imp-dot">{e.n}</span>Décryptage</span>
            <h3>{e.t}</h3>
            <p set:html={e.h}></p>
          </div>
        ))}
      </aside>
    </div>
  </section>

  <!-- ============ II. SIMULATEUR ============ -->
  <section class="shell max-w-5xl pt-10 pb-6">
    <p class="eyebrow mb-4 flex items-center gap-3"><span class="inline-block h-px w-8 bg-chene"></span>II · Simuler votre impôt</p>
    <h2 class="font-serif text-display-sm text-ink mb-3 leading-tight">Votre impôt, au barème officiel</h2>
    <p class="text-ink/65 max-w-prose-wide mb-8 leading-relaxed">Comme le simulateur officiel : salaires, pensions, revenus fonciers, bénéfices indépendants, déductions (pension alimentaire, PER) et principaux crédits d'impôt. Le calcul applique le barème progressif 2026, le quotient familial (avec son plafonnement) et la décote, exactement comme l'administration.</p>

    <div class="tool-card">
      <div class="tool-grid">
        <!-- Inputs -->
        <div>
          <div class="tool-field">
            <label>Situation du foyer</label>
            <div class="imp-seg" id="imp-statut">
              <button class="on" data-v="single">Célibataire</button>
              <button data-v="couple">Marié / pacsé</button>
              <button data-v="divorce">Divorcé</button>
              <button data-v="veuf">Veuf</button>
            </div>
          </div>

          <div class="tool-field">
            <label>Enfants et personnes à charge</label>
            <div class="imp-stepper">
              <button id="imp-kminus" aria-label="Retirer un enfant">–</button>
              <span class="n" id="imp-kn">0</span>
              <button id="imp-kplus" aria-label="Ajouter un enfant">+</button>
            </div>
            <label class="imp-check" id="imp-isole-wrap" hidden>
              <input type="checkbox" id="imp-isole" />
              <span>Je vis <b>seul(e) avec mes enfants</b> (parent isolé) : une demi-part supplémentaire.</span>
            </label>
          </div>

          <p class="imp-group">Vos revenus</p>

          <div class="tool-field">
            <label>Salaires & traitements nets annuels du foyer</label>
            <div class="imp-money"><span>€</span><input id="imp-salaires" class="tool-input" type="text" inputmode="numeric" value="35 000" /></div>
          </div>

          <div class="tool-field">
            <label>Frais professionnels</label>
            <div class="imp-seg imp-seg-2" id="imp-frais">
              <button class="on" data-v="forfait">Abattement 10 %</button>
              <button data-v="reel">Frais réels</button>
            </div>
            <div id="imp-reel-wrap" hidden style="margin-top:10px">
              <div class="imp-money"><span>€</span><input id="imp-frais-reel" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
            </div>
          </div>

          <div class="tool-field">
            <label>Pensions & retraites <span class="imp-opt">net imposable</span></label>
            <div class="imp-money"><span>€</span><input id="imp-retraites" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
          </div>

          <div class="tool-field">
            <label>Revenus fonciers nets <span class="imp-opt">location nue</span></label>
            <div class="imp-money"><span>€</span><input id="imp-foncier" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
            <p class="imp-hint">Loyers encaissés moins charges et intérêts (régime réel), ou loyers − 30 % (micro-foncier). Soumis aussi à <b>17,2 % de prélèvements sociaux</b>, calculés à part.</p>
          </div>

          <div class="tool-field">
            <label>Location meublée — LMNP <span class="imp-opt">résultat BIC</span></label>
            <div class="imp-money"><span>€</span><input id="imp-lmnp" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
            <p class="imp-hint">Le meublé relève des <b>BIC</b> (pas des BNC). Reportez ici le bénéfice après amortissement — calculable avec notre <a href="/outils/lmnp" style="color:#E6C259;text-decoration:underline">simulateur LMNP</a>. Soumis à <b>17,2 % de prélèvements sociaux</b> (LMNP non professionnel).</p>
          </div>

          <div class="tool-field">
            <label>Bénéfices indépendants (BIC / BNC) <span class="imp-opt">activité pro</span></label>
            <div class="imp-money"><span>€</span><input id="imp-bic" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
            <p class="imp-hint">Activité indépendante (commerçant, artisan, profession libérale), hors location meublée.</p>
          </div>

          <div class="tool-field">
            <label>Autres revenus imposables</label>
            <div class="imp-money"><span>€</span><input id="imp-autres" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
          </div>

          <p class="imp-group">Vos déductions</p>

          <div class="tool-field">
            <label>Pension alimentaire versée <span class="imp-opt">déductible</span></label>
            <div class="imp-money"><span>€</span><input id="imp-pension" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
            <p class="imp-hint">Inclut l'aide à un <b>enfant majeur non rattaché</b> (études, logement) : déductible jusqu'à <b>6 855 €/enfant</b> avec justificatifs, ou <b>4 075 €</b> en forfait.</p>
          </div>

          <div class="tool-field">
            <label>Versements épargne retraite (PER) <span class="imp-opt">déductible</span></label>
            <div class="imp-money"><span>€</span><input id="imp-per" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
          </div>

          <p class="imp-group">Réductions & crédits d'impôt</p>

          <div class="tool-field">
            <label>Dons aux associations <span class="imp-opt">réduction</span></label>
            <div class="imp-money"><span>€</span><input id="imp-dons" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
            <p class="imp-hint">75 % jusqu'à 1 000 €, puis 66 % (dans la limite de 20 % du revenu imposable).</p>
          </div>

          <div class="tool-field">
            <label>Emploi à domicile / garde d'enfants <span class="imp-opt">crédit</span></label>
            <div class="imp-money"><span>€</span><input id="imp-domicile" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
            <p class="imp-hint">Crédit d'impôt de <b>50 %</b> des dépenses (plafond 12 000 €), <b>remboursé</b> même sans impôt.</p>
          </div>

          <div class="tool-field">
            <label>Enfants scolarisés <span class="imp-opt">réduction</span></label>
            <div class="imp-scol">
              <div><span>Collège</span><input id="imp-coll" type="text" inputmode="numeric" value="0" /></div>
              <div><span>Lycée</span><input id="imp-lyc" type="text" inputmode="numeric" value="0" /></div>
              <div><span>Supérieur</span><input id="imp-sup" type="text" inputmode="numeric" value="0" /></div>
            </div>
            <p class="imp-hint">Réduction de <b>61 €</b> par collégien, <b>153 €</b> par lycéen, <b>183 €</b> par étudiant du supérieur.</p>
          </div>

          <div class="tool-field">
            <label>Cotisations syndicales <span class="imp-opt">crédit</span></label>
            <div class="imp-money"><span>€</span><input id="imp-synd" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
            <p class="imp-hint">Crédit d'impôt de <b>66 %</b> (dans la limite de 1 % de vos salaires et pensions).</p>
          </div>

          <p class="imp-group">Défiscalisation immobilière</p>

          <div class="tool-field">
            <label>Réduction d'impôt immobilière <span class="imp-opt">Pinel · Denormandie · Malraux</span></label>
            <div class="imp-money"><span>€</span><input id="imp-immo-red" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
            <p class="imp-hint">Montant <b>annuel</b> de la réduction. Rappel : plafond global des niches fiscales de <b>10 000 €/an</b> pour Pinel et Denormandie — Malraux et Monument Historique en sont exclus. Détail des dispositifs plus bas.</p>
          </div>

          <div class="tool-field">
            <label>Déduction du revenu <span class="imp-opt">déficit foncier · Monument Historique</span></label>
            <div class="imp-money"><span>€</span><input id="imp-immo-ded" class="tool-input" type="text" inputmode="numeric" value="0" /></div>
            <p class="imp-hint">Montant déductible de votre <b>revenu global</b> : déficit foncier (jusqu'à 10 700 €/an) ou charges Monument Historique. Son gain réel dépend de votre TMI.</p>
          </div>

          <div class="imp-readout" id="imp-readout"></div>
        </div>

        <!-- Results -->
        <div>
          <div class="tool-result">
            <p class="lbl">Impôt sur le revenu estimé</p>
            <p class="big" id="imp-res">—</p>
            <p class="imp-sub" id="imp-sub">—</p>
          </div>

          <div class="imp-stats">
            <div class="imp-stat"><p class="k">Nombre de parts</p><div class="v" id="imp-parts">—</div></div>
            <div class="imp-stat"><p class="k">Quotient familial</p><div class="v" id="imp-qf">—</div></div>
            <div class="imp-stat"><p class="k">Taux marginal (TMI)</p><div class="v" id="imp-tmi">—</div><div class="imp-band"><i id="imp-tmi-bar"></i></div></div>
            <div class="imp-stat"><p class="k">Taux moyen réel</p><div class="v" id="imp-moyen">—</div></div>
          </div>
        </div>
      </div>

      <!-- Barème + détail (pleine largeur dans la carte) -->
      <div class="imp-bareme">
        <p class="imp-bareme-k">Comment le barème « remplit » vos tranches</p>
        <p class="imp-bareme-note" id="imp-bareme-note">—</p>
        <div id="imp-bars">
          {tranches.map((t, i) => (
            <div class={`imp-brow ${t.cls}`}>
              <span class="imp-rng"><b>{t.rate}</b><br>{t.rng}</span>
              <span class="imp-track"><i id={`imp-fill-${i}`}></i></span>
              <span class="imp-tax" id={`imp-tax-${i}`}>—</span>
            </div>
          ))}
        </div>
        <div id="imp-breakdown" class="imp-breakdown"></div>
      </div>

      <p class="imp-simpl"><b>Ce que nous simplifions volontairement.</b> Les revenus de capitaux mobiliers et plus-values (imposés au prélèvement forfaitaire de 30 %, voir la fiscalité des placements plus bas), les dispositifs immobiliers (voir les leviers plus bas), la CSG déductible, les rentes viagères et le prélèvement à la source déjà payé ne sont pas intégrés au barème. L'essentiel des foyers retrouve ici un résultat très proche de l'avis officiel.</p>
      <p class="tool-note">Barème de l'impôt sur le revenu 2026 (revenus 2025), plafonnement du quotient familial (1 807 € par demi-part) et décote issus des textes officiels. Estimation pédagogique : elle ne remplace pas le simulateur officiel des impôts ni un conseil personnalisé.</p>
    </div>

    <ToolLeadCapture tool="Impôt sur le revenu" titre="Votre estimation d'impôt sur le revenu" heading="Recevez votre estimation en PDF" />
  </section>

  <!-- ============ III. LEVIERS IMMOBILIERS ============ -->
  <section class="shell max-w-5xl pt-10 pb-6">
    <p class="eyebrow mb-4 flex items-center gap-3"><span class="inline-block h-px w-8 bg-chene"></span>III · Réduire son impôt par l'immobilier</p>
