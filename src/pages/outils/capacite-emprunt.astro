---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import ToolLeadCapture from '../../components/ToolLeadCapture.astro';

const title = "Simulateur de capacité d'emprunt 2026 | Le Chêne Patrimonial";
const description = "Combien pouvez-vous emprunter ? Calculez votre capacité d'emprunt, votre mensualité assurance comprise et le prix du bien finançable. Gratuit et instantané.";
---

<Base title={title} description={description}>
  <header class="pt-16 pb-8 md:pt-24 md:pb-10">
    <div class="shell max-w-4xl">
      <nav class="text-xs uppercase tracking-micro text-stone mb-10 flex gap-3" aria-label="Fil d'ariane">
        <a href="/" class="hover:text-chene">Accueil</a>
        <span>/</span>
        <a href="/outils" class="hover:text-chene">Outils</a>
        <span>/</span>
        <span class="text-ink">Capacité d'emprunt</span>
      </nav>
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Crédit immobilier
      </p>
      <h1 class="font-serif text-display text-ink mb-6 leading-tight">Combien pouvez-vous emprunter ?</h1>
      <p class="text-xl text-ink/75 max-w-prose-wide leading-relaxed">
        Avant de chercher un bien, connaissez votre budget réel. Le calcul reprend la méthode des banques : taux d'effort plafonné, assurance emprunteur comprise dans la mensualité, frais d'acquisition déduits du prix.
      </p>
    </div>
  </header>

  <div class="shell max-w-5xl pb-16">
    <div class="tool-card">
      <div class="tool-grid">
        <div>
          <div class="tool-field">
            <label>Revenus nets du foyer / mois <b id="ce-rev-val">3 500 €</b></label>
            <input class="tool-range" type="range" id="ce-rev" min="0" max="20000" step="1" value="3500" />
          </div>
          <div class="tool-field">
            <label>Loyers perçus / mois <b id="ce-loy-val">0 €</b></label>
            <input class="tool-range" type="range" id="ce-loy" min="0" max="10000" step="1" value="0" />
            <p class="ce-hint">Retenus à 70 % par les banques, comme dans le calcul ci-contre.</p>
          </div>
          <div class="tool-field">
            <label>Mensualités de crédit en cours <b id="ce-chg-val">0 €</b></label>
            <input class="tool-range" type="range" id="ce-chg" min="0" max="8000" step="1" value="0" />
          </div>
          <div class="tool-field">
            <label>Apport personnel <b id="ce-app-val">20 000 €</b></label>
            <input class="tool-range" type="range" id="ce-app" min="0" max="500000" step="1" value="20000" />
          </div>
          <div class="tool-field">
            <label>Durée du prêt <b id="ce-dur-val">20 ans</b></label>
            <input class="tool-range" type="range" id="ce-dur" min="5" max="25" step="1" value="20" />
          </div>
          <div class="tool-field">
            <label>Taux d'intérêt nominal <b id="ce-tx-val">3,40 %</b></label>
            <input class="tool-range" type="range" id="ce-tx" min="0.5" max="7" step="0.01" value="3.4" />
          </div>
          <div class="tool-field">
            <label>Taux d'assurance emprunteur <b id="ce-ass-val">0,34 %</b></label>
            <input class="tool-range" type="range" id="ce-ass" min="0" max="1.5" step="0.01" value="0.34" />
            <p class="ce-hint">Taux annuel appliqué au capital emprunté. Sur un profil jeune et non fumeur, il descend souvent sous 0,20 %.</p>
          </div>
          <div class="tool-field">
            <label>Taux d'endettement retenu <b id="ce-end-val">35 %</b></label>
            <div class="tool-seg" id="ce-end-seg">
              <button type="button" data-v="33">33 %</button>
              <button type="button" data-v="35" class="on">35 %</button>
            </div>
          </div>
          <div class="tool-field">
            <label>Nature du bien <b id="ce-nat-val">Ancien</b></label>
            <div class="tool-seg" id="ce-nat-seg">
              <button type="button" data-v="7.5" class="on">Ancien</button>
              <button type="button" data-v="2.5">Neuf</button>
            </div>
            <p class="ce-hint">Sert à déduire les frais d'acquisition du prix finançable : 7,5 % dans l'ancien, 2,5 % dans le neuf.</p>
          </div>
        </div>

        <div class="ce-sticky">
          <div class="tool-result">
            <p class="lbl">Montant empruntable</p>
            <p class="big" id="ce-capital">—</p>
            <div class="tool-brk"><span class="k">Mensualité totale maximale</span><span class="v" id="ce-mens">—</span></div>
            <div class="tool-brk"><span class="k">dont remboursement du prêt</span><span class="v" id="ce-mens-credit">—</span></div>
            <div class="tool-brk"><span class="k">dont assurance emprunteur</span><span class="v" id="ce-mens-ass">—</span></div>
            <div class="tool-brk"><span class="k">Budget total avec l'apport</span><span class="v" id="ce-achat">—</span></div>
            <div class="tool-brk"><span class="k">Prix du bien, frais déduits</span><span class="v" id="ce-prix">—</span></div>
            <div class="tool-brk"><span class="k">Coût total du crédit</span><span class="v" id="ce-cout">—</span></div>
            <div class="tool-brk"><span class="k">Reste à vivre mensuel</span><span class="v" id="ce-rav">—</span></div>
          </div>
          <p class="ce-alert" id="ce-alert" hidden></p>
          <p class="tool-note">Estimation indicative calculée selon la méthode HCSF : taux d'effort plafonné, assurance emprunteur incluse dans la mensualité, revenus locatifs retenus à 70 %. Votre banque reste seule décisionnaire et applique ses propres règles de reste à vivre.</p>
        </div>
      </div>
    </div>

    <div class="tool-card ce-chart-card">
      <p class="ce-chart-title">Ce que change la durée du prêt</p>
      <p class="ce-chart-read" id="ce-read">—</p>
      <svg id="ce-svg" viewBox="0 0 640 296" role="img" aria-label="Capital empruntable et coût du crédit selon la durée du prêt">
        <g id="ce-grid"></g>
        <g id="ce-bars"></g>
        <g id="ce-xlab"></g>
      </svg>
      <div class="ce-leg">
        <span><i style="background:#A8A39A"></i> Capital emprunté</span>
        <span><i style="background:#C9A55C"></i> Intérêts et assurance</span>
      </div>
      <p class="ce-hint ce-hint-chart">Chaque barre représente la somme totale remboursée à la banque sur la durée. À mensualité identique, allonger le prêt augmente le capital obtenu, mais la part dorée grossit plus vite que la part bleue.</p>
    </div>

    <ToolLeadCapture tool="Capacité d'emprunt" titre="Votre capacité d'emprunt" />

    <div class="max-w-prose-wide mt-14 prose-editorial">
      <h2>Comment se calcule votre capacité d'emprunt ?</h2>
      <p>Le raisonnement bancaire tient en trois temps. D'abord, les revenus retenus : vos revenus nets, plus vos loyers perçus comptés à 70 %, parce que la banque provisionne la vacance et les charges. Ensuite, la mensualité maximale : ces revenus multipliés par le taux d'endettement autorisé, généralement 35 %, moins les mensualités de crédit que vous payez déjà.</p>
      <p>Enfin le capital. Cette mensualité maximale inclut l'assurance emprunteur, c'est le point que la plupart des simulateurs oublient et qui fausse tout. On retire donc la prime d'assurance de la mensualité avant de convertir le solde en capital, à partir du taux et de la durée. Sur un dossier moyen, ignorer l'assurance gonfle la capacité affichée de 5 à 8 %.</p>
      <h2>Capacité d'emprunt n'est pas budget d'achat</h2>
      <p>Le capital que la banque vous prête finance le bien mais aussi les frais d'acquisition, environ 7,5 % du prix dans l'ancien et 2,5 % dans le neuf. Pour connaître le prix réel du bien que vous pouvez viser, il faut donc retrancher ces frais de l'enveloppe totale, apport compris. C'est la ligne « prix du bien, frais déduits » du simulateur.</p>
      <p>Reste ce qu'aucune formule ne capte : la stabilité de vos revenus, votre reste à vivre une fois la mensualité payée, l'épargne de précaution qui subsiste après l'apport. C'est le travail d'analyse que nous menons avec vous avant de présenter un dossier.</p>
    </div>
  </div>

  <CTA />
</Base>

<style is:global>
  .ce-sticky{position:sticky;top:96px;}
  @media(max-width:820px){.ce-sticky{position:static;}}
  .ce-hint{color:#8C877D;font-size:.75rem;line-height:1.5;margin-top:9px;}
  .ce-hint-chart{margin-top:14px;max-width:62ch;}
  .ce-alert{margin-top:14px;background:rgba(201, 165, 92,.1);border:1px solid rgba(201, 165, 92,.35);border-radius:12px;padding:13px 15px;color:#D8B872;font-size:.82rem;line-height:1.5;}
  .ce-chart-card{margin-top:22px;}
  .ce-chart-title{color:#A8A39A;font-size:.8rem;text-transform:uppercase;letter-spacing:.09em;font-weight:700;}
  .ce-chart-read{color:#F2EDE4;font-size:.98rem;line-height:1.6;margin:10px 0 20px;max-width:64ch;}
  .ce-chart-read b{color:#D8B872;font-weight:600;}
  #ce-svg{width:100%;height:auto;display:block;overflow:visible;}
  .ce-grid-line{stroke:rgba(255,255,255,.08);stroke-width:1;}
  .ce-tick{fill:#8C877D;font-size:11px;font-family:system-ui,sans-serif;}
  .ce-bar-cap{fill:#5a86b8;}
  .ce-bar-int{fill:#D8B872;}
  .ce-bar-cap.dim{fill:#2d4a6b;}
  .ce-bar-int.dim{fill:#8a7130;}
  .ce-xl{fill:#8C877D;font-size:11px;font-family:system-ui,sans-serif;}
  .ce-xl.on{fill:#D8B872;font-weight:700;}
  .ce-leg{display:flex;gap:20px;font-size:.8rem;color:#A8A39A;margin-top:16px;flex-wrap:wrap;}
  .ce-leg span{display:inline-flex;align-items:center;gap:7px;}
  .ce-leg i{width:11px;height:11px;border-radius:3px;display:block;}
</style>

<script is:inline>
  (function () {
    const NS = 'http://www.w3.org/2000/svg';
    const eur = n => Math.round(n).toLocaleString('fr-FR') + ' €';
    const pct = n => n.toFixed(2).replace('.', ',') + ' %';
    const el = id => document.getElementById(id);

    let endettement = 35;
    let fraisPct = 7.5;

    // Capital empruntable, assurance emprunteur comprise dans la mensualité.
    // M = mensualite totale max, f = facteur d'actualisation, a = taux d'assurance mensuel.
    // M = capital/f + capital*a  =>  capital = M*f / (1 + a*f)
    function capaciteDepuisMensualite(M, tauxAnnuel, tauxAssurance, annees) {
      const i = tauxAnnuel / 1200, n = annees * 12, a = tauxAssurance / 1200;
      const f = i > 0 ? (1 - Math.pow(1 + i, -n)) / i : n;
      const capital = M > 0 ? (M * f) / (1 + a * f) : 0;
      return { capital, f, n, mensCredit: f > 0 ? capital / f : 0, mensAss: capital * a };
    }

    function calc() {
      const rev = +el('ce-rev').value, loy = +el('ce-loy').value, chg = +el('ce-chg').value,
        app = +el('ce-app').value, dur = +el('ce-dur').value,
        tx = +el('ce-tx').value, ass = +el('ce-ass').value;

      el('ce-rev-val').textContent = eur(rev);
      el('ce-loy-val').textContent = eur(loy);
      el('ce-chg-val').textContent = eur(chg);
      el('ce-app-val').textContent = eur(app);
      el('ce-dur-val').textContent = dur + ' ans';
      el('ce-tx-val').textContent = pct(tx);
      el('ce-ass-val').textContent = pct(ass);

      const revenusRetenus = rev + loy * 0.7;
      const mensMax = Math.max(0, revenusRetenus * (endettement / 100) - chg);
      const r = capaciteDepuisMensualite(mensMax, tx, ass, dur);

      const interets = r.mensCredit * r.n - r.capital;
      const coutAssurance = r.mensAss * r.n;
      const budget = r.capital + app;
      const prixBien = budget / (1 + fraisPct / 100);
      const resteAVivre = rev + loy - chg - mensMax;

      el('ce-capital').textContent = eur(r.capital);
      el('ce-mens').textContent = eur(mensMax);
      el('ce-mens-credit').textContent = eur(r.mensCredit);
      el('ce-mens-ass').textContent = eur(r.mensAss);
      el('ce-achat').textContent = eur(budget);
      el('ce-prix').textContent = eur(prixBien);
      el('ce-cout').textContent = eur(interets + coutAssurance);
      el('ce-rav').textContent = eur(Math.max(0, resteAVivre));

      const alerte = el('ce-alert');
      if (mensMax <= 0) {
        alerte.hidden = false;
        alerte.textContent = "Vos mensualités de crédit en cours absorbent déjà la totalité du taux d'endettement autorisé. Aucune capacité d'emprunt supplémentaire n'apparaît tant que ces crédits courent.";
      } else if (resteAVivre < 800 && rev > 0) {
        alerte.hidden = false;
        alerte.textContent = "Le taux d'endettement est respecté, mais le reste à vivre descend sous 800 € par mois. La plupart des banques refusent le dossier à ce niveau, même sous les 35 %.";
      } else {
        alerte.hidden = true;
      }

      draw(mensMax, tx, ass, dur, r);
    }

    function draw(mensMax, tx, ass, durSel, sel) {
      const x0 = 58, x1 = 632, yTop = 16, yBase = 252, dMin = 5, dMax = 25;
      const series = [];
      for (let d = dMin; d <= dMax; d++) {
        const r = capaciteDepuisMensualite(mensMax, tx, ass, d);
        series.push({ d, capital: r.capital, total: mensMax * r.n });
      }
      const maxV = Math.max(1, series[series.length - 1].total);
      const step = (x1 - x0) / series.length;
      const bw = Math.min(22, step * 0.66);
      const Y = v => yBase - (v / maxV) * (yBase - yTop);

      const grid = el('ce-grid'), bars = el('ce-bars'), xlab = el('ce-xlab');
      grid.textContent = ''; bars.textContent = ''; xlab.textContent = '';

      for (let k = 0; k <= 4; k++) {
        const v = (maxV / 4) * k, y = Y(v);
        const line = document.createElementNS(NS, 'line');
        line.setAttribute('class', 'ce-grid-line');
        line.setAttribute('x1', x0 - 6); line.setAttribute('x2', x1);
        line.setAttribute('y1', y.toFixed(1)); line.setAttribute('y2', y.toFixed(1));
        grid.appendChild(line);
        const t = document.createElementNS(NS, 'text');
        t.setAttribute('class', 'ce-tick');
        t.setAttribute('x', x0 - 12); t.setAttribute('y', (y + 4).toFixed(1));
        t.setAttribute('text-anchor', 'end');
        t.textContent = v >= 1000 ? Math.round(v / 1000) + ' k€' : Math.round(v) + ' €';
        grid.appendChild(t);
      }

      series.forEach((s, k) => {
        const x = x0 + step * k + (step - bw) / 2;
        const on = s.d === durSel;
        const yCap = Y(s.capital), yTot = Y(s.total);

        const rInt = document.createElementNS(NS, 'rect');
        rInt.setAttribute('class', 'ce-bar-int' + (on ? '' : ' dim'));
        rInt.setAttribute('x', x.toFixed(1)); rInt.setAttribute('width', bw.toFixed(1));
        rInt.setAttribute('y', yTot.toFixed(1));
        rInt.setAttribute('height', Math.max(0, yCap - yTot).toFixed(1));
        rInt.setAttribute('rx', '2');
        bars.appendChild(rInt);

        const rCap = document.createElementNS(NS, 'rect');
        rCap.setAttribute('class', 'ce-bar-cap' + (on ? '' : ' dim'));
        rCap.setAttribute('x', x.toFixed(1)); rCap.setAttribute('width', bw.toFixed(1));
        rCap.setAttribute('y', yCap.toFixed(1));
        rCap.setAttribute('height', Math.max(0, yBase - yCap).toFixed(1));
        rCap.setAttribute('rx', '2');
        bars.appendChild(rCap);

        if (s.d % 5 === 0 || on) {
          const t = document.createElementNS(NS, 'text');
          t.setAttribute('class', 'ce-xl' + (on ? ' on' : ''));
          t.setAttribute('x', (x + bw / 2).toFixed(1));
          t.setAttribute('y', yBase + 18);
          t.setAttribute('text-anchor', 'middle');
          t.textContent = s.d + ' ans';
          xlab.appendChild(t);
        }
      });

      const cout = mensMax * sel.n - sel.capital;
      el('ce-read').innerHTML = mensMax > 0
        ? "Sur <b>" + durSel + " ans</b>, une mensualité de <b>" + eur(mensMax) +
          "</b> vous ouvre <b>" + eur(sel.capital) + "</b> de capital. Vous rembourserez <b>" +
          eur(mensMax * sel.n) + "</b> au total, dont <b>" + eur(cout) + "</b> d'intérêts et d'assurance."
        : "Aucune mensualité disponible avec les paramètres actuels.";
    }

    function seg(id, onPick) {
      const box = el(id);
      box.addEventListener('click', e => {
        const b = e.target.closest('button'); if (!b) return;
        box.querySelectorAll('button').forEach(x => x.classList.remove('on'));
        b.classList.add('on');
        onPick(parseFloat(b.dataset.v), b.textContent.trim());
        calc();
      });
    }

    function init() {
      const r = el('ce-rev'); if (!r || r.dataset.ready) return; r.dataset.ready = '1';
      ['ce-rev', 'ce-loy', 'ce-chg', 'ce-app', 'ce-dur', 'ce-tx', 'ce-ass']
        .forEach(id => el(id).addEventListener('input', calc));
      seg('ce-end-seg', v => { endettement = v; el('ce-end-val').textContent = v + ' %'; });
      seg('ce-nat-seg', (v, lab) => { fraisPct = v; el('ce-nat-val').textContent = lab; });
      calc();
    }

    init();
    if (!window['__hk_ce-rev']) { window['__hk_ce-rev'] = 1; document.addEventListener('astro:page-load', init); }
  })();
</script>
