---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const title = "Calculateur de frais de notaire 2026 (ancien et neuf) | Le Chêne Patrimonial";
const description = "Estimez gratuitement vos frais de notaire pour un achat immobilier dans l'ancien ou le neuf : droits de mutation, émoluments, débours. Résultat instantané.";
---

<Base title={title} description={description}>
  <header class="pt-16 pb-8 md:pt-24 md:pb-10">
    <div class="shell max-w-4xl">
      <nav class="text-xs uppercase tracking-micro text-stone mb-10 flex gap-3" aria-label="Fil d'ariane">
        <a href="/" class="hover:text-chene">Accueil</a>
        <span>/</span>
        <a href="/outils" class="hover:text-chene">Outils</a>
        <span>/</span>
        <span class="text-ink">Frais de notaire</span>
      </nav>
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Achat immobilier
      </p>
      <h1 class="font-serif text-display text-ink mb-6 leading-tight">Calculez vos frais de notaire</h1>
      <p class="text-xl text-ink/75 max-w-prose-wide leading-relaxed">
        Les fameux « frais de notaire » sont surtout des taxes. Estimez-les en deux clics, dans l'ancien comme dans le neuf, avant de signer.
      </p>
    </div>
  </header>

  <div class="shell max-w-5xl pb-16">
    <div class="tool-card">
      <div class="tool-grid">
        <div>
          <div class="tool-field">
            <label>Type de bien</label>
            <div class="tool-seg" id="fn-type">
              <button class="on" data-t="ancien">Ancien</button>
              <button data-t="neuf">Neuf (VEFA)</button>
            </div>
          </div>
          <div class="tool-field">
            <label>Prix du bien <b id="fn-prix-val">250 000 €</b></label>
            <input class="tool-range" type="range" id="fn-prix" min="50000" max="1500000" step="5000" value="250000" />
          </div>
          <p class="tool-note">Estimation indicative pour un bien d'habitation. Les droits de mutation varient légèrement selon le département (taux standard retenu). Le mobilier déductible n'est pas pris en compte.</p>
        </div>

        <div class="tool-result">
          <p class="lbl">Frais de notaire estimés</p>
          <p class="big" id="fn-total">—</p>
          <div class="tool-brk"><span class="k">Droits de mutation (taxes)</span><span class="v" id="fn-droits">—</span></div>
          <div class="tool-brk"><span class="k">Émoluments du notaire</span><span class="v" id="fn-emol">—</span></div>
          <div class="tool-brk"><span class="k">Sécurité immobilière + débours</span><span class="v" id="fn-autres">—</span></div>
          <div class="tool-brk"><span class="k">Soit, du prix du bien</span><span class="v" id="fn-pct">—</span></div>
          <div class="tool-brk"><span class="k">Budget total (bien + frais)</span><span class="v" id="fn-budget">—</span></div>
        </div>
      </div>
    </div>

    <div class="max-w-prose-wide mt-14 prose-editorial">
      <h2>Pourquoi ces frais, et à quoi servent-ils ?</h2>
      <p>Contrairement à l'idée reçue, le notaire ne garde qu'une petite partie de ces frais. L'essentiel, ce sont des <strong>taxes reversées à l'État et aux collectivités</strong> (les droits de mutation). Viennent ensuite les émoluments du notaire, encadrés par un barème national, puis les débours (frais avancés pour votre compte).</p>
      <p>Dans le <strong>neuf</strong>, ces frais sont bien plus faibles (environ 2 à 3 % contre 7 à 8 % dans l'ancien), car la taxe de publicité foncière y est réduite. Un point à intégrer dans tout arbitrage d'achat.</p>
    </div>
  </div>

  <CTA />
</Base>

<script is:inline>
  (function () {
    function emolHT(p){
      return Math.min(p,6500)*0.03870
        + Math.max(0,Math.min(p,17000)-6500)*0.01596
        + Math.max(0,Math.min(p,60000)-17000)*0.01064
        + Math.max(0,p-60000)*0.00799;
    }
    const eur = n => Math.round(n).toLocaleString('fr-FR') + ' €';
    let type='ancien';
    function calc(){
      const p = +document.getElementById('fn-prix').value;
      const droits = p * (type==='neuf' ? 0.00715 : 0.0580);
      const emol = emolHT(p) * 1.2;
      const autres = p*0.001 + 1000;
      const total = droits + emol + autres;
      document.getElementById('fn-prix-val').textContent = eur(p);
      document.getElementById('fn-total').textContent = eur(total);
      document.getElementById('fn-droits').textContent = eur(droits);
      document.getElementById('fn-emol').textContent = eur(emol);
      document.getElementById('fn-autres').textContent = eur(autres);
      document.getElementById('fn-pct').textContent = (total/p*100).toFixed(1).replace('.',',') + ' %';
      document.getElementById('fn-budget').textContent = eur(p+total);
    }
    function init(){
      const r=document.getElementById('fn-prix'); if(!r||r.dataset.ready) return; r.dataset.ready='1';
      r.addEventListener('input',calc);
      document.querySelectorAll('#fn-type button').forEach(b=>b.addEventListener('click',()=>{
        document.querySelectorAll('#fn-type button').forEach(x=>x.classList.remove('on'));
        b.classList.add('on'); type=b.dataset.t; calc();
      }));
      calc();
    }
    init();
    document.addEventListener('astro:page-load',()=>{const r=document.getElementById('fn-prix');if(r)r.dataset.ready='';init();});
  })();
</script>
