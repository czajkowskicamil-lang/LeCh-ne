---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const title = "Simulateur de droits de succession 2026 (transmission aux enfants) | Le Chêne Patrimonial";
const description = "Combien vos enfants paieraient-ils de droits de succession ? Estimez gratuitement, avec l'abattement de 100 000 € et le barème officiel 2026. Et voyez ce qu'anticiper change.";
---

<Base title={title} description={description}>
  <header class="pt-16 pb-8 md:pt-24 md:pb-10">
    <div class="shell max-w-4xl">
      <nav class="text-xs uppercase tracking-micro text-stone mb-10 flex gap-3" aria-label="Fil d'ariane">
        <a href="/" class="hover:text-chene">Accueil</a>
        <span>/</span>
        <a href="/outils" class="hover:text-chene">Outils</a>
        <span>/</span>
        <span class="text-ink">Droits de succession</span>
      </nav>
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Transmission
      </p>
      <h1 class="font-serif text-display text-ink mb-6 leading-tight">Combien paieraient vos enfants ?</h1>
      <p class="text-xl text-ink/75 max-w-prose-wide leading-relaxed">
        La transmission est le sujet qu'on repousse toujours. Pourtant, quelques milliers d'euros de patrimoine transmis peuvent coûter cher à vos héritiers. Estimez-le, puis voyez ce qu'anticiper permet d'économiser.
      </p>
    </div>
  </header>

  <div class="shell max-w-5xl pb-16">
    <div class="tool-card">
      <div class="tool-grid">
        <div>
          <div class="tool-field">
            <label>Patrimoine transmis <b id="ds-pat-val">500 000 €</b></label>
            <input class="tool-range" type="range" id="ds-pat" min="0" max="3000000" step="10000" value="500000" />
          </div>
          <div class="tool-field">
            <label>Nombre d'enfants héritiers</label>
            <div class="tool-seg" id="ds-enf">
              <button data-n="1">1</button>
              <button class="on" data-n="2">2</button>
              <button data-n="3">3</button>
              <button data-n="4">4</button>
              <button data-n="5">5</button>
            </div>
          </div>
          <p class="tool-note">Transmission en ligne directe (parent vers enfants), à parts égales. Abattement de 100 000 € par enfant, barème officiel 2026. Hors conjoint survivant (exonéré), hors donations des 15 dernières années et hors cas particuliers (usufruit, handicap...).</p>
        </div>

        <div class="tool-result">
          <p class="lbl">Droits de succession à payer</p>
          <p class="big" id="ds-total">—</p>
          <div class="tool-brk"><span class="k">Abattement total appliqué</span><span class="v" id="ds-abat">—</span></div>
          <div class="tool-brk"><span class="k">Droits par enfant</span><span class="v" id="ds-parenf">—</span></div>
          <div class="tool-brk"><span class="k">Net réellement perçu par enfant</span><span class="v" id="ds-net">—</span></div>
          <div class="tool-brk"><span class="k">Taux effectif sur le patrimoine</span><span class="v" id="ds-taux">—</span></div>
        </div>
      </div>
    </div>

    <div class="max-w-prose-wide mt-14 prose-editorial">
      <h2>Le levier que personne n'active à temps</h2>
      <p>Chaque enfant bénéficie d'un abattement de <strong>100 000 €</strong> sur ce qu'il reçoit. Au-delà, le barème grimpe vite : 20 % dès 16 000 € taxables, jusqu'à 45 %. Sur un patrimoine conséquent, la note peut atteindre plusieurs centaines de milliers d'euros.</p>
      <p>La bonne nouvelle : cet abattement se <strong>renouvelle tous les 15 ans</strong> pour les donations. Donner de son vivant, au bon rythme et avec les bons outils (donation, démembrement, assurance-vie), permet souvent de réduire fortement, voire d'annuler, les droits à venir. Encore faut-il s'y prendre tôt.</p>
      <p>C'est exactement le travail que nous menons : transformer une facture subie en stratégie choisie.</p>
    </div>
  </div>

  <CTA />
</Base>

<script is:inline>
  (function () {
    const eur = n => Math.round(n).toLocaleString('fr-FR') + ' €';
    function droits(t){
      return Math.min(t,8072)*0.05
        + Math.max(0,Math.min(t,12109)-8072)*0.10
        + Math.max(0,Math.min(t,15932)-12109)*0.15
        + Math.max(0,Math.min(t,552324)-15932)*0.20
        + Math.max(0,Math.min(t,902838)-552324)*0.30
        + Math.max(0,Math.min(t,1805677)-902838)*0.40
        + Math.max(0,t-1805677)*0.45;
    }
    let nb=2;
    function calc(){
      const pat=+document.getElementById('ds-pat').value;
      const part=pat/nb;
      const taxable=Math.max(0,part-100000);
      const dEnf=droits(taxable);
      const dTot=dEnf*nb;
      document.getElementById('ds-pat-val').textContent=eur(pat);
      document.getElementById('ds-total').textContent=eur(dTot);
      document.getElementById('ds-abat').textContent=eur(100000*nb);
      document.getElementById('ds-parenf').textContent=eur(dEnf);
      document.getElementById('ds-net').textContent=eur(part-dEnf);
      document.getElementById('ds-taux').textContent=(pat>0?(dTot/pat*100):0).toFixed(1).replace('.',',')+' %';
    }
    function init(){
      const r=document.getElementById('ds-pat'); if(!r||r.dataset.ready) return; r.dataset.ready='1';
      r.addEventListener('input',calc);
      document.querySelectorAll('#ds-enf button').forEach(b=>b.addEventListener('click',()=>{
        document.querySelectorAll('#ds-enf button').forEach(x=>x.classList.remove('on'));
        b.classList.add('on'); nb=+b.dataset.n; calc();
      }));
      calc();
    }
    init();
    if(!window['__hk_ds-pat']){window['__hk_ds-pat']=1;document.addEventListener('astro:page-load',init);}
  })();
</script>
