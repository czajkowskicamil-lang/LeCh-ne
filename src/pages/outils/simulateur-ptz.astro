---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const title = "Simulateur PTZ 2026 — montant du Prêt à Taux Zéro par zone et revenu | Le Chêne Patrimonial";
const description = "Combien de Prêt à Taux Zéro pouvez-vous obtenir ? Estimez votre PTZ 2026 selon votre zone (A, B1, B2, C), la composition du foyer et vos revenus. Barème officiel.";
---

<Base title={title} description={description}>
  <header class="pt-16 pb-8 md:pt-24 md:pb-10">
    <div class="shell max-w-4xl">
      <nav class="text-xs uppercase tracking-micro text-stone mb-10 flex gap-3" aria-label="Fil d'ariane">
        <a href="/" class="hover:text-chene">Accueil</a>
        <span>/</span>
        <a href="/outils" class="hover:text-chene">Outils</a>
        <span>/</span>
        <span class="text-ink">Simulateur PTZ</span>
      </nav>
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Achat de la résidence principale
      </p>
      <h1 class="font-serif text-display text-ink mb-6 leading-tight">Combien de PTZ pour votre achat ?</h1>
      <p class="text-xl text-ink/75 max-w-prose-wide leading-relaxed">
        Le Prêt à Taux Zéro finance une partie de votre résidence principale sans intérêts. Son montant dépend de votre zone, de la taille de votre foyer et de vos revenus. Estimez le vôtre au barème officiel 2026.
      </p>
    </div>
  </header>

  <div class="shell max-w-5xl pb-16">
    <div class="tool-card">
      <div class="tool-grid">
        <div>
          <div class="tool-field">
            <label>Votre ville <b id="pz-ville-zone"></b></label>
            <input class="tool-input" list="pz-villes" id="pz-ville" placeholder="Tapez votre ville (100 plus grandes)" autocomplete="off" />
            <datalist id="pz-villes"></datalist>
          </div>
          <div class="tool-field">
            <label>Zone de la commune</label>
            <div class="tool-seg" id="pz-zone">
              <button class="on" data-z="A">A / A bis</button>
              <button data-z="B1">B1</button>
              <button data-z="B2">B2</button>
              <button data-z="C">C</button>
            </div>
          </div>
          <div class="tool-field">
            <label>Type de logement neuf</label>
            <div class="tool-seg" id="pz-type">
              <button class="on" data-t="appart">Appartement</button>
              <button data-t="maison">Maison</button>
            </div>
          </div>
          <div class="tool-field">
            <label>Personnes dans le foyer</label>
            <div class="tool-seg" id="pz-pers">
              <button data-n="1">1</button>
              <button class="on" data-n="2">2</button>
              <button data-n="3">3</button>
              <button data-n="4">4</button>
              <button data-n="5">5</button>
            </div>
          </div>
          <div class="tool-field">
            <label>Revenu fiscal de référence (année N-2) <b id="pz-rfr-val">40 000 €</b></label>
            <input class="tool-range" type="range" id="pz-rfr" min="0" max="130000" step="1000" value="40000" />
          </div>
          <div class="tool-field">
            <label>Coût total de l'opération <b id="pz-prix-val">250 000 €</b></label>
            <input class="tool-range" type="range" id="pz-prix" min="50000" max="700000" step="5000" value="250000" />
          </div>
          <p class="tool-note">Réservé aux primo-accédants (n'ayant pas été propriétaire de leur résidence principale depuis 2 ans) pour l'achat de leur résidence principale dans le neuf. Barème du décret n° 2025-299. Le revenu retenu est le plus élevé entre votre RFR (année N-2) et le coût de l'opération divisé par 9. Foyer au-delà de 5 personnes et ancien avec travaux non couverts ici.</p>
        </div>

        <div class="tool-result">
          <p class="lbl">Montant estimé du PTZ</p>
          <p class="big" id="pz-montant">—</p>
          <div class="tool-brk"><span class="k" id="pz-elig-k">Éligibilité</span><span class="v" id="pz-elig">—</span></div>
          <div class="tool-brk"><span class="k">Tranche de revenu</span><span class="v" id="pz-tranche">—</span></div>
          <div class="tool-brk"><span class="k">Quotité appliquée</span><span class="v" id="pz-quot">—</span></div>
          <div class="tool-brk"><span class="k">Coût de l'opération retenu</span><span class="v" id="pz-plaf">—</span></div>
        </div>
      </div>
    </div>

    <div class="max-w-prose-wide mt-14 prose-editorial">
      <h2>Comment lire votre PTZ</h2>
      <p>Vos revenus, ramenés à la taille de votre foyer, vous placent dans une tranche (de 1 à 4). Plus la tranche est basse, plus la quotité financée est forte : jusqu'à <strong>50 % du prix</strong> pour un appartement neuf en tranche 1, contre 20 % en tranche 4. Le montant est ensuite plafonné selon votre zone.</p>
      <p>Le PTZ ne se cumule pas seulement avec votre crédit principal : bien articulé avec votre apport et la durée, il peut faire baisser sensiblement votre mensualité. C'est un levier que nous intégrons dans le montage global de votre financement.</p>
    </div>
  </div>

  <CTA />
</Base>

<script is:inline>
  (function () {
    const eur = n => Math.round(n).toLocaleString('fr-FR') + ' €';
    const ZONES = {
      A:  { thr:[25000,31000,37000,49000], base:150000 },
      B1: { thr:[21500,26000,30000,34500], base:135000 },
      B2: { thr:[18000,22500,27000,31500], base:110000 },
      C:  { thr:[15000,19500,24000,28500], base:100000 },
    };
    const incomeCoeff=[1,1.5,1.8,2.1,2.4], opCoeff=[1,1.5,1.8,2.1,2.4];
    const quot={ appart:[50,40,40,20], maison:[30,20,20,10] };
    const VILLES=[
      {v:"Paris",z:"Abis"},{v:"Marseille",z:"A"},{v:"Lyon",z:"A"},{v:"Toulouse",z:"A"},{v:"Nice",z:"A"},{v:"Nantes",z:"A"},{v:"Montpellier",z:"A"},{v:"Strasbourg",z:"A"},{v:"Bordeaux",z:"A"},{v:"Lille",z:"A"},
      {v:"Rennes",z:"A"},{v:"Toulon",z:"A"},{v:"Reims",z:"B1"},{v:"Saint-Étienne",z:"B2"},{v:"Le Havre",z:"B1"},{v:"Villeurbanne",z:"A"},{v:"Dijon",z:"B1"},{v:"Angers",z:"B1"},{v:"Grenoble",z:"A"},{v:"Saint-Denis (La Réunion)",z:"B1"},
      {v:"Nîmes",z:"B1"},{v:"Aix-en-Provence",z:"A"},{v:"Saint-Denis (93)",z:"Abis"},{v:"Clermont-Ferrand",z:"B1"},{v:"Le Mans",z:"B1"},{v:"Brest",z:"B1"},{v:"Tours",z:"B1"},{v:"Amiens",z:"B1"},{v:"Annecy",z:"A"},{v:"Limoges",z:"B1"},
      {v:"Metz",z:"B1"},{v:"Perpignan",z:"B1"},{v:"Boulogne-Billancourt",z:"Abis"},{v:"Besançon",z:"B1"},{v:"Rouen",z:"B1"},{v:"Orléans",z:"B1"},{v:"Montreuil",z:"Abis"},{v:"Caen",z:"B1"},{v:"Saint-Paul (La Réunion)",z:"A"},{v:"Argenteuil",z:"A"},
      {v:"Mulhouse",z:"B1"},{v:"Nancy",z:"B1"},{v:"Tourcoing",z:"B1"},{v:"Roubaix",z:"B1"},{v:"Nanterre",z:"Abis"},{v:"Vitry-sur-Seine",z:"A"},{v:"Asnières-sur-Seine",z:"Abis"},{v:"Créteil",z:"A"},{v:"Avignon",z:"B1"},{v:"Colombes",z:"Abis"},
      {v:"Poitiers",z:"B1"},{v:"Aubervilliers",z:"Abis"},{v:"Aulnay-sous-Bois",z:"A"},{v:"Dunkerque",z:"B1"},{v:"Saint-Pierre (La Réunion)",z:"B1"},{v:"Versailles",z:"Abis"},{v:"Courbevoie",z:"Abis"},{v:"Rueil-Malmaison",z:"Abis"},{v:"Le Tampon",z:"B1"},{v:"Béziers",z:"B1"},
      {v:"Pau",z:"B1"},{v:"La Rochelle",z:"A"},{v:"Cherbourg-en-Cotentin",z:"B1"},{v:"Mérignac",z:"A"},{v:"Champigny-sur-Marne",z:"A"},{v:"Antibes",z:"A"},{v:"Saint-Maur-des-Fossés",z:"Abis"},{v:"Ajaccio",z:"A"},{v:"Fort-de-France",z:"B1"},{v:"Saint-Nazaire",z:"B1"},
      {v:"Cannes",z:"A"},{v:"Noisy-le-Grand",z:"A"},{v:"Drancy",z:"A"},{v:"Cergy",z:"A"},{v:"Levallois-Perret",z:"Abis"},{v:"Issy-les-Moulineaux",z:"Abis"},{v:"Calais",z:"B1"},{v:"Pessac",z:"A"},{v:"Colmar",z:"B1"},{v:"Évry-Courcouronnes",z:"A"},
      {v:"Vénissieux",z:"B1"},{v:"Ivry-sur-Seine",z:"Abis"},{v:"Valence",z:"B1"},{v:"Clichy",z:"Abis"},{v:"Quimper",z:"B1"},{v:"Antony",z:"Abis"},{v:"Bourges",z:"B2"},{v:"La Seyne-sur-Mer",z:"A"},{v:"Montauban",z:"B1"},{v:"Villeneuve-d'Ascq",z:"B1"},
      {v:"Cayenne",z:"B1"},{v:"Le Blanc-Mesnil",z:"A"},{v:"Troyes",z:"B1"},{v:"Pantin",z:"Abis"},{v:"Villejuif",z:"Abis"},{v:"Chambéry",z:"B1"},{v:"Niort",z:"B2"},{v:"Fréjus",z:"A"},{v:"Neuilly-sur-Seine",z:"Abis"},{v:"Sarcelles",z:"A"}
    ];
    let zone='A', type='appart', pers=2;
    function calc(){
      const rfr=+document.getElementById('pz-rfr').value, prix=+document.getElementById('pz-prix').value;
      document.getElementById('pz-rfr-val').textContent=eur(rfr);
      document.getElementById('pz-prix-val').textContent=eur(prix);
      const z=ZONES[zone], revenu=Math.max(rfr, prix/9), q=revenu/incomeCoeff[pers-1];
      let tranche = q<=z.thr[0]?1 : q<=z.thr[1]?2 : q<=z.thr[2]?3 : q<=z.thr[3]?4 : 0;
      const eligEl=document.getElementById('pz-elig');
      if(tranche===0){
        document.getElementById('pz-montant').textContent='0 €';
        eligEl.textContent='Revenus trop élevés'; eligEl.style.color='#e08a70';
        document.getElementById('pz-tranche').textContent='—';
        document.getElementById('pz-quot').textContent='—';
        document.getElementById('pz-plaf').textContent='—';
        return;
      }
      const quotite=quot[type][tranche-1];
      const plafond=z.base*opCoeff[pers-1];
      const retenu=Math.min(prix,plafond);
      const montant=retenu*quotite/100;
      document.getElementById('pz-montant').textContent=eur(montant);
      eligEl.textContent='Éligible'; eligEl.style.color='#7bbd90';
      document.getElementById('pz-tranche').textContent='Tranche '+tranche;
      document.getElementById('pz-quot').textContent=quotite+' %';
      document.getElementById('pz-plaf').textContent=eur(retenu);
    }
    function seg(id,set){document.querySelectorAll('#'+id+' button').forEach(b=>b.addEventListener('click',()=>{
      document.querySelectorAll('#'+id+' button').forEach(x=>x.classList.remove('on'));b.classList.add('on');set(b);calc();}));}
    function init(){
      const r=document.getElementById('pz-rfr'); if(!r||r.dataset.ready) return; r.dataset.ready='1';
      ['pz-rfr','pz-prix'].forEach(id=>document.getElementById(id).addEventListener('input',calc));
      seg('pz-zone',b=>{zone=b.dataset.z;const vi=document.getElementById('pz-ville');if(vi){vi.value='';document.getElementById('pz-ville-zone').textContent='';}});
      seg('pz-type',b=>type=b.dataset.t);
      seg('pz-pers',b=>pers=+b.dataset.n);
      const dl=document.getElementById('pz-villes');
      dl.innerHTML=VILLES.map(c=>'<option value="'+c.v+'"></option>').join('');
      const vi=document.getElementById('pz-ville');
      vi.addEventListener('input',()=>{
        const c=VILLES.find(x=>x.v.toLowerCase()===vi.value.trim().toLowerCase());
        if(!c) return;
        zone=(c.z==='Abis'||c.z==='A')?'A':c.z;
        document.querySelectorAll('#pz-zone button').forEach(x=>x.classList.toggle('on',x.dataset.z===zone));
        document.getElementById('pz-ville-zone').textContent='· Zone '+c.z;
        calc();
      });
      calc();
    }
    init();
    document.addEventListener('astro:page-load',()=>{const r=document.getElementById('pz-rfr');if(r)r.dataset.ready='';init();});
  })();
</script>
