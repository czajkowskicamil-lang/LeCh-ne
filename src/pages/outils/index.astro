---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const title = "Outils patrimoniaux gratuits — simulateurs immobilier, crédit, transmission | Le Chêne Patrimonial";
const description = "Des simulateurs simples et gratuits pour y voir clair : frais de notaire, capacité d'emprunt, rentabilité locative, transmission. Calculez, comprenez, décidez.";

const outils = [
  { titre: "Rentabilité locative", desc: "Prix, loyer, crédit, assurance : votre cash flow réel, mois par mois.", href: "/calculatrice-rentabilite-credit", tag: "Immobilier", live: true },
  { titre: "Frais de notaire", desc: "Combien allez-vous vraiment payer chez le notaire, dans l'ancien ou le neuf.", href: "/outils/frais-de-notaire", tag: "Achat", live: true },
  { titre: "Capacité d'emprunt", desc: "Combien pouvez-vous emprunter selon vos revenus et la durée du prêt.", href: "/outils/capacite-emprunt", tag: "Crédit", live: true },
  { titre: "Simulateur PTZ", desc: "Le montant de votre Prêt à Taux Zéro selon votre zone, votre foyer et vos revenus.", href: "/outils/simulateur-ptz", tag: "Primo-accédant", live: true },
  { titre: "Droits de succession", desc: "Ce que vos héritiers paieraient, et combien anticiper permet d'économiser.", href: "/outils/droits-succession", tag: "Transmission", live: true },
  { titre: "Plus-value immobilière", desc: "L'impôt sur la revente d'un bien locatif ou d'une résidence secondaire.", href: "/outils/plus-value-immobiliere", tag: "Immobilier", live: true },
  { titre: "Investissement LMNP", desc: "Votre revenu locatif net après amortissement, en meublé.", href: "/outils/lmnp", tag: "Immobilier", live: true },
  { titre: "Économie d'impôt (PER)", desc: "Combien un versement sur votre PER réduit votre impôt.", href: "/outils/economie-impot-per", tag: "Fiscalité", live: true },
  { titre: "Louer ou acheter ?", desc: "Le match, chiffré, entre rester locataire et devenir propriétaire.", href: "/outils/louer-ou-acheter", tag: "Immobilier", live: true },
  { titre: "Intérêts composés", desc: "Ce que votre épargne peut devenir dans 10, 20 ou 30 ans.", href: "/outils/interets-composes", tag: "Épargne", live: true },
];
---

<Base title={title} description={description}>
  <header class="pt-16 pb-10 md:pt-24 md:pb-14">
    <div class="shell max-w-4xl">
      <nav class="text-xs uppercase tracking-micro text-stone mb-10 flex gap-3" aria-label="Fil d'ariane">
        <a href="/" class="hover:text-chene">Accueil</a>
        <span>/</span>
        <span class="text-ink">Outils</span>
      </nav>
      <p class="eyebrow mb-6 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Étude patrimoniale & outils
      </p>
      <h1 class="font-serif text-display text-ink mb-8 leading-tight">Calculez, comprenez, décidez.</h1>
      <p class="text-xl text-ink/75 max-w-prose-wide leading-relaxed">
        Commencez par votre étude patrimoniale personnalisée, puis affinez avec nos simulateurs. Sans jargon, et si vous voulez aller plus loin, on en parle ensemble.
      </p>
    </div>
  </header>

  <!-- ================= Porte d'entrée gratuite : Diagnostic patrimonial ================= -->
  <section class="shell max-w-5xl pb-6">
    <a href="/outils/diagnostic-patrimonial" class="group block relative overflow-hidden rounded-3xl bg-cream-soft border border-chene/25 p-8 md:p-10 transition-all duration-300 hover:border-chene/50 hover:-translate-y-1">
      <div class="md:flex md:items-center md:gap-10">
        <div class="md:flex-1">
          <p class="text-xs uppercase tracking-micro text-chene font-semibold mb-4 flex items-center gap-3">
            <span class="inline-block h-px w-8 bg-chene"></span>
            Commencez ici · Gratuit · 3 minutes
          </p>
          <h2 class="font-serif text-display-sm text-ink mb-3 leading-tight">Votre Diagnostic Patrimonial Intelligent</h2>
          <p class="text-ink/70 leading-relaxed mb-6 max-w-prose-wide">
            Quelques questions guidées, une seule à la fois, et vous obtenez votre Indice de Santé Patrimoniale sur 100 : forces, angles morts, opportunités d'optimisation et plan d'action sur 12 mois. Le point de départ idéal, avant d'aller plus loin.
          </p>
          <span class="inline-flex items-center gap-2 bg-ink text-cream font-semibold rounded-xl px-6 py-3.5 group-hover:bg-chene transition">
            Lancer mon diagnostic
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </div>
        <div class="hidden md:flex md:w-44 shrink-0 flex-col items-center text-center border-l border-chene/20 pl-8">
          <div class="font-serif text-6xl text-chene leading-none">/100</div>
          <p class="text-stone text-xs mt-3 leading-relaxed">Votre indice de santé patrimoniale, calculé en direct</p>
        </div>
      </div>
    </a>
  </section>

  <!-- ================= Prestation phare : Étude patrimoniale ================= -->
  <section class="shell max-w-5xl pb-14 md:pb-16">
    <a href="/outils/etude-patrimoniale" class="group block relative overflow-hidden rounded-3xl bg-navy-deep border border-or/25 p-8 md:p-12 transition-all duration-300 hover:border-or/50 hover:-translate-y-1">
      <div class="md:flex md:items-center md:gap-12">
        <div class="md:flex-1">
          <p class="text-xs uppercase tracking-micro text-or-light font-semibold mb-5 flex items-center gap-3">
            <span class="inline-block h-px w-8 bg-or"></span>
            Notre prestation phare
          </p>
          <h2 class="font-serif text-display-sm text-cream mb-4 leading-tight">Votre étude patrimoniale personnalisée</h2>
          <p class="text-cream/75 leading-relaxed mb-7 max-w-prose-wide">
            Le bilan qu'un conseiller mène en rendez-vous, mais en ligne : foyer, revenus, patrimoine, crédits et objectifs. Vous obtenez une estimation de votre imposition, la lecture de votre patrimoine et vos pistes d'optimisation, calibrées selon votre statut.
          </p>
          <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2.5 mb-9 text-sm text-cream/85">
            <li class="flex items-start gap-2.5"><svg class="mt-0.5 shrink-0 text-or-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Diagnostic fiscal complet (impôt, TMI, parts)</li>
            <li class="flex items-start gap-2.5"><svg class="mt-0.5 shrink-0 text-or-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Lecture de votre patrimoine (net, IFI, endettement)</li>
            <li class="flex items-start gap-2.5"><svg class="mt-0.5 shrink-0 text-or-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Pistes calibrées par statut (sportif, TNS, dirigeant)</li>
            <li class="flex items-start gap-2.5"><svg class="mt-0.5 shrink-0 text-or-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Étude PDF nominative à votre nom</li>
          </ul>
          <span class="inline-flex items-center gap-2 bg-or text-navy-deep font-semibold rounded-xl px-6 py-3.5 group-hover:bg-or-light transition">
            Commencer mon étude
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </div>
        <div class="hidden md:block md:w-52 text-center shrink-0 border-l border-or/20 pl-10">
          <p class="text-cream/55 text-xs uppercase tracking-micro mb-2">Étude PDF</p>
          <p class="font-serif text-5xl text-or-light leading-none">10 €</p>
          <p class="text-cream/50 text-xs mt-4 leading-relaxed">ou un premier échange offert de 30 min avec Camil</p>
        </div>
      </div>
    </a>
  </section>

  <div class="shell max-w-5xl pb-20 md:pb-28">
    <p class="eyebrow mb-8 flex items-center gap-3">
      <span class="inline-block h-px w-8 bg-chene"></span>
      Et nos simulateurs gratuits
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {outils.map((o) => (
        o.live ? (
          <a href={o.href} class="group bg-cream-soft border border-ink/10 rounded-2xl p-7 transition-all duration-300 hover:border-chene/40 hover:-translate-y-1 flex flex-col">
            <p class="text-xs uppercase tracking-micro text-chene font-semibold mb-3">{o.tag}</p>
            <h2 class="font-serif text-2xl text-ink mb-2 group-hover:text-chene transition">{o.titre}</h2>
            <p class="text-ink/70 text-sm leading-relaxed mb-5 flex-1">{o.desc}</p>
            <span class="text-sm font-medium text-or-dark inline-flex items-center gap-2">Ouvrir l'outil
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        ) : (
          <div class="bg-cream-soft/50 border border-ink/8 rounded-2xl p-7 flex flex-col opacity-80">
            <div class="flex items-center justify-between mb-3">
              <p class="text-xs uppercase tracking-micro text-stone font-semibold">{o.tag}</p>
              <span class="text-[0.65rem] uppercase tracking-wide font-bold text-or-dark bg-or/12 rounded-full px-2.5 py-1">Bientôt</span>
            </div>
            <h2 class="font-serif text-2xl text-ink/70 mb-2">{o.titre}</h2>
            <p class="text-ink/55 text-sm leading-relaxed flex-1">{o.desc}</p>
          </div>
        )
      ))}
    </div>

    <p class="text-sm text-stone mt-10 max-w-prose-wide">
      Ces outils donnent des ordres de grandeur à visée pédagogique. Ils ne remplacent pas une étude adaptée à votre situation.
    </p>
  </div>

  <CTA />
</Base>
