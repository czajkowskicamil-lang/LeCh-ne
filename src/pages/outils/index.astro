---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CTA from '../../components/CTA.astro';

const title = "Outils patrimoniaux gratuits : simulateurs immobilier, crédit, fiscalité | Le Chêne Patrimonial";
const description = "Seize simulateurs gratuits pour y voir clair : frais de notaire, capacité d'emprunt, rentabilité locative, impôt, transmission. Sans inscription.";

// Catégories des filtres. L'ordre est celui de la barre.
const familles = [
  { id: 'tout', label: 'Tous les outils' },
  { id: 'immobilier', label: 'Immobilier' },
  { id: 'credit', label: 'Crédit' },
  { id: 'fiscalite', label: 'Fiscalité' },
  { id: 'epargne', label: 'Épargne' },
  { id: 'transmission', label: 'Transmission' },
  { id: 'sportifs', label: 'Sportifs' },
];

// livrable = ce que l'outil rend, en toutes lettres. C'est la promesse, pas la méthode.
const outils = [
  { titre: "Rentabilité locative", desc: "Prix, loyer, crédit, assurance : votre cash flow réel, mois par mois.", href: "/calculatrice-rentabilite-credit", cat: 'immobilier', tag: "Immobilier", livrable: "Votre cash flow mensuel", duree: "2 min", phare: true },
  { titre: "Le compte à rebours de l'après-carrière", desc: "Un jour, les revenus du sport s'arrêtent. Visualisez la falaise et le capital qui vous rend libre.", href: "/outils/apres-carriere", cat: 'sportifs', tag: "Sportifs de haut niveau", livrable: "Votre capital liberté", duree: "3 min", phare: true, signature: true },
  { titre: "À quel âge serez-vous libre ?", desc: "Le jour où votre patrimoine vous fait vivre sans salaire, et le chemin pour y arriver plus tôt.", href: "/outils/liberte-financiere", cat: 'epargne', tag: "Indépendance financière", livrable: "L'âge de votre liberté", duree: "2 min", phare: true, signature: true },
  { titre: "Plus-value LMNP", desc: "Depuis la réforme 2025, les amortissements déduits gonflent la plus-value à la revente.", href: "/outils/plus-value-lmnp", cat: 'immobilier', tag: "Immobilier", livrable: "L'impôt à la revente", duree: "2 min", nouveau: true },
  { titre: "Frais de notaire", desc: "Ce que vous payez vraiment chez le notaire, dans l'ancien comme dans le neuf.", href: "/outils/frais-de-notaire", cat: 'immobilier', tag: "Achat", livrable: "Le montant à prévoir", duree: "30 s" },
  { titre: "Capacité d'emprunt", desc: "Ce que la banque peut vous prêter, selon vos revenus et la durée.", href: "/outils/capacite-emprunt", cat: 'credit', tag: "Crédit", livrable: "Votre enveloppe d'achat", duree: "1 min" },
  { titre: "Simulateur de prêt", desc: "Votre mensualité, le coût total du crédit et votre taux d'endettement.", href: "/outils/simulateur-pret", cat: 'credit', tag: "Crédit", livrable: "Votre mensualité", duree: "1 min" },
  { titre: "Simulateur PTZ", desc: "Le montant de votre prêt à taux zéro selon votre zone, votre foyer et vos revenus.", href: "/outils/simulateur-ptz", cat: 'credit', tag: "Primo-accédant", livrable: "Votre montant de PTZ", duree: "1 min" },
  { titre: "Impôt sur le revenu", desc: "Décryptez votre avis et calculez votre impôt 2026, au barème officiel.", href: "/outils/impot-sur-le-revenu", cat: 'fiscalite', tag: "Fiscalité", livrable: "Votre impôt 2026", duree: "2 min" },
  { titre: "Économie d'impôt (PER)", desc: "Combien un versement sur votre PER réduit votre impôt cette année.", href: "/outils/economie-impot-per", cat: 'fiscalite', tag: "Fiscalité", livrable: "Votre économie d'impôt", duree: "30 s" },
  { titre: "Investissement LMNP", desc: "En meublé au réel, l'amortissement efface souvent l'impôt sur vos loyers.", href: "/outils/lmnp", cat: 'immobilier', tag: "Immobilier", livrable: "Votre revenu imposable", duree: "1 min" },
  { titre: "Plus-value immobilière", desc: "L'impôt sur la revente d'un bien locatif ou d'une résidence secondaire.", href: "/outils/plus-value-immobiliere", cat: 'immobilier', tag: "Immobilier", livrable: "L'impôt à la revente", duree: "1 min" },
  { titre: "Louer ou acheter ?", desc: "Le match, chiffré, entre rester locataire et devenir propriétaire.", href: "/outils/louer-ou-acheter", cat: 'immobilier', tag: "Immobilier", livrable: "Le verdict chiffré", duree: "2 min" },
  { titre: "Droits de succession", desc: "Ce que vos héritiers paieraient, et combien anticiper permet d'économiser.", href: "/outils/droits-succession", cat: 'transmission', tag: "Transmission", livrable: "Les droits à payer", duree: "1 min" },
  { titre: "Intérêts composés", desc: "Ce que votre épargne peut devenir dans 10, 20 ou 30 ans.", href: "/outils/interets-composes", cat: 'epargne', tag: "Épargne", livrable: "Votre capital futur", duree: "30 s" },
];

const compte = outils.length + 1; // les simulateurs, plus le diagnostic
---

<Base heroDark title={title} description={description}>
  <PageHeader
    image="/outils-header.jpg"
    alt="Chemin en forêt vers la lumière"
    eyebrow={`${compte} outils gratuits · Sans inscription`}
    title="Calculez, comprenez, décidez."
    intro="Un chiffre juste vaut mieux qu'une intuition. Commencez par votre diagnostic, puis affinez avec le simulateur qui correspond à votre question. Aucun résultat n'est conservé sans votre accord."
  />

  <!-- ================= Porte d'entrée : le diagnostic patrimonial ================= -->
  <section class="shell max-w-5xl pb-10">
    <a href="/outils/diagnostic-patrimonial" class="group block relative overflow-hidden bg-navy-deep text-cream p-8 md:p-12 transition-all duration-300 hover:-translate-y-1">
      <div class="md:flex md:items-center md:gap-12">
        <div class="md:flex-1">
          <p class="text-xs uppercase tracking-micro text-or-light font-semibold mb-5 flex items-center gap-3">
            <span class="inline-block h-px w-8 bg-or"></span>
            Commencez ici · Gratuit · 3 minutes
          </p>
          <h2 class="font-serif text-display-sm text-cream mb-4 leading-tight">Votre Diagnostic Patrimonial</h2>
          <p class="text-cream/75 leading-relaxed mb-7 max-w-prose-wide">
            Quelques questions guidées, une seule à la fois. Vous repartez avec votre Indice de Santé Patrimoniale sur 100 : vos forces, vos angles morts, et un plan d'action sur douze mois. Si vous ne savez pas par où commencer, commencez par là.
          </p>
          <span class="inline-flex items-center gap-2 bg-or text-ink font-semibold px-7 py-3.5 group-hover:bg-or-light transition-colors">
            Lancer mon diagnostic
            <svg class="transition-transform duration-300 group-hover:translate-x-1" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </div>
        <div class="hidden md:flex md:w-48 shrink-0 flex-col items-center text-center border-l border-or/25 pl-10">
          <div class="font-serif text-7xl text-or-light leading-none">/100</div>
          <p class="text-cream/60 text-xs mt-4 leading-relaxed">Votre indice de santé patrimoniale, calculé en direct</p>
        </div>
      </div>
    </a>
  </section>

  <!-- ================= Les simulateurs, filtrables ================= -->
  <div class="shell max-w-5xl pb-20 md:pb-28">
    <div class="flex flex-wrap items-baseline justify-between gap-4 mb-7">
      <p class="eyebrow flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Et {outils.length} simulateurs pour creuser
      </p>
      <p id="ot-count" class="text-sm text-stone" aria-live="polite"></p>
    </div>

    <div class="ot-filtres" role="group" aria-label="Filtrer les outils par thème">
      {familles.map((f) => (
        <button type="button" class:list={['ot-f', f.id === 'tout' && 'on']} data-cat={f.id}>{f.label}</button>
      ))}
    </div>

    <div id="ot-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-7">
      {outils.map((o) => (
        <a href={o.href} class="ot-card group" data-cat={o.cat}>
          <div class="flex items-center justify-between gap-3 mb-3">
            <p class="ot-tag">{o.tag}</p>
            {o.nouveau && <span class="ot-badge">Nouveau</span>}
            {o.signature && !o.nouveau && <span class="ot-badge ot-badge-sig">Signature</span>}
          </div>
          <h2 class="font-serif text-2xl text-ink mb-2.5 leading-snug group-hover:text-chene transition-colors">{o.titre}</h2>
          <p class="text-ink/70 text-sm leading-relaxed mb-6 flex-1">{o.desc}</p>
          <div class="ot-foot">
            <span class="ot-livrable">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              {o.livrable}
            </span>
            <span class="ot-duree">{o.duree}</span>
          </div>
        </a>
      ))}
    </div>

    <p id="ot-vide" class="hidden text-center text-stone py-14">Aucun outil dans ce thème pour le moment.</p>

    <p class="text-sm text-stone mt-12 max-w-prose-wide leading-relaxed">
      Ces outils donnent des ordres de grandeur à visée pédagogique. Ils ne remplacent pas une étude adaptée à votre situation, et ne constituent pas un conseil en investissement.
    </p>
  </div>

  <CTA />
</Base>

<style is:global>
  /* Barre de filtres */
  .ot-filtres{display:flex;flex-wrap:wrap;gap:8px;}
  .ot-f{background:transparent;border:1px solid rgba(26,35,50,.16);color:#4a5568;font:600 .82rem system-ui,sans-serif;padding:9px 17px;border-radius:999px;cursor:pointer;transition:all .2s ease;}
  .ot-f:hover{border-color:rgba(184,140,58,.55);color:#1a2332;}
  .ot-f.on{background:#1a2332;border-color:#1a2332;color:#F2EDE4;}

  /* Cartes outils */
  .ot-card{display:flex;flex-direction:column;background:#FAF7F0;border:1px solid rgba(26,35,50,.1);padding:26px 24px 20px;transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease;}
  .ot-card:hover{transform:translateY(-4px);border-color:rgba(184,140,58,.5);box-shadow:0 14px 34px -18px rgba(26,35,50,.35);}
  .ot-card.off{display:none;}
  .ot-tag{font-size:.68rem;text-transform:uppercase;letter-spacing:.11em;font-weight:700;color:#B88C3A;}
  .ot-badge{font-size:.62rem;text-transform:uppercase;letter-spacing:.09em;font-weight:800;color:#161B26;background:#C9A55C;padding:3px 9px;border-radius:999px;white-space:nowrap;}
  .ot-badge-sig{background:transparent;color:#B88C3A;border:1px solid rgba(184,140,58,.5);}
  .ot-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:14px;border-top:1px solid rgba(26,35,50,.09);}
  .ot-livrable{display:inline-flex;align-items:center;gap:7px;font-size:.8rem;font-weight:600;color:#C9A55C;line-height:1.3;}
  .ot-livrable svg{flex:none;color:#B88C3A;}
  .ot-duree{font-size:.72rem;color:#8a8579;white-space:nowrap;}

  @media (prefers-reduced-motion: reduce){
    .ot-card,.ot-card:hover{transition:none;transform:none;}
  }
</style>

<script is:inline>
  (function () {
    function init() {
      const barre = document.querySelector('.ot-filtres');
      if (!barre || barre.dataset.ready) return;
      barre.dataset.ready = '1';

      const boutons = Array.prototype.slice.call(barre.querySelectorAll('.ot-f'));
      const cartes = Array.prototype.slice.call(document.querySelectorAll('.ot-card'));
      const compteur = document.getElementById('ot-count');
      const vide = document.getElementById('ot-vide');

      function appliquer(cat) {
        let visibles = 0;
        cartes.forEach((c) => {
          const ok = cat === 'tout' || c.dataset.cat === cat;
          c.classList.toggle('off', !ok);
          if (ok) visibles++;
        });
        if (compteur) compteur.textContent = visibles + (visibles > 1 ? ' outils affichés' : ' outil affiché');
        if (vide) vide.classList.toggle('hidden', visibles > 0);
      }

      boutons.forEach((b) => b.addEventListener('click', () => {
        boutons.forEach((o) => o.classList.remove('on'));
        b.classList.add('on');
        appliquer(b.dataset.cat);
      }));

      appliquer('tout');
    }
    init();
    if (!window.__ot_hooked) { window.__ot_hooked = 1; document.addEventListener('astro:page-load', init); }
  })();
</script>
