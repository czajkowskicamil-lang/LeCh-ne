---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ExpertiseGrid from '../../components/ExpertiseGrid.astro';
import CTA from '../../components/CTA.astro';
---

<Base
  heroDark
  title="Expertise patrimoniale, Le Chêne Patrimonial"
  description="Dix piliers de la gestion de patrimoine traités en profondeur : PER, assurance-vie, SCPI, défiscalisation, transmission, immobilier, PEA, private equity."
>
  <PageHeader
    image="/expertise-header.jpg"
    alt="Chêne majestueux dans un paysage"
    eyebrow="Expertise patrimoniale"
    title={`Dix piliers.<br/><span class="italic text-or-light">Une méthode.</span>`}
    intro="Chaque thématique traitée en profondeur : le pourquoi, le comment, les chiffres-clés, les pièges classiques, la FAQ. Pour décider en connaissance de cause."
  />

  <section class="py-8 md:py-10 bg-cream border-b border-ink/10">
    <div class="shell">
      <p class="text-sm text-ink/70 max-w-2xl leading-relaxed">
        <span class="uppercase tracking-micro text-[0.7rem] text-chene mr-2">Lecture conseillée</span>
        Commencez par l'<a class="link-underline text-chene" href="/expertise/assurance-vie">assurance-vie</a> et le <a class="link-underline text-chene" href="/expertise/plan-epargne-retraite">PER</a>, ils forment le socle de 80&nbsp;% des stratégies patrimoniales.
      </p>
    </div>
  </section>

  <ExpertiseGrid title="Les dix piliers" eyebrow="Tous les sujets" />
  <CTA />
</Base>
