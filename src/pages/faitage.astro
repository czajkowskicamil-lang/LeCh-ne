---
import Base from '../layouts/Base.astro';
import LogoFaitage from '../components/LogoFaitage.astro';
import QuestionnaireFaitage from '../components/QuestionnaireFaitage.astro';
import { temoignages } from '../data/temoignages';

// Page commerciale, pas page de marque. L'ordre est celui de la décision :
// promesse, action, preuves. Le questionnaire arrive avant tout discours sur
// nous, parce que c'est lui qui transforme un visiteur en contact.
//
// Le Faitage est une marque du cabinet, jamais présentée comme un tiers :
// l'annoncer autrement serait trompeur au sens de l'article L121-2 du code de
// la consommation.

const recus = [
  {
    t: 'Deux ou trois biens, pas deux cents',
    d: "Une sélection courte, choisie pour votre situation fiscale et votre budget. Vous n'avez pas à trier, c'est déjà fait.",
  },
  {
    t: 'Les chiffres complets de chaque bien',
    d: "Prix, loyer mensuel, rendement, durée du bail, exploitant. Repris de la fiche officielle du promoteur, jamais reconstitués.",
  },
  {
    t: 'Ce que ça donne chez vous',
    d: "Effort d'épargne réel, fiscalité applicable à votre tranche, et ce que le bien change à votre situation. C'est là qu'est le travail.",
  },
];

const etapes = [
  { n: '01', t: 'Vous décrivez votre projet', d: 'Deux minutes, quelques questions. Rien à préparer.' },
  { n: '02', t: 'On cherche, on vérifie', d: "Dans les biens du cabinet et chez nos partenaires promoteurs, y compris ce qui n'est pas publié." },
  { n: '03', t: 'On vous répond sous 24 h', d: "Par une personne qui a lu vos réponses, avec les chiffres et les réserves s'il y en a." },
];

// Deux avis clients réels, déjà validés et publiés sur /avis.
const avis = temoignages.slice(0, 2);
---

<Base
  title="Le Faitage, trouvez le bien qui correspond à votre situation"
  description="Décrivez votre projet immobilier en deux minutes : on vous répond sous 24 h avec deux ou trois biens qui tiennent la route pour vous, chiffres complets à l'appui. Sans engagement."
>
  <!-- Promesse -->
  <section class="relative isolate bg-navy-deep text-cream overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      style="background:radial-gradient(130% 90% at 18% 0%, rgba(120,133,64,.34), transparent 62%), radial-gradient(90% 80% at 100% 100%, rgba(212,168,45,.16), transparent 58%)"
    >
    </div>

    <div class="shell relative pt-12 pb-16 md:pt-16 md:pb-20">
      <LogoFaitage size={122} layout="empile" class="text-or-light" />

      <div class="mt-10 md:mt-12 grid lg:grid-cols-12 gap-x-16 gap-y-8 items-end">
        <div class="lg:col-span-7">
          <h1 class="font-serif text-[2.1rem] sm:text-[2.7rem] lg:text-[3.1rem] text-cream leading-[1.08]">
            On ne vous envoie pas un catalogue.
            <span class="italic text-or-light">Deux ou trois biens qui tiennent la route.</span>
          </h1>
        </div>

        <div class="lg:col-span-5">
          <p class="text-[1.15rem] text-cream/80 leading-relaxed">
            Dites-nous ce que vous cherchez et dans quelle situation vous êtes. On
            revient sous 24 heures avec une sélection courte, les chiffres complets, et
            ce que ça donne concrètement chez vous.
          </p>

          <a
            href="#questionnaire"
            class="btn-or mt-8 inline-flex items-center gap-2.5"
          >
            Décrire ma recherche
            <span class="opacity-60 text-[0.8em]">2 min</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
            </svg>
          </a>

          <p class="mt-5 text-[13px] text-cream/55 leading-relaxed">
            Gratuit et sans engagement. Aucune donnée revendue, aucun appel automatisé.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Le convertisseur, tout de suite -->
  <QuestionnaireFaitage />

  <!-- Ce que vous recevez -->
  <section class="py-16 md:py-24">
    <div class="shell">
      <div class="max-w-2xl mb-12">
        <div class="border-t-2 border-or w-11 mb-4"></div>
        <h2 class="font-serif text-3xl md:text-[2.6rem] text-ink leading-tight">
          Ce que vous recevez en retour
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-ink/10 border border-ink/10">
        {
          recus.map((r, i) => (
            <div class="bg-cream-soft/60 p-7 md:p-8">
              <div class="text-[13px] font-semibold text-kaki tabular-nums">0{i + 1}</div>
              <h3 class="font-serif text-[1.4rem] text-ink leading-snug mt-3">{r.t}</h3>
              <p class="text-[15px] text-stone mt-2.5 leading-relaxed">{r.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Comment ça se passe -->
  <section class="pb-16 md:pb-24">
    <div class="shell">
      <div class="bg-cream-soft border border-ink/10 px-6 sm:px-12 py-12 md:py-14">
        <h2 class="font-serif text-[1.75rem] md:text-3xl text-ink mb-10">Comment ça se passe</h2>
        <div class="grid md:grid-cols-3 gap-10 md:gap-12">
          {
            etapes.map((e) => (
              <div>
                <div class="font-serif text-[2.2rem] text-or-dark leading-none">{e.n}</div>
                <h3 class="text-[1.05rem] font-semibold text-ink mt-3">{e.t}</h3>
                <p class="text-[14.5px] text-stone mt-2 leading-relaxed">{e.d}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Preuves -->
  <section class="pb-16 md:pb-24">
    <div class="shell grid lg:grid-cols-12 gap-x-14 gap-y-10">
      <div class="lg:col-span-5">
        <div class="border-t-2 border-or w-11 mb-4"></div>
        <h2 class="font-serif text-3xl md:text-[2.4rem] text-ink leading-tight">
          Pourquoi passer par nous
        </h2>
        <p class="text-ink/70 leading-relaxed mt-4">
          Le Faitage est la marque immobilière du Chêne Patrimonial, cabinet de conseil
          en gestion de patrimoine indépendant. Ce n'est pas un portail de plus : la
          personne qui vous répond est celle qui suivra votre dossier.
        </p>

        <dl class="mt-8 space-y-3.5 text-[14.5px]">
          {
            [
              ['Cabinet', 'Indépendant, sans actionnaire à servir'],
              ['Immatriculations', 'ORIAS n° 25 00 00 16 · carte T n° CPI 3402 2024 000 000 049'],
              ['Couverture', 'France entière, en présentiel ou à distance'],
              ['Réponse', 'Sous 24 heures ouvrées, par un humain'],
            ].map(([k, v]) => (
              <div class="grid grid-cols-[112px_1fr] gap-4 border-b border-ink/8 pb-3.5">
                <dt class="text-[0.6rem] uppercase tracking-micro text-stone pt-1">{k}</dt>
                <dd class="text-ink">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-5 content-start">
        {
          avis.map((a) => (
            <figure class="border border-ink/10 bg-white p-7 flex flex-col">
              <svg width="26" height="20" viewBox="0 0 26 20" fill="none" class="text-or mb-4">
                <path
                  d="M0 20V12.6C0 5.9 3.5 1.6 10.4 0l1.3 3.4C7.6 4.7 5.5 7 5.3 10.2h4.4V20H0Zm14.6 0V12.6C14.6 5.9 18.1 1.6 25 0l1.3 3.4C22.2 4.7 20.1 7 19.9 10.2h4.4V20h-9.7Z"
                  fill="currentColor"
                />
              </svg>
              <blockquote class="text-[14.5px] text-ink/85 leading-relaxed flex-1">
                {a.quote}
              </blockquote>
              <figcaption class="mt-5 pt-4 border-t border-ink/10 text-[13px]">
                <span class="font-semibold text-ink">{a.author}</span>
                {a.role && <span class="text-stone"> · {a.role}</span>}
              </figcaption>
            </figure>
          ))
        }
        <a
          href="/avis"
          class="sm:col-span-2 text-[14px] font-medium text-ink hover:text-kaki transition-colors inline-flex items-center gap-2"
        >
          Lire tous les avis clients
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Dernier appel -->
  <section class="pb-20 md:pb-28">
    <div class="shell">
      <div
        class="relative isolate bg-navy-deep text-cream px-6 sm:px-14 py-14 md:py-16 overflow-hidden text-center"
      >
        <div
          class="pointer-events-none absolute inset-0 opacity-70"
          style="background:radial-gradient(100% 90% at 50% 0%, rgba(120,133,64,.30), transparent 60%)"
        >
        </div>
        <div class="relative">
          <h2 class="font-serif text-[1.9rem] md:text-[2.5rem] leading-tight max-w-2xl mx-auto">
            Le bien qui vous correspond existe.
            <span class="italic text-or-light">Encore faut-il le chercher pour vous.</span>
          </h2>
          <a href="#questionnaire" class="btn-or mt-9 inline-flex items-center gap-2.5">
            Décrire ma recherche
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <p class="mt-5 text-[13px] text-cream/55">
            Deux minutes. Réponse sous 24 heures ouvrées. Sans engagement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mention réglementaire -->
  <section class="pb-16 md:pb-20 border-t border-ink/10 pt-10">
    <div class="shell">
      <p class="text-xs text-stone/80 leading-relaxed max-w-3xl">
        Le Faitage est une marque exploitée par Le Chêne Patrimonial. Communication à
        caractère informatif et non contractuel, qui ne constitue ni une offre, ni une
        sollicitation, ni un conseil en investissement personnalisé. Les biens
        éventuellement présentés sont diffusés dans le cadre de conventions avec des
        partenaires promoteurs et exploitants ; leurs caractéristiques, prix, loyers et
        rentabilités sont indicatifs et détaillés dans la fiche de chaque bien, seule
        opposable. Tout investissement immobilier comporte des risques, notamment de
        perte en capital, d'illiquidité et de dépendance à la solidité de l'exploitant.
        Le Chêne Patrimonial · Camil Czajkowski, courtier en assurance (COA, ORIAS
        n° 25 00 00 16) et agent immobilier (carte T n° CPI 3402 2024 000 000 049).
      </p>
    </div>
  </section>
</Base>
