---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { lmnp, nue, neuf, type Bien } from '../../data/opportunites-biens';

const families = [
  {
    k: '01 — Clé en main',
    t: 'LMNP en résidence gérée',
    intro:
      "Vous achetez un logement meublé dans une résidence gérée (étudiante, tourisme ou senior). Un exploitant professionnel s'occupe de tout — locataires, entretien, gestion — et vous verse un loyer fixé par un bail commercial. Des revenus sans aucune gestion, avec la fiscalité avantageuse du statut LMNP.",
    items: lmnp,
    kind: 'lmnp' as const,
  },
  {
    k: '02 — Sans gestion, sans fiscalité',
    t: 'Nue-propriété',
    intro:
      "Vous achetez uniquement les murs, à prix décoté. Un bailleur institutionnel détient l'usufruit pour une durée fixe : c'est lui qui loue, gère et paie les charges. Pendant cette période, aucun loyer mais aucune charge, aucune taxe foncière, et le bien reste hors de l'assiette IFI. Au terme, vous récupérez la pleine propriété.",
    items: nue,
    kind: 'patrimonial' as const,
  },
  {
    k: '03 — Construire son patrimoine',
    t: 'Immobilier neuf',
    intro:
      "Logements neufs (VEFA), à habiter (résidence principale, PTZ) ou à louer. Frais de notaire réduits. Ici pas de loyer garanti : vous gérez la location.",
    items: neuf,
    kind: 'patrimonial' as const,
  },
];

const dispositifs = [
  { nom: 'LMNP en résidence gérée', desc: 'Meublé géré : revenus sans gestion, en résidence étudiante, tourisme ou senior.' },
  { nom: 'LMNP ancien', desc: 'Meublé dans l’ancien : amortissement du bien et loyers peu ou pas fiscalisés.' },
  { nom: 'Nue-propriété', desc: 'Achat des murs décoté, sans charges ni IFI pendant toute la durée de l’usufruit.' },
  { nom: 'Immobilier neuf (VEFA)', desc: 'À habiter ou à louer, frais de notaire réduits, garanties du neuf.' },
  { nom: 'Résidence principale', desc: 'Accompagnement à l’achat de votre logement : neuf ou ancien, PTZ, financement.' },
  { nom: 'Dispositif Jeanbrun', desc: 'Nouveau cadre du bailleur privé pour la location nue de logements neufs.' },
  { nom: 'Denormandie', desc: 'Ancien à rénover en centre-ville, avec réduction d’impôt à la clé.' },
  { nom: 'Malraux', desc: 'Restauration d’immeubles en secteur protégé : réduction d’impôt sur les travaux.' },
  { nom: 'Monuments Historiques', desc: 'Patrimoine d’exception, déduction des travaux au régime spécifique.' },
  { nom: 'Girardin (Outre-mer)', desc: 'Réduction d’impôt via l’investissement ultramarin.' },
  { nom: 'Appartements de prestige', desc: 'Adresses rares et biens d’exception, sourcés en direct.' },
];

const total = lmnp.length + nue.length + neuf.length;
const mois = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' }).format(new Date());
---

<Base
  title="Opportunités du moment, Le Chêne Patrimonial"
  description="La sélection immobilière du mois : LMNP en résidence gérée, nue-propriété et immobilier neuf, présentés avec méthode. Informations indicatives, un échange pour aller plus loin."
>
  <!-- Hero -->
  <section class="pt-16 pb-10 md:pt-24">
    <div class="shell grid lg:grid-cols-12 gap-12 items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow mb-6 flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-chene"></span>
          La sélection immobilière · <span class="capitalize">{mois}</span>
        </p>
        <h1 class="font-serif text-display-xl text-ink mb-8">
          Les bonnes idées, <span class="italic text-chene">au bon moment.</span>
        </h1>
        <p class="text-xl text-ink/75 max-w-2xl leading-relaxed">
          Une sélection de biens que le cabinet suit de près, classée en trois familles distinctes. Chaque opportunité mérite d'être regardée à la lumière de <em>votre</em> situation et de votre fiscalité — c'est tout l'objet d'un premier échange.
        </p>
      </div>
      <div class="lg:col-span-4">
        <div class="grid grid-cols-3 gap-px bg-ink/10 border border-ink/10">
          <div class="bg-cream-soft text-center py-5">
            <div class="font-serif text-3xl text-ink">{lmnp.length}</div>
            <div class="text-[0.6rem] uppercase tracking-micro text-stone mt-1">LMNP géré</div>
          </div>
          <div class="bg-cream-soft text-center py-5">
            <div class="font-serif text-3xl text-ink">{nue.length}</div>
            <div class="text-[0.6rem] uppercase tracking-micro text-stone mt-1">Nue-propriété</div>
          </div>
          <div class="bg-cream-soft text-center py-5">
            <div class="font-serif text-3xl text-ink">{neuf.length}</div>
            <div class="text-[0.6rem] uppercase tracking-micro text-stone mt-1">Neuf</div>
          </div>
        </div>
        <p class="text-xs text-stone/80 mt-3 leading-relaxed">
          {total} biens diffusés dans le cadre de conventions avec nos partenaires promoteurs et exploitants.
        </p>
      </div>
    </div>
  </section>

  <!-- Aperçu, pas un catalogue -->
  <section class="pb-6">
    <div class="shell">
      <div class="bg-navy-deep text-cream px-6 py-8 md:px-10 md:py-9 flex flex-col md:flex-row md:items-center gap-6">
        <div class="md:flex-1">
          <p class="text-xs uppercase tracking-micro text-or-light font-semibold mb-3 flex items-center gap-3">
            <span class="inline-block h-px w-8 bg-or"></span>
            Un aperçu, pas un catalogue
          </p>
          <p class="text-cream/85 leading-relaxed max-w-3xl">
            Cette page ne présente qu'une <strong class="text-cream">sélection du mois</strong>, renouvelée à chaque nouvelle Lettre du Chêne. Le cabinet suit des <strong class="text-cream">lots partout en France</strong> et sur <strong class="text-cream">l'ensemble des dispositifs patrimoniaux</strong> (détail ci-dessous). Dites-moi votre secteur et votre objectif : je vous adresse les biens qui vous correspondent, y compris ceux qui ne figurent pas ici.
          </p>
        </div>
        <a href="/contact" class="btn-or shrink-0 self-start">
          Me dire ce que je cherche
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Nos dispositifs -->
  <section class="py-10 md:py-14">
    <div class="shell">
      <div class="max-w-3xl mb-8">
        <p class="text-xs uppercase tracking-micro text-or-dark font-semibold">Tous les leviers, selon votre profil</p>
        <h2 class="font-serif text-3xl md:text-4xl text-ink mt-2 mb-3">Les dispositifs que nous couvrons</h2>
        <p class="text-ink/70 leading-relaxed">
          Du rendement locatif à la défiscalisation patrimoniale, de la résidence principale à l'immobilier de prestige, en direct ou via nos partenaires. La sélection ci-dessous n'en montre qu'une partie ; le bon dispositif dépend de votre fiscalité et de vos objectifs — et <strong class="text-ink">on s'adapte à chaque demande</strong>.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-ink/10 border border-ink/10">
        {dispositifs.map((d) => (
          <div class="bg-cream-soft/60 p-5 hover:bg-cream-soft transition-colors">
            <div class="flex items-start gap-3">
              <span class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-or"></span>
              <div>
                <h3 class="font-serif text-lg text-ink leading-tight">{d.nom}</h3>
                <p class="text-sm text-stone mt-1 leading-relaxed">{d.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Familles -->
  {families.map((fam) => (
    <section class="py-10 md:py-14 border-t border-ink/10">
      <div class="shell">
        <div class="max-w-3xl mb-10">
          <div class="border-t-2 border-or w-11 mb-4"></div>
          <p class="text-xs uppercase tracking-micro text-or-dark font-semibold">{fam.k}</p>
          <h2 class="font-serif text-3xl md:text-4xl text-ink mt-2 mb-4">{fam.t}</h2>
          <p class="text-ink/70 leading-relaxed">{fam.intro}</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {fam.items.map((b: Bien) => (
            <article class="group flex flex-col border border-ink/10 bg-cream-soft/40 overflow-hidden hover:border-chene/40 hover:bg-cream-soft transition-colors">
              <div class="aspect-[4/3] overflow-hidden bg-navy-deep">
                <img
                  src={`/emails/${b.ph}.jpg`}
                  alt={`${b.nom} — ${b.ville}`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out"
                />
              </div>
              <div class="p-5 flex flex-col flex-1">
                <p class="text-[0.65rem] uppercase tracking-micro text-chene font-semibold">{b.sub}</p>
                <h3 class="font-serif text-xl text-ink leading-tight mt-1">{b.nom}</h3>
                <p class="text-sm text-stone mt-0.5">{b.ville} · {b.ts}</p>

                {fam.kind === 'lmnp' ? (
                  <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-ink/10 text-center">
                    <div>
                      <div class="text-[0.55rem] uppercase tracking-wide text-stone">Prix</div>
                      <div class="font-serif text-[0.95rem] text-ink mt-0.5">{b.prix}</div>
                    </div>
                    <div class="border-x border-ink/10">
                      <div class="text-[0.55rem] uppercase tracking-wide text-stone">Loyer/mois</div>
                      <div class="font-serif text-[0.95rem] text-ink mt-0.5">{b.loyer}</div>
                    </div>
                    <div>
                      <div class="text-[0.55rem] uppercase tracking-wide text-stone">Rentabilité</div>
                      <div class="font-serif text-[0.95rem] text-or-dark mt-0.5">{b.rent}</div>
                    </div>
                  </div>
                ) : (
                  <div class="mt-4 pt-4 border-t border-ink/10">
                    <div class="font-serif text-2xl text-or-dark">{b.prix}</div>
                    {b.extra && <p class="text-xs text-stone mt-1">{b.extra}</p>}
                  </div>
                )}

                {b.note && <p class="text-xs text-stone mt-3 leading-relaxed flex-1">{b.note}</p>}

                <a
                  href="/contact"
                  class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-ink group-hover:text-chene transition-colors"
                >
                  Recevoir la fiche détaillée
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Mention réglementaire -->
  <section class="pt-12 pb-16 md:pb-24 border-t border-ink/10">
    <div class="shell">
      <p class="text-xs text-stone/80 leading-relaxed max-w-3xl">
        Communication à caractère informatif et non contractuel. Les biens présentés sont diffusés dans le cadre de conventions avec des partenaires promoteurs et exploitants ; les caractéristiques, prix, loyers et rentabilités sont indicatifs et détaillés dans la fiche de chaque bien, seule opposable. Les informations présentées ne constituent ni un conseil en investissement personnalisé, ni une sollicitation ou une offre de souscription. Tout investissement immobilier comporte des risques, notamment de perte en capital, d'illiquidité et de dépendance à la solidité de l'exploitant (résidences gérées). Le Chêne Patrimonial · Camil Czajkowski, courtier en assurance (COA, ORIAS n° 25 00 00 16) et agent immobilier (carte T n° CPI 3402 2024 000 000 049).
      </p>
    </div>
  </section>

  <CTA
    title="Un bien retient votre attention ?"
    body="Dites-moi lequel : je vous transmets la fiche complète et on regarde ensemble s'il colle à votre projet et à votre fiscalité. 30 minutes, sans engagement."
  />
</Base>
