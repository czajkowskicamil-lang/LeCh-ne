---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable — Le Chêne Patrimonial" description="Cette page n'existe pas.">
  <section class="py-32 md:py-48">
    <div class="shell max-w-2xl text-center">
      <p class="eyebrow mb-6 justify-center flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-chene"></span>
        Erreur 404
      </p>
      <h1 class="font-serif text-display text-ink mb-6">
        Cette page s'est <span class="italic text-chene">évanouie.</span>
      </h1>
      <p class="text-ink/70 text-lg mb-10">
        Le lien que vous suivez n'existe pas ou plus. Pas de panique — reprenons depuis le début.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary">Retour à l'accueil</a>
        <a href="/expertise" class="btn-ghost">Parcourir l'expertise</a>
      </div>
    </div>
  </section>
</Base>
