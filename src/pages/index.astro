---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StoryTeaser from '../components/StoryTeaser.astro';
import ProfilEntries from '../components/ProfilEntries.astro';
import MethodStrip from '../components/MethodStrip.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';

// Accueil épuré à 6 blocs : qui, pour qui, comment, preuves, rendez-vous.
// Rien n'est perdu : outils dans /outils, diagnostic dans le hero, newsletter
// dans le pied de page, chiffres, partenaires et philosophie dans /parcours.
---

<Base
  heroDark
  title="Gestion de patrimoine à Montpellier, sportifs de haut niveau | Le Chêne"
  description="Cabinet indépendant à Montpellier, fondé par un ancien athlète : patrimoine des sportifs de haut niveau, dirigeants et particuliers. Premier échange offert."
>
  <Hero />
  <StoryTeaser />
  <ProfilEntries />
  <MethodStrip />
  <Testimonials />
  <CTA />
</Base>
