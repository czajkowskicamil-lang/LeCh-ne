---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PartnersMarquee from '../components/PartnersMarquee.astro';
import OakBand from '../components/OakBand.astro';
import StoryTeaser from '../components/StoryTeaser.astro';
import DiagnosticTeaser from '../components/DiagnosticTeaser.astro';
import MethodStrip from '../components/MethodStrip.astro';
import CheneEnChiffres from '../components/CheneEnChiffres.astro';
import ProfilEntries from '../components/ProfilEntries.astro';
import NewsletterTeaser from '../components/NewsletterTeaser.astro';
import EditorialTicker from '../components/EditorialTicker.astro';
import CTA from '../components/CTA.astro';
---

<Base
  heroDark
  title="Le Chêne Patrimonial, cabinet de gestion de patrimoine à Montpellier"
  description="Cabinet indépendant de gestion de patrimoine à Montpellier et partout en France : fiscalité, assurance-vie, immobilier, retraite, transmission. Premier échange de 30 minutes offert."
>
  <Hero />
  <PartnersMarquee />
  <EditorialTicker />
  <StoryTeaser />
  <DiagnosticTeaser />
  <MethodStrip />
  <CheneEnChiffres />
  <ProfilEntries />
  <NewsletterTeaser />
  <OakBand />
  <CTA />
</Base>
